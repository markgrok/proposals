-                  'wasm': False, 'emsdk': False, 'node': False, 'cc': 'clang-18',
+                  'using': 'using clang : 18 : clang++-18 ;\n\n{emsdk.jam}', 'detect': '',
+                  'options': [], 'wasm': False, 'emsdk': True, 'node': True, 'cc': 'clang-18',
                   'cxx': 'clang++-18', 'container': False, 'external': False,
                   'projects': ['/webcpp/site//test'], 'reports': False}
 
@@ -164,6 +165,20 @@ def test_site_test_runs_b2_on_the_site_s_test_alone_its_exit_status_the_verdict(
         'a lane that reports no XML is never missing, never waited on')
 
 
+def test_site_test_registers_clang_18_then_emscripten(root):
+    # The site's tests build its C++ natively with Clang 18, b2's default there, and its wasm with
+    # emscripten (site/app/Jamfile), so the lane registers both, in that order, emscripten's lines
+    # read from tools/ci/emsdk.jam as the emscripten lane's are.
+    config = boost_only(root)
+    matrix.register(matrix.resolved(matrix.SITE_TEST), config)
+    text = config.read_text()
+    emscripten = matrix.resolved(matrix.LANES[[lane.id for lane in matrix.LANES].index(
+        'emscripten')]).using.split('\n\n')
+    assert all(block in text for block in emscripten), (emscripten, text)
+    assert text.index('using clang : 18 : clang++-18 ;\n') < text.index(emscripten[0]), text
+    assert '{emsdk.jam}' not in text, text
+
+
 # The emscripten lane, as the plan writes it for a library that declares emscripten.
 EMSCRIPTEN_LANE = {'id': 'emscripten', 'name': 'Emscripten 6.0.11 (node)', 'os': 'ubuntu-24.04',
                    'target': 'emscripten', 'lane': 'emscripten', 'toolset': 'emscripten',
@@ -1282,6 +1297,7 @@ CASES = [
     test_a_lane_is_named_by_the_compiler_version,
     test_abbreviated_paths_keep_the_lane_name,
     test_register_writes_the_lanes_toolsets_in_order,
+    test_site_test_registers_clang_18_then_emscripten,
     test_the_wasm_toolsets_come_from_wasi_sdk_jam,
     test_the_emscripten_toolset_comes_from_emsdk_jam,
     test_a_lane_writes_its_xml_and_the_report_merges_it,
