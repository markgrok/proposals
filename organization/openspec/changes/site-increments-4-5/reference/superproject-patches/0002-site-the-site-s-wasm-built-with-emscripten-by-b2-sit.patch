@@ -65,6 +65,9 @@ jobs:
 
       - uses: ./tools/ci/actions/node
 
+      # The site's own wasm (site/app/), which b2 site builds with emscripten.
+      - uses: ./tools/ci/actions/emsdk
+
       - name: Download the pages
         uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
         with:
@@ -78,11 +81,12 @@ jobs:
           path: bin/report
 
       # The pages and the report built already, so b2 site builds no doc of its own. b2 needs a
-      # toolset registered to load the project, though it compiles nothing here.
+      # toolset registered to load the project, Clang 18, its default, which compiles nothing here,
+      # and emscripten, which builds the site's wasm whatever toolset b2 runs with.
       - name: b2 site
         id: site
         run: |
-          python3 tools/ci/matrix.py register clang-18
+          python3 tools/ci/matrix.py register clang-18 emscripten
           env -u CPATH -u CPLUS_INCLUDE_PATH -u C_INCLUDE_PATH \
             b2 --user-config=.local/user-config.jam -a toolset=clang-18 site \
             -sWEBCPP_SITE_DOCS=bin/pages -sWEBCPP_SITE_REPORT=bin/report
