-webcpp.headers-alone xstate : ../include ;
+# The actor layer runs on xactor, whose drivers.hpp includes Boost.Asio
+# outside WASI; Boost.Asio 1.92 does not compile for Emscripten 6.0.11's
+# single-threaded wasm32 (asio/detail/signal_blocker.hpp: "Only Windows and
+# POSIX are supported!"). So every program that includes <webcpp/xactor.hpp>,
+# directly or through the actor layer, is built for native, wasip2 and wasip3,
+# until xactor builds for emscripten; the machine core, and the actor layer's
+# headers that include no more of xactor than its ids and errors, build on
+# every target.
+.xactor-targets = native wasip2 wasip3 ;
+
+webcpp.headers-alone xstate : ../include
