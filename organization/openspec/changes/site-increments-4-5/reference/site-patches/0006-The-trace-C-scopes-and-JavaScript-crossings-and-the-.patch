new file mode 100644
index 0000000..8317e4b
--- /dev/null
+++ b/src/trace.ts
@@ -0,0 +1,225 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The trace the visualizer draws: every call between JavaScript and a wasm module, each way, and
+// every C++ scope the module marks with WEBCPP_SITE_TRACE_SCOPE (include/webcpp_site/trace.hpp), as
+// one stream of events in the order they happen, numbered by seq. The program runs at full speed;
+// the visualizer replays the stream at a pace a person can follow.
+
+/** One event of the trace. */
+export type TraceEvent =
+    | {seq: number; kind: 'js_to_wasm' | 'wasm_to_js'; name: string; args: unknown[]}
+    | {seq: number; kind: 'return'; name: string; result: unknown}
+    | {seq: number; kind: 'cpp_enter'; name: string; file: string; line: number; args: unknown[]}
+    | {seq: number; kind: 'cpp_exit'; name: string}
+    | {seq: number; kind: 'log'; text: string}
+
+/** An event before the trace numbers it. */
+type Unnumbered<E> = E extends unknown ? Omit<E, 'seq'> : never
+
+type Emit = (event: Unnumbered<TraceEvent>) => void
+
+/** The C++ trace's import, called by app/trace.cpp: kind 0 is cpp_enter, 1 cpp_exit. */
+const traceChannel = 'webcpp_site_trace'
+/** What the program writes, stdout and stderr alike. */
+const logChannel = 'webcpp_site_log'
+
+/** A sink whose events are numbered in the order they reach it, from 0. */
+function numbered(sink: (event: TraceEvent) => void): Emit {
+    let next = 0
+    return event => {
+        sink({...event, seq: next++} as TraceEvent)
+    }
+}
+
+function messageOf(error: unknown): string {
+    return error instanceof Error ? error.message : String(error)
+}
+
+/**
+ * Whether value is an instance of a class the module defines, such as an embind class, which the
+ * trace follows as it follows the module: a function, or an object whose class is not one of
+ * JavaScript's own (a plain object, an array, a Promise, a typed array).
+ */
+function isModuleObject(value: unknown): value is object {
+    if (typeof value === 'function') {
+        return true
+    }
+    if (value === null || typeof value !== 'object') {
+        return false
+    }
+    const constructor: unknown = Object.getPrototypeOf(value)?.constructor
+    return typeof constructor === 'function' &&
+        !Function.prototype.toString.call(constructor).includes('[native code]')
+}
+
+/** The name an object of the module is traced by: its class's, or its own for a function. */
+function nameOf(value: object): string {
+    if (typeof value === 'function') {
+        return value.name
+    }
+    const constructor = (Object.getPrototypeOf(value) as {constructor?: {name?: string}}).constructor
+    return constructor?.name ?? 'object'
+}
+
+/** A call's result as the trace holds it: an object of the module by its class's name. */
+function resultOf(value: unknown): unknown {
+    if (typeof value === 'function') {
+        return {function: value.name}
+    }
+    return isModuleObject(value) ? {object: nameOf(value)} : value
+}
+
+/** Runs call as the crossing name, between its first event and its return, rethrowing a throw. */
+function crossing(emit: Emit, kind: 'js_to_wasm' | 'wasm_to_js', name: string, args: unknown[],
+                  call: () => unknown): unknown {
+    emit({kind, name, args: [...args]})
+    let result: unknown
+    try {
+        result = call()
+    } catch (error) {
+        emit({kind: 'return', name, result: {error: messageOf(error)}})
+        throw error
+    }
+    emit({kind: 'return', name, result: resultOf(result)})
+    return result
+}
+
+/**
+ * The wrappers of one module: each object of the module is wrapped once, so that a wrapper read
+ * twice is the same object, and each of its functions once per object it is read from, since a
+ * class's method is one function shared by every instance.
+ */
+class Wrappers {
+    private readonly emit: Emit
+    private readonly objects = new WeakMap<object, object>()
+    private readonly methods = new WeakMap<object, Map<PropertyKey, Function>>()
+
+    constructor(emit: Emit) {
+        this.emit = emit
+    }
+
+    /** The module itself, whose functions are traced by their own names. */
+    root<M extends object>(module: M): M {
+        return new Proxy(module, this.members<M>(undefined))
+    }
+
+    /** value, traced, named by its class, when it is an object of the module; any other as it is. */
+    private wrap(value: unknown): unknown {
+        if (!isModuleObject(value)) {
+            return value
+        }
+        let wrapper = this.objects.get(value)
+        if (wrapper === undefined) {
+            wrapper = typeof value === 'function'
+                ? this.traceFunction(value as Function, nameOf(value), undefined)
+                : new Proxy(value, this.members(nameOf(value)))
+            this.objects.set(value, wrapper)
+        }
+        return wrapper
+    }
+
+    /** The handler of an object named prefix, whose functions are traced as prefix.<member>. */
+    private members<T extends object>(prefix: string | undefined): ProxyHandler<T> {
+        return {
+            get: (target: T, key, receiver) => {
+                const value: unknown = Reflect.get(target, key, receiver)
+                const descriptor = Reflect.getOwnPropertyDescriptor(target, key)
+                // A proxy must answer a property that can never change with the property itself.
+                if (typeof key === 'symbol' ||
+                    (descriptor !== undefined && !descriptor.configurable && !descriptor.writable)) {
+                    return value
+                }
+                if (typeof value !== 'function') {
+                    return this.wrap(value)
+                }
+                return this.method(target, key, value as Function,
+                    prefix === undefined ? key : `${prefix}.${key}`)
+            },
+        }
+    }
+
+    /** owner's function at key, traced as name and called on owner. */
+    private method(owner: object, key: PropertyKey, fn: Function, name: string): Function {
+        let byKey = this.methods.get(owner)
+        if (byKey === undefined) {
+            byKey = new Map()
+            this.methods.set(owner, byKey)
+        }
+        let wrapper = byKey.get(key)
+        if (wrapper === undefined) {
+            wrapper = this.traceFunction(fn, name, owner)
+            byKey.set(key, wrapper)
+        }
+        return wrapper
+    }
+
+    /**
+     * fn traced as name: a call, on owner when it has one, or a construction with new, each a
+     * crossing whose result is traced in turn; its own members (a class's static functions) are
+     * traced as name.<member>.
+     */
+    private traceFunction(fn: Function, name: string, owner: object | undefined): Function {
+        return new Proxy<Function>(fn, {
+            ...this.members<Function>(name),
+            apply: (target, self, args: unknown[]) => crossing(this.emit, 'js_to_wasm', name, args,
+                () => this.wrap(Reflect.apply(target, owner ?? self, args))),
+            construct: (target, args: unknown[]) => crossing(this.emit, 'js_to_wasm', name, args,
+                () => this.wrap(Reflect.construct(target, args))) as object,
+        })
+    }
+}
+
+/**
+ * Traces imports in place: each function already there becomes a wasm_to_js crossing, and the two
+ * channels of the trace's own are added, the C++ scopes' and the program's output.
+ */
+function traceImports(imports: Record<string, Function>, emit: Emit): void {
+    for (const [name, fn] of Object.entries(imports)) {
+        imports[name] = (...args: unknown[]) => crossing(emit, 'wasm_to_js', name, args, () => fn(...args))
+    }
+    imports[traceChannel] = (kind: number, name: string, file: string, line: number, args: string) => {
+        if (kind === 0) {
+            emit({kind: 'cpp_enter', name, file, line, args: JSON.parse(args) as unknown[]})
+        } else {
+            emit({kind: 'cpp_exit', name})
+        }
+    }
+    imports[logChannel] = (text: string) => {
+        emit({kind: 'log', text})
+    }
+}
+
+/**
+ * The module, traced: each call into one of its functions, and into a function or a method of an
+ * object one of them returns, is a js_to_wasm crossing; each call the module makes into imports, a
+ * wasm_to_js crossing; each followed by its return, whose result is `{error: message}` for a throw,
+ * which is rethrown. imports is changed in place, so the module, which reads it as it calls, calls
+ * the traced functions, and gains the channels app/trace.cpp and the program's output use.
+ */
+export function traced<M extends object>(module: M, imports: Record<string, Function>,
+                                         sink: (e: TraceEvent) => void): M {
+    const emit = numbered(sink)
+    traceImports(imports, emit)
+    return new Wrappers(emit).root(module)
+}
+
+/**
+ * The emscripten module at url (MODULARIZE, EXPORT_ES6), instantiated and traced: its imports, the
+ * module option webcppSiteImports that app/trace.cpp reads, are traced before the module starts,
+ * and what the program writes is a log event, in one stream with every other.
+ */
+export async function loadTraced<M extends object>(url: string, sink: (e: TraceEvent) => void,
+                                                   imports: Record<string, Function> = {}): Promise<M> {
+    const emit = numbered(sink)
+    traceImports(imports, emit)
+    const log = (text: string) => {
+        emit({kind: 'log', text})
+    }
+    const factory = (await import(url)) as {default: (options: object) => Promise<M>}
+    const module = await factory.default({webcppSiteImports: imports, print: log, printErr: log})
+    return new Wrappers(emit).root(module)
+}
diff --git a/test/sound_test.mjs b/test/sound_test.mjs
new file mode 100644
index 0000000..fbb5466
--- /dev/null
+++ b/test/sound_test.mjs
@@ -0,0 +1,286 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// src/sound.ts on a fake Web Audio, never a real one: each tone is checked by what it schedules on
+// the audio clock, never by listening or by a timer. No sound before the reader's first gesture;
+// none, and no throw, when the browser refuses an AudioContext or its storage; the mute control
+// remembered where storage works and kept for the session where it does not; and sound apart from
+// the reduced-motion preference.
+
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {createSound, tones} from '../src/sound.ts'
+
+/** Runs body with each of globals defined on globalThis, then puts back what was there. */
+async function withGlobals(globals, body) {
+    const before = Object.keys(globals).map(name => [name, Object.getOwnPropertyDescriptor(globalThis, name)])
+    for (const [name, descriptor] of Object.entries(globals)) {
+        Object.defineProperty(globalThis, name, {configurable: true, ...descriptor})
+    }
+    try {
+        await body()
+    } finally {
+        for (const [name, descriptor] of before) {
+            if (descriptor === undefined) {
+                delete globalThis[name]
+            } else {
+                Object.defineProperty(globalThis, name, descriptor)
+            }
+        }
+    }
+}
+
+/** An AudioParam that records what is scheduled on it, as [method, value, time]. */
+function fakeParam() {
+    const calls = []
+    const record = method => (value, time) => {
+        calls.push([method, value, time])
+    }
+    return {
+        calls,
+        setValueAtTime: record('setValueAtTime'),
+        linearRampToValueAtTime: record('linearRampToValueAtTime'),
+        exponentialRampToValueAtTime: record('exponentialRampToValueAtTime'),
+    }
+}
+
+/**
+ * A fake AudioContext class, its clock at `time`, whose instances and the nodes they make are
+ * recorded; `state` is the state each starts in, and `resume` what resume does.
+ */
+function fakeAudio({time = 2.5, state = 'running', resume = () => Promise.resolve()} = {}) {
+    const contexts = []
+    class AudioContext {
+        constructor() {
+            this.currentTime = time
+            this.state = state
+            this.destination = {name: 'destination'}
+            this.oscillators = []
+            this.gains = []
+            this.resumed = 0
+            contexts.push(this)
+        }
+
+        resume() {
+            this.resumed += 1
+            return resume()
+        }
+
+        createOscillator() {
+            const oscillator = {
+                type: 'sine',
+                frequency: fakeParam(),
+                connected: [],
+                started: [],
+                stopped: [],
+                connect(node) {
+                    this.connected.push(node)
+                    return node
+                },
+                start(at) {
+                    this.started.push(at)
+                },
+                stop(at) {
+                    this.stopped.push(at)
+                },
+            }
+            this.oscillators.push(oscillator)
+            return oscillator
+        }
+
+        createGain() {
+            const gain = {
+                gain: fakeParam(),
+                connected: [],
+                connect(node) {
+                    this.connected.push(node)
+                    return node
+                },
+            }
+            this.gains.push(gain)
+            return gain
+        }
+    }
+    return {AudioContext, contexts}
+}
+
+/** A localStorage that works, over a Map. */
+function memoryStorage() {
+    const items = new Map()
+    return {
+        items,
+        getItem: key => items.get(key) ?? null,
+        setItem: (key, value) => {
+            items.set(key, String(value))
+        },
+    }
+}
+
+/** A navigator whose user activation says whether the reader has made a gesture yet. */
+function activation(hasBeenActive) {
+    return {value: {userActivation: {hasBeenActive}}}
+}
+
+/** The globals of a page whose reader has clicked, with a working storage and audio. */
+function page(audio, storage = memoryStorage()) {
+    return {
+        AudioContext: {value: audio.AudioContext},
+        localStorage: {value: storage},
+        navigator: activation(true),
+    }
+}
+
+const kinds = ['js_to_wasm', 'wasm_to_js', 'return', 'cpp_enter', 'cpp_exit', 'log']
+
+test('each kind of event has a tone of its own', () => {
+    assert.deepEqual(Object.keys(tones).sort(), [...kinds].sort())
+    const frequencies = kinds.map(kind => tones[kind].frequency)
+    assert.equal(new Set(frequencies).size, kinds.length, 'no two kinds sound the same')
+    for (const kind of kinds) {
+        assert.ok(tones[kind].duration > 0 && tones[kind].duration <= 0.2, `${kind} is short`)
+    }
+})
+
+test('play schedules its tone on the audio clock: an oscillator through a gain envelope', async () => {
+    const audio = fakeAudio({time: 2.5})
+    await withGlobals(page(audio), () => {
+        const sound = createSound()
+        sound.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 1)
+        const [context] = audio.contexts
+        const [oscillator] = context.oscillators
+        const [gain] = context.gains
+        const tone = tones.js_to_wasm
+        assert.equal(oscillator.type, tone.type)
+        assert.deepEqual(oscillator.frequency.calls, [['setValueAtTime', tone.frequency, 2.5]])
+        assert.deepEqual(oscillator.connected, [gain])
+        assert.deepEqual(gain.connected, [context.destination])
+        assert.deepEqual(oscillator.started, [2.5])
+        assert.deepEqual(oscillator.stopped, [2.5 + tone.duration])
+        const [start, attack, release] = gain.gain.calls
+        assert.deepEqual(start, ['setValueAtTime', 0, 2.5])
+        assert.equal(attack[0], 'linearRampToValueAtTime')
+        assert.ok(attack[1] > 0 && attack[1] <= 0.2, 'a quiet peak')
+        assert.ok(attack[2] > 2.5 && attack[2] < 2.5 + tone.duration, 'the attack inside the tone')
+        assert.deepEqual(release.slice(0, 1), ['exponentialRampToValueAtTime'])
+        assert.ok(release[1] > 0 && release[1] < attack[1], 'released to near silence, never 0')
+        assert.equal(release[2], 2.5 + tone.duration)
+
+        sound.play('cpp_exit')
+        assert.equal(audio.contexts.length, 1, 'one AudioContext for every tone')
+        assert.deepEqual(context.oscillators[1].frequency.calls, [['setValueAtTime', tones.cpp_exit.frequency, 2.5]])
+    })
+})
+
+test('no sound before the reader has made a gesture: the AudioContext is created after it', async () => {
+    const audio = fakeAudio()
+    const userActivation = {hasBeenActive: false}
+    await withGlobals({...page(audio), navigator: {value: {userActivation}}}, () => {
+        const sound = createSound()
+        sound.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 0)
+        userActivation.hasBeenActive = true
+        sound.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 1)
+        assert.equal(audio.contexts[0].oscillators.length, 1)
+    })
+    const older = fakeAudio()
+    await withGlobals({...page(older), navigator: {value: {}}}, () => {
+        createSound().play('js_to_wasm')
+        assert.equal(older.contexts.length, 1, "without userActivation, the browser's own policy decides")
+    })
+})
+
+test('a suspended AudioContext is resumed, and a refused resume throws nothing', async () => {
+    const audio = fakeAudio({state: 'suspended', resume: () => Promise.reject(new Error('not allowed'))})
+    await withGlobals(page(audio), async () => {
+        const sound = createSound()
+        sound.play('return')
+        assert.equal(audio.contexts[0].resumed, 1)
+        await new Promise(setImmediate)
+    })
+})
+
+test('an AudioContext that cannot be created leaves play silent, and play never throws', async () => {
+    let attempts = 0
+    class AudioContext {
+        constructor() {
+            attempts += 1
+            throw new Error('no audio device')
+        }
+    }
+    await withGlobals({...page({AudioContext}), webkitAudioContext: {value: undefined}}, () => {
+        const sound = createSound()
+        assert.doesNotThrow(() => sound.play('js_to_wasm'))
+        assert.doesNotThrow(() => sound.play('return'))
+        assert.ok(attempts >= 1)
+    })
+    await withGlobals({...page({AudioContext: undefined}), webkitAudioContext: {value: undefined}}, () => {
+        assert.doesNotThrow(() => createSound().play('log'))
+    })
+    const broken = fakeAudio()
+    broken.AudioContext.prototype.createOscillator = () => {
+        throw new Error('closed')
+    }
+    await withGlobals(page(broken), () => {
+        assert.doesNotThrow(() => createSound().play('cpp_enter'))
+    })
+})
+
+test('the mute control is remembered for the reader, and a muted sound plays nothing', async () => {
+    const audio = fakeAudio()
+    const storage = memoryStorage()
+    await withGlobals(page(audio, storage), () => {
+        const first = createSound()
+        assert.equal(first.muted, false, 'unmuted until the reader mutes it')
+        first.setMuted(true)
+        assert.equal(first.muted, true)
+        first.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 0, 'muted, no AudioContext')
+
+        const next = createSound()
+        assert.equal(next.muted, true, 'remembered on the next page')
+        next.setMuted(false)
+        assert.equal(createSound().muted, false)
+        next.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 1)
+    })
+})
+
+test('a localStorage that throws: unmuted for the session, and setMuted still works', async () => {
+    const audio = fakeAudio()
+    await withGlobals({
+        ...page(audio),
+        localStorage: {
+            get() {
+                throw new DOMException('The operation is insecure.', 'SecurityError')
+            },
+        },
+    }, () => {
+        const sound = createSound()
+        assert.equal(sound.muted, false)
+        sound.setMuted(true)
+        assert.equal(sound.muted, true)
+        sound.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 0)
+        sound.setMuted(false)
+        assert.equal(sound.muted, false)
+        sound.play('js_to_wasm')
+        assert.equal(audio.contexts.length, 1)
+    })
+})
+
+test('sound and motion are separate preferences: reduced motion still sounds', async () => {
+    const audio = fakeAudio()
+    await withGlobals({
+        ...page(audio),
+        matchMedia: {value: query => ({matches: query === '(prefers-reduced-motion: reduce)', media: query})},
+    }, () => {
+        createSound().play('wasm_to_js')
+        assert.equal(audio.contexts.length, 1)
+        assert.deepEqual(audio.contexts[0].oscillators[0].started, [2.5])
+    })
+})
