+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// src/trace.ts without the site's wasm: traced over fake modules, whose exports and imports stand
+// for the wasm's. Each call across is recorded in order, with its arguments and its result, a throw
+// as the error it carries; the C++ scopes and the program's output arrive through the channels
+// traced adds to the imports; and what the module answers is never changed. test/wasm/trace.mjs
+// runs the same on the wasm itself.
+
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {loadTraced, traced} from '../src/trace.ts'
+
+/** A sink that keeps every event, and the events it kept. */
+function recorder() {
+    const events = []
+    return {events, sink: event => events.push(event)}
+}
+
+/** The events without their seq, which the tests check apart. */
+function unsequenced(events) {
+    return events.map(({seq, ...event}) => event)
+}
+
+test('a call from JavaScript into an export is js_to_wasm, then its return, in order', () => {
+    const {events, sink} = recorder()
+    const imports = {log(text) {}}
+    const module = traced({add: (a, b) => a + b}, imports, sink)
+    assert.equal(module.add(1, 2), 3)
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'js_to_wasm', name: 'add', args: [1, 2]},
+        {kind: 'return', name: 'add', result: 3},
+    ])
+    assert.ok(events[0].seq < events[1].seq, 'seq increases')
+})
+
+test('an export that throws records its return as the error, and the error is rethrown', () => {
+    const {events, sink} = recorder()
+    const failure = new Error('no such machine')
+    const module = traced({start() { throw failure }}, {}, sink)
+    assert.throws(() => module.start('player'), error => error === failure)
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'js_to_wasm', name: 'start', args: ['player']},
+        {kind: 'return', name: 'start', result: {error: 'no such machine'}},
+    ])
+})
+
+test('a call from the wasm into an import is wasm_to_js, nested in the call that made it', () => {
+    const {events, sink} = recorder()
+    const imports = {now: () => 42}
+    const module = traced({stamp: () => `at ${imports.now()}`}, imports, sink)
+    assert.equal(module.stamp(), 'at 42')
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'js_to_wasm', name: 'stamp', args: []},
+        {kind: 'wasm_to_js', name: 'now', args: []},
+        {kind: 'return', name: 'now', result: 42},
+        {kind: 'return', name: 'stamp', result: 'at 42'},
+    ])
+    assert.deepEqual(events.map(event => event.seq), [0, 1, 2, 3])
+})
+
+test("a C++ scope and the program's output arrive through traced's channels, in sequence", () => {
+    const {events, sink} = recorder()
+    const imports = {}
+    const module = traced({
+        send(event) {
+            imports.webcpp_site_trace(0, 'machine_host::send', 'site_app.cpp', 12, JSON.stringify([event]))
+            imports.webcpp_site_log('sent')
+            imports.webcpp_site_trace(1, 'machine_host::send', 'site_app.cpp', 12, '')
+            return 'ok'
+        },
+    }, imports, sink)
+    module.send('{"type":"PLAY"}')
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'js_to_wasm', name: 'send', args: ['{"type":"PLAY"}']},
+        {kind: 'cpp_enter', name: 'machine_host::send', file: 'site_app.cpp', line: 12, args: ['{"type":"PLAY"}']},
+        {kind: 'log', text: 'sent'},
+        {kind: 'cpp_exit', name: 'machine_host::send'},
+        {kind: 'return', name: 'send', result: 'ok'},
+    ])
+})
+
+/** A module shaped as embind's: a class whose static function returns an instance of it. */
+function embindLike() {
+    class MachineHost {
+        static create(config) {
+            return new MachineHost(config)
+        }
+
+        constructor(config) {
+            this.taken = config.length
+        }
+
+        send(event) {
+            this.taken += 1
+            return `${event}:${this.taken}`
+        }
+    }
+    return {MachineHost}
+}
+
+test("an object an export returns is traced too, named by its class, and the answers are the module's", () => {
+    const {events, sink} = recorder()
+    const plain = embindLike().MachineHost.create('abc')
+    const module = traced(embindLike(), {}, sink)
+    const host = module.MachineHost.create('abc')
+    assert.equal(host.send('PLAY'), plain.send('PLAY'))
+    assert.equal(host.send('TICK'), plain.send('TICK'))
+    assert.equal(host.taken, plain.taken)
+    assert.ok(module.MachineHost === module.MachineHost, 'one wrapper per object')
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'js_to_wasm', name: 'MachineHost.create', args: ['abc']},
+        {kind: 'return', name: 'MachineHost.create', result: {object: 'MachineHost'}},
+        {kind: 'js_to_wasm', name: 'MachineHost.send', args: ['PLAY']},
+        {kind: 'return', name: 'MachineHost.send', result: 'PLAY:4'},
+        {kind: 'js_to_wasm', name: 'MachineHost.send', args: ['TICK']},
+        {kind: 'return', name: 'MachineHost.send', result: 'TICK:5'},
+    ])
+})
+
+test("loadTraced instantiates a module with traced's channels and its output as log events", async () => {
+    const {events, sink} = recorder()
+    const source = `export default async function factory(options) {
+        options.print('ready')
+        return {
+            hello(name) {
+                options.webcppSiteImports.webcpp_site_trace(0, 'hello', 'hello.cpp', 3, JSON.stringify([name]))
+                options.printErr('greeted')
+                options.webcppSiteImports.webcpp_site_trace(1, 'hello', 'hello.cpp', 3, '')
+                return 'hello ' + name
+            },
+        }
+    }`
+    const url = `data:text/javascript,${encodeURIComponent(source)}`
+    const module = await loadTraced(url, sink)
+    assert.equal(module.hello('wasm'), 'hello wasm')
+    assert.deepEqual(unsequenced(events), [
+        {kind: 'log', text: 'ready'},
+        {kind: 'js_to_wasm', name: 'hello', args: ['wasm']},
+        {kind: 'cpp_enter', name: 'hello', file: 'hello.cpp', line: 3, args: ['wasm']},
+        {kind: 'log', text: 'greeted'},
+        {kind: 'cpp_exit', name: 'hello'},
+        {kind: 'return', name: 'hello', result: 'hello wasm'},
+    ])
+    assert.deepEqual(events.map(event => event.seq), [0, 1, 2, 3, 4, 5])
+})
