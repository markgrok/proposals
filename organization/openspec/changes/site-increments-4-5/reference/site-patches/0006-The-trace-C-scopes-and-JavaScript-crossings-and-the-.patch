+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ The trace's import, webcpp_site_trace, which include/webcpp_site/trace.hpp
+ declares: one definition per wasm, in this file alone, since EM_JS defines a
+ symbol. It hands each event to the function webcpp_site_trace of the module's
+ option webcppSiteImports, which src/trace.ts's loadTraced installs, and does
+ nothing when the module was loaded without it.
+*/
+
+#include <webcpp_site/trace.hpp>
+
+#include <emscripten/em_js.h>
+
+// clang-format off
+EM_JS(void, webcpp_site_trace,
+      (int kind, const char* name, const char* file, int line, const char* args_json), {
+    var imports = Module['webcppSiteImports'];
+    var trace = imports && imports['webcpp_site_trace'];
+    if (trace) {
+        trace(kind, UTF8ToString(name), UTF8ToString(file), line, UTF8ToString(args_json));
+    }
+});
+// clang-format on
diff --git a/include/webcpp_site/trace.hpp b/include/webcpp_site/trace.hpp
new file mode 100644
index 0000000..598e5db
--- /dev/null
+++ b/include/webcpp_site/trace.hpp
@@ -0,0 +1,98 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ The trace points of the site's C++: WEBCPP_SITE_TRACE_SCOPE marks a scope the
+ site's visualizer shows. Inside the site's build, which defines
+ WEBCPP_SITE_TRACE, the scope sends cpp_enter with its name, file, line and
+ arguments as JSON when it starts, and cpp_exit when it ends, through the one
+ JavaScript import webcpp_site_trace (app/trace.cpp); elsewhere the macro
+ expands to no token at all, and its arguments are never evaluated.
+*/
+#ifndef WEBCPP_SITE_TRACE_HPP
+#define WEBCPP_SITE_TRACE_HPP
+
+#ifdef WEBCPP_SITE_TRACE
+
+#include <boost/json/array.hpp>
+#include <boost/json/serialize.hpp>
+#include <boost/json/value_from.hpp>
+
+#include <emscripten/em_macros.h>
+
+#include <string>
+
+/**
+ The trace's import: kind 0 is cpp_enter and 1 cpp_exit; args_json is a JSON
+ array, "" for cpp_exit.
+ Tip: C strings, which the JavaScript side reads with UTF8ToString; a scope's
+ name and file are literals.
+*/
+extern "C" void webcpp_site_trace(int kind, const char* name, const char* file, int line,
+                                  const char* args_json) EM_IMPORT(webcpp_site_trace);
+
+namespace webcpp_site::detail {
+
+inline constexpr int trace_enter = 0;
+inline constexpr int trace_exit = 1;
+
+/** The arguments as a JSON array, each converted by Boost.JSON's value_from. */
+template <class... Args>
+std::string trace_arguments(const Args&... args) {
+    boost::json::array array;
+    array.reserve(sizeof...(Args));
+    (array.emplace_back(boost::json::value_from(args)), ...);
+    return boost::json::serialize(array);
+}
+
+/** Sends cpp_enter when constructed and cpp_exit when destroyed. */
+class scope {
+public:
+    template <class... Args>
+    scope(const char* name, const char* file, int line, const Args&... args)
+        : name_(name), file_(file), line_(line) {
+        const std::string json = trace_arguments(args...);
+        webcpp_site_trace(trace_enter, name_, file_, line_, json.c_str());
+    }
+
+    scope(const scope&) = delete;
+    scope(scope&&) = delete;
+    scope& operator=(const scope&) = delete;
+    scope& operator=(scope&&) = delete;
+
+    ~scope() { webcpp_site_trace(trace_exit, name_, file_, line_, ""); }
+
+private:
+    const char* name_;
+    const char* file_;
+    int line_;
+};
+
+}  // namespace webcpp_site::detail
+
+#define WEBCPP_SITE_TRACE_CONCAT_(left, right) left##right
+#define WEBCPP_SITE_TRACE_CONCAT(left, right) WEBCPP_SITE_TRACE_CONCAT_(left, right)
+
+/**
+ Marks the enclosing scope, from here to its end, as name, with the arguments
+ shown beside it.
+ Tip: the file is its name alone (__FILE_NAME__), the same wherever the site is
+ built. Outside the site's build the arguments are gone, so a variable that
+ only they read is unused there: a trace point shows what the code already
+ uses.
+*/
+#define WEBCPP_SITE_TRACE_SCOPE(name, ...)                          \
+    const ::webcpp_site::detail::scope WEBCPP_SITE_TRACE_CONCAT(    \
+        webcpp_site_trace_scope_, __COUNTER__)(name, __FILE_NAME__, \
+                                               __LINE__ __VA_OPT__(, ) __VA_ARGS__)
+
+#else
+
+#define WEBCPP_SITE_TRACE_SCOPE(name, ...)
+
+#endif
+
+#endif  // WEBCPP_SITE_TRACE_HPP
