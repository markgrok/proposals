+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The site's wasm, build/app/site-app.mjs, built with WEBCPP_SITE_TRACE, loaded by src/trace.ts's
+// loadTraced and running the player's machine, machines/player.json: every call across between
+// JavaScript and the wasm, and every C++ scope app/site_app.cpp marks, arrive as one ordered
+// stream, each scope with its file, its line and its arguments; and the trace never changes what
+// the machine answers, nor writes anything when nothing listens.
+//
+// The npm script test:wasm runs it, never npm test, which needs no C++ build.
+
+import assert from 'node:assert/strict'
+import {existsSync, readFileSync} from 'node:fs'
+import {join} from 'node:path'
+import test from 'node:test'
+import {pathToFileURL} from 'node:url'
+import {loadSiteApp} from '../../src/machine.ts'
+import {loadTraced} from '../../src/trace.ts'
+import {site} from '../site.mjs'
+
+const module = join(site, 'build/app/site-app.mjs')
+const config = readFileSync(join(site, 'machines/player.json'), 'utf8')
+const source = readFileSync(join(site, 'app/site_app.cpp'), 'utf8')
+
+function url() {
+    assert.ok(existsSync(module), `${module} is missing: build it at the superproject's root with ` +
+        'b2 /webcpp/site/app//wasm (b2 /webcpp/site//test and b2 site build it first)')
+    return pathToFileURL(module).href
+}
+
+/** The line of app/site_app.cpp that marks the scope name. */
+function lineOf(name) {
+    const index = source.split('\n').findIndex(line => line.includes(`WEBCPP_SITE_TRACE_SCOPE("${name}"`))
+    assert.ok(index >= 0, `app/site_app.cpp marks ${name}`)
+    return index + 1
+}
+
+const events = ['{"type":"PLAY"}', '{"type":"TICK"}', '{"type":"SPEED","speed":2}', '{"type":"PAUSE"}']
+
+/** Runs the player's machine on app through events, and returns what create and each send answered. */
+function run(app) {
+    const host = app.MachineHost.create(config)
+    try {
+        return [host.snapshot(), ...events.map(event => host.send(event))]
+    } finally {
+        host.delete()
+    }
+}
+
+/** A scope's two events, cpp_enter with its arguments and cpp_exit, around the events inside it. */
+function scope(name, args, inside = []) {
+    return [
+        {kind: 'cpp_enter', name, file: 'site_app.cpp', line: lineOf(name), args},
+        ...inside,
+        {kind: 'cpp_exit', name},
+    ]
+}
+
+/** A call from JavaScript into the wasm around the events inside it, and its return. */
+function crossing(name, args, result, inside = []) {
+    return [{kind: 'js_to_wasm', name, args}, ...inside, {kind: 'return', name, result}]
+}
+
+test("the player's machine runs traced: each crossing and each C++ scope, in order", async () => {
+    const trace = []
+    const app = await loadTraced(url(), event => trace.push(event))
+    const answers = run(app)
+    const [initial, played, ticked, faster, paused] = answers
+    const context = (speed, played) => ({speed, played})
+    const expected = [
+        ...crossing('MachineHost.create', [config], {object: 'MachineHost'}, scope('machine_host::create', [])),
+        ...crossing('MachineHost.snapshot', [], initial),
+        ...crossing('MachineHost.send', [events[0]], played, scope('machine_host::send', [events[0]], [
+            ...scope('resetPlayed', []),
+        ])),
+        ...crossing('MachineHost.send', [events[1]], ticked, scope('machine_host::send', [events[1]], [
+            ...scope('countPlayed', ['TICK', context(1, 0)]),
+        ])),
+        ...crossing('MachineHost.send', [events[2]], faster, scope('machine_host::send', [events[2]], [
+            ...scope('isSpeed', ['SPEED', context(1, 1)]),
+            ...scope('setSpeed', ['SPEED', context(1, 1)]),
+        ])),
+        ...crossing('MachineHost.send', [events[3]], paused, scope('machine_host::send', [events[3]])),
+        ...crossing('MachineHost.delete', [], undefined),
+    ]
+    assert.deepEqual(trace.map(({seq, ...event}) => event), expected)
+    assert.deepEqual(trace.map(event => event.seq), trace.map((event, index) => index), 'seq counts every event')
+})
+
+test('the trace never changes what the machine answers, and is silent when nothing listens', async () => {
+    const traced = run(await loadTraced(url(), () => {}))
+    const written = []
+    const log = console.log
+    const error = console.error
+    console.log = (...args) => written.push(args)
+    console.error = (...args) => written.push(args)
+    try {
+        const plain = run(await loadSiteApp(url()))
+        assert.deepEqual(traced, plain)
+        assert.equal(JSON.parse(plain.at(-1)).value, 'paused')
+        assert.deepEqual(JSON.parse(plain.at(-1)).context, {speed: 2, played: 1})
+    } finally {
+        console.log = log
+        console.error = error
+    }
+    assert.deepEqual(written, [])
+})
