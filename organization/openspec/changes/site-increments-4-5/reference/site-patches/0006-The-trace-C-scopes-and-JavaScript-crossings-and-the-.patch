+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The player's sound: a short tone per kind of trace event, synthesized with Web Audio, with no
+// audio file. Nothing sounds before the reader's first gesture on the page, which browsers require
+// before an AudioContext may start, nor once the reader mutes it, a choice remembered in storage
+// where the browser keeps it. A browser that refuses an AudioContext, or its storage, gets a silent
+// player that works as any other: the sound never throws.
+
+import type {TraceEvent} from './trace.ts'
+
+/** A tone: its waveform, its pitch in hertz and its length in seconds. */
+export type Tone = {type: OscillatorType; frequency: number; duration: number}
+
+/**
+ * The tone of each kind of event: a call into the wasm and its return a rising and a falling
+ * pair, a call out of it higher still, the C++ scopes lower and softer in timbre, the log lowest.
+ */
+export const tones: Record<TraceEvent['kind'], Tone> = {
+    js_to_wasm: {type: 'triangle', frequency: 659.25, duration: 0.09},
+    return: {type: 'triangle', frequency: 523.25, duration: 0.09},
+    wasm_to_js: {type: 'triangle', frequency: 783.99, duration: 0.09},
+    cpp_enter: {type: 'sine', frequency: 440, duration: 0.07},
+    cpp_exit: {type: 'sine', frequency: 392, duration: 0.07},
+    log: {type: 'sine', frequency: 329.63, duration: 0.12},
+}
+
+/** The peak of a tone's gain, quiet beside the page's own. */
+const peak = 0.08
+/** How long a tone takes to reach its peak, in seconds. */
+const attack = 0.01
+/** Where a tone's gain ends: an exponential ramp cannot reach 0. */
+const floor = 0.0001
+
+/** The key the mute control is remembered under. */
+const mutedKey = 'webcpp-site:sound-muted'
+
+/** The player's sound. */
+export type Sound = {
+    /** Sounds the tone of kind, unless muted, or before the reader's first gesture. */
+    play(kind: TraceEvent['kind']): void
+    /** Whether the reader has muted the sound. */
+    readonly muted: boolean
+    /** Mutes or unmutes the sound, remembered where the browser's storage works. */
+    setMuted(muted: boolean): void
+}
+
+type AudioContextClass = new () => AudioContext
+
+/**
+ * Whether the reader has made a gesture on the page. A browser that cannot say (no userActivation)
+ * leaves it to its own autoplay policy, which keeps a context suspended until a gesture resumes it.
+ */
+function hasGesture(): boolean {
+    const activation = (globalThis.navigator as {userActivation?: {hasBeenActive: boolean}} | undefined)
+        ?.userActivation
+    return activation === undefined || activation.hasBeenActive
+}
+
+function readMuted(): boolean {
+    try {
+        return globalThis.localStorage.getItem(mutedKey) === 'true'
+    } catch {
+        return false
+    }
+}
+
+function writeMuted(muted: boolean): void {
+    try {
+        globalThis.localStorage.setItem(mutedKey, String(muted))
+    } catch {
+        // Kept for this page alone, by the sound itself.
+    }
+}
+
+/** A new AudioContext, or null where the browser has none or refuses one. */
+function newContext(): AudioContext | null {
+    const scope = globalThis as {AudioContext?: AudioContextClass; webkitAudioContext?: AudioContextClass}
+    const Context = scope.AudioContext ?? scope.webkitAudioContext
+    if (Context === undefined) {
+        return null
+    }
+    try {
+        return new Context()
+    } catch {
+        return null
+    }
+}
+
+/** Schedules tone on context, now on its clock: an oscillator through a gain envelope. */
+function schedule(context: AudioContext, tone: Tone): void {
+    const start = context.currentTime
+    const end = start + tone.duration
+    const oscillator = context.createOscillator()
+    const gain = context.createGain()
+    oscillator.type = tone.type
+    oscillator.frequency.setValueAtTime(tone.frequency, start)
+    gain.gain.setValueAtTime(0, start)
+    gain.gain.linearRampToValueAtTime(peak, start + attack)
+    gain.gain.exponentialRampToValueAtTime(floor, end)
+    oscillator.connect(gain)
+    gain.connect(context.destination)
+    oscillator.start(start)
+    oscillator.stop(end)
+}
+
+/**
+ * The player's sound, unmuted unless the reader muted it before. Its AudioContext is created on
+ * the first play after the reader's first gesture, and resumed when the browser has suspended it.
+ */
+export function createSound(): Sound {
+    let muted = readMuted()
+    let context: AudioContext | null = null
+    return {
+        play(kind) {
+            if (muted || !hasGesture()) {
+                return
+            }
+            context ??= newContext()
+            if (context === null) {
+                return
+            }
+            try {
+                if (context.state === 'suspended') {
+                    context.resume().catch(() => {
+                        // Still suspended: the next play, after a gesture, asks again.
+                    })
+                }
+                schedule(context, tones[kind])
+            } catch {
+                // A context that cannot play stays silent.
+            }
+        },
+        get muted() {
+            return muted
+        },
+        setMuted(next) {
+            muted = next
+            writeMuted(next)
+        },
+    }
+}
