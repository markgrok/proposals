+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ Tests that WEBCPP_SITE_TRACE_SCOPE is nothing outside the site's build: it
+ expands to no token at all, so code that marks its scopes compiles as it would
+ without them, and its arguments are never evaluated.
+*/
+
+#include <webcpp_site/trace.hpp>
+
+#include <boost/core/lightweight_test.hpp>
+
+#include <string_view>
+
+#ifdef WEBCPP_SITE_TRACE
+#error "trace_test checks the trace outside the site's build, without WEBCPP_SITE_TRACE"
+#endif
+
+/** The text a macro call expands to, as a string literal. */
+#define TRACE_TEST_EXPANDED(...) TRACE_TEST_QUOTED(__VA_ARGS__)
+#define TRACE_TEST_QUOTED(...) #__VA_ARGS__
+
+static_assert(
+    std::string_view(TRACE_TEST_EXPANDED(WEBCPP_SITE_TRACE_SCOPE("add", 1, "two"))).empty());
+static_assert(std::string_view(TRACE_TEST_EXPANDED(WEBCPP_SITE_TRACE_SCOPE("idle"))).empty());
+
+namespace {
+
+/** A sum through two marked scopes. */
+int add(int left, int right) {
+    WEBCPP_SITE_TRACE_SCOPE("add", left, right);
+    const int sum = left + right;
+    {
+        WEBCPP_SITE_TRACE_SCOPE("add.result", sum);
+        return sum;
+    }
+}
+
+}  // namespace
+
+int main() {
+    BOOST_TEST_EQ(add(1, 2), 3);
+    // Never const: the trace's argument below would change it, were it evaluated.
+    int evaluated = 0;  // NOLINT(misc-const-correctness)
+    {
+        WEBCPP_SITE_TRACE_SCOPE("evaluated", ++evaluated);
+    }
+    BOOST_TEST_EQ(evaluated, 0);
+    return boost::report_errors();
+}
