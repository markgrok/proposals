diff --git a/src/machine.ts b/src/machine.ts
index 761adfc..4b37a32 100644
--- a/src/machine.ts
+++ b/src/machine.ts
@@ -40,23 +40,26 @@ export type MachineSnapshot = {
 }
 
 /**
- * What useMachine gives: null while the wasm loads, then the machine's snapshot, or the error that
- * says why there is none, which the page shows as text: a wasm that could not load, a refused
- * config, or a refused event, after which the next event's snapshot follows from where the
- * machine was.
+ * What useMachine gives: null while the wasm loads, then the machine's snapshot, or, when there is
+ * no machine, the error that says why, which the page shows as text: a wasm that could not load,
+ * or a refused config.
  */
 export type MachineState = MachineSnapshot | {error: string} | null
 
+/** Why the machine refused an event, which left it where it was. */
+export type MachineRefusal = {error: string}
+
 /** XState's event: its type, and the members that travel with it. */
 export type MachineEvent = {type: string; [member: string]: unknown}
 
 /** A machine run by runMachine. */
 export type MachineRun = {
     /**
-     * Sends the event once the machine runs, handing on its snapshot or, refused, its error; does
-     * nothing before or once stopped.
+     * Sends the event once the machine runs and hands on the snapshot it leads to; returns the
+     * refusal of an event the machine refused, whose snapshot stays the last one, and nothing
+     * otherwise. Does nothing before the machine runs or once stopped.
      */
-    send(event: MachineEvent): void
+    send(event: MachineEvent): MachineRefusal | undefined
     /** Deletes the machine's host; the run hands on nothing after. */
     stop(): void
 }
@@ -65,9 +68,9 @@ function messageOf(error: unknown): string {
     return error instanceof Error ? error.message : String(error)
 }
 
-/** The state a send's JSON gives: the snapshot, or the error of a refused event, which has no `value`. */
-function stateOf(json: string): MachineState {
-    const answer = JSON.parse(json) as MachineSnapshot | {error: string}
+/** A send's JSON read: the snapshot, or the refusal of an event, which has no `value`. */
+function answerOf(json: string): MachineSnapshot | MachineRefusal {
+    const answer = JSON.parse(json) as MachineSnapshot | MachineRefusal
     return 'value' in answer ? answer : {error: answer.error}
 }
 
@@ -79,7 +82,7 @@ export async function loadSiteApp(url: string): Promise<SiteApp> {
 
 /**
  * Runs the machine of the JSON config on the app once it loads, handing on to changed its first
- * snapshot and the one each send leads to, or the error that stops it.
+ * snapshot and the one each accepted event leads to, or the error that leaves no machine.
  * Tip: useMachine's effect, apart from React, so that node tests it; a run stopped before the app
  * loads never creates its host.
  */
@@ -92,7 +95,7 @@ export function runMachine(app: Promise<SiteApp>, config: string,
             return
         }
         host = loaded.MachineHost.create(config)
-        changed(stateOf(host.snapshot()))
+        changed(JSON.parse(host.snapshot()) as MachineSnapshot)
     }).catch((error: unknown) => {
         if (!stopped) {
             changed({error: messageOf(error)})
@@ -100,9 +103,15 @@ export function runMachine(app: Promise<SiteApp>, config: string,
     })
     return {
         send(event) {
-            if (host !== null) {
-                changed(stateOf(host.send(JSON.stringify(event))))
+            if (host === null) {
+                return undefined
+            }
+            const answer = answerOf(host.send(JSON.stringify(event)))
+            if ('value' in answer) {
+                changed(answer)
+                return undefined
             }
+            return answer
         },
         stop() {
             stopped = true
@@ -126,9 +135,11 @@ function siteApp(): Promise<SiteApp> {
 
 /**
  * Runs the machine of config, XState's JSON config, in the site's wasm: its state, re-rendered on
- * each send, and the send. The host is deleted when the component unmounts or config changes.
+ * each accepted event, and the send, which returns the refusal of an event the machine refused
+ * while the snapshot stays. The host is deleted when the component unmounts or config changes.
  */
-export function useMachine(config: object): [MachineState, (event: MachineEvent) => void] {
+export function useMachine(config: object):
+    [MachineState, (event: MachineEvent) => MachineRefusal | undefined] {
     const [state, setState] = useState<MachineState>(null)
     const run = useRef<MachineRun | null>(null)
     const source = JSON.stringify(config)
