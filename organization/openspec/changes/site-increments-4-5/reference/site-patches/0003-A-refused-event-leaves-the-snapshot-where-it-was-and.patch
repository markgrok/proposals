 import assert from 'node:assert/strict'
@@ -83,19 +84,19 @@ test('runMachine hands on each snapshot, and stop deletes its host', async () =>
     assert.ok(hosts[0].isDeleted())
 })
 
-test('runMachine hands on a refused event as {error}, and the next event goes on from where the machine was', async () => {
+test("runMachine's send returns a refused event's error and keeps the snapshot, which did not move", async () => {
     const {app, hosts} = fakeApp()
     const states = []
     const run = runMachine(Promise.resolve(app), config, state => states.push(state))
     await new Promise(setImmediate)
-    run.send({type: 'PLAY'})
-    assert.doesNotThrow(() => run.send({type: 42}))
-    run.send({type: 'TICK'})
-    assert.deepEqual(states.slice(1), [
+    assert.equal(run.send({type: 'PLAY'}), undefined, 'an accepted event returns nothing')
+    assert.deepEqual(run.send({type: 42}), {error: 'MachineHost.send refused the event: invalid_event'})
+    assert.deepEqual(states, [
+        {value: 'idle', context: {taken: 0}, status: 'active'},
         {value: 'running', context: {taken: 1}, status: 'active'},
-        {error: 'MachineHost.send refused the event: invalid_event'},
-        {value: 'running', context: {taken: 2}, status: 'active'},
-    ])
+    ], 'the refusal hands on no state: the last snapshot stays')
+    run.send({type: 'TICK'})
+    assert.deepEqual(states.at(-1), {value: 'running', context: {taken: 2}, status: 'active'})
     assert.ok(!hosts[0].isDeleted(), 'a refused event keeps the host')
     run.stop()
 })
