+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// What the service worker (sw.ts) and the page's install flow (install_flow.ts) agree on: the
+// list the build writes, precache.json (tools/precache.mjs), and the caches an install fills.
+//
+// Each version of the site is cached apart, in the cache `webcpp <scope> <version>`, which holds
+// every file of its list under the file's URL, each checked against its SHA-256 before it is put,
+// and, put last, the list itself under the list's URL: a cache holding its list is complete. The
+// scope in the name keeps apart two sites of one origin, a site and the one served under its
+// prefix. A worker serves its own version's cache alone, so that a page never mixes two builds.
+
+/** One file of the site: its path from the site's root, its SHA-256 in hex, its size in bytes. */
+export type PrecacheFile = {path: string; sha256: string; size: number}
+
+/** precache.json: the version, the SHA-256 of `files`; the sum of their sizes; the files, by path. */
+export type Precache = {version: string; total: number; files: PrecacheFile[]}
+
+/** The part of the Cache API the worker and the page use. */
+export type CacheLike = {
+    match(request: string): Promise<Response | undefined>
+    put(request: string, response: Response): Promise<void>
+}
+
+/** The part of CacheStorage the worker and the page use. */
+export type CacheStorageLike = {
+    open(name: string): Promise<CacheLike>
+    has(name: string): Promise<boolean>
+    delete(name: string): Promise<boolean>
+    keys(): Promise<string[]>
+}
+
+/** Every cache of the scope's site starts with this. */
+export function cachePrefix(scope: string): string {
+    return `webcpp ${scope} `
+}
+
+/** The cache of the version of the scope's site. */
+export function cacheName(scope: string, version: string): string {
+    return cachePrefix(scope) + version
+}
+
+/** The URL of the list, `precache.json` at the scope, the site's root. */
+export function listUrl(scope: string): string {
+    return `${scope}precache.json`
+}
+
+/** The script of the worker of a version, which the page registers: `sw.js?version=<version>`. */
+export function workerUrl(scope: string, version: string): string {
+    return `${scope}sw.js?version=${encodeURIComponent(version)}`
+}
+
+/** The version a worker's script URL names, or null for a script that names none. */
+export function versionOf(script: string): string | null {
+    return new URL(script).searchParams.get('version')
+}
+
+/** The list a response holds, or null when it is not one: the page and the worker trust no other shape. */
+export async function readList(response: Response | undefined): Promise<Precache | null> {
+    if (!response?.ok) {
+        return null
+    }
+    try {
+        const list = await response.json() as Precache
+        const valid = typeof list.version === 'string' && typeof list.total === 'number' && Array.isArray(list.files) &&
+            list.files.every(file => typeof file.path === 'string' && typeof file.sha256 === 'string' && typeof file.size === 'number')
+        return valid ? list : null
+    } catch {
+        return null
+    }
+}
+
+/** The list a cache holds once complete, or null while an install has not finished it. */
+export async function installedList(cache: CacheLike, scope: string): Promise<Precache | null> {
+    return readList(await cache.match(listUrl(scope)))
+}
+
+/**
+ * The names of the scope's caches that are complete, but the version's own: the site as an earlier
+ * version installed it, whose files a new version copies rather than fetch when unchanged.
+ */
+export async function otherInstalls(caches: CacheStorageLike, scope: string, version: string): Promise<string[]> {
+    const prefix = cachePrefix(scope)
+    const others = (await caches.keys()).filter(name => name.startsWith(prefix) && name !== cacheName(scope, version))
+    const complete = await Promise.all(others.map(async name => (await installedList(await caches.open(name), scope)) !== null))
+    return others.filter((_, i) => complete[i])
+}
