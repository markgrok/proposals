+    flex-basis: 100%;
+    order: 1;
+    color: var(--muted);
+    font-size: 14px;
+}
+
+.install-actions {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px;
+}
+
+header.site > .install progress {
+    flex-basis: 100%;
+    height: 6px;
+    border: 0;
+    border-radius: 3px;
+    background: var(--rule);
+    overflow: hidden;
+    appearance: none;
+}
+
+header.site > .install progress::-webkit-progress-bar {
+    background: var(--rule);
+}
+
+header.site > .install progress::-webkit-progress-value {
+    border-radius: 3px;
+    background: var(--accent-fill);
+}
+
+header.site > .install progress::-moz-progress-bar {
+    border-radius: 3px;
+    background: var(--accent-fill);
+}
+
+/* Small enough, with a narrower gap, that the logo, the offer and the Menu share a 360 px line. */
+header.site:has(> .install-offer) {
+    column-gap: 12px;
+}
+
+header.site > .install-offer {
+    order: 1;
+    margin-left: auto;
+}
+
+header.site > .install-offer button,
+header.site > .install-offer summary {
+    padding: 4px 12px;
+    font-size: 14px;
+}
+
+.install button,
+.install-offer button,
+.install-ios summary {
+    display: block;
+    padding: 7px 16px;
+    border: 0;
+    border-radius: 980px;
+    background: var(--accent-fill);
+    color: #ffffff;
+    font: inherit;
+    font-size: 15px;
+    font-weight: 500;
+    line-height: 1.4;
+    white-space: nowrap;
+    cursor: pointer;
+}
+
+.install button.quiet,
+.install-offer button,
+.install-ios summary {
+    background: none;
+    box-shadow: inset 0 0 0 1px var(--accent);
+    color: var(--accent);
+}
+
+.install button:hover,
+.install-offer button:hover,
+.install-ios summary:hover {
+    filter: brightness(1.1);
+}
+
+.install button:focus-visible,
+.install-offer button:focus-visible,
+.install-ios summary:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+}
+
+.install-ios {
+    position: relative;
+}
+
+.install-ios summary {
+    list-style: none;
+}
+
+.install-ios summary::-webkit-details-marker {
+    display: none;
+}
+
+.install-ios p {
+    position: absolute;
+    top: calc(100% + 8px);
+    right: 0;
+    z-index: 1;
+    width: 220px;
+    margin: 0;
+    padding: 12px 14px;
+    border: 1px solid var(--rule);
+    border-radius: 12px;
+    background: var(--background);
+    color: var(--text);
+    font-size: 14px;
+    line-height: 1.45;
+}
+
+/*
+ * From 768px the navigation has the logo's line to itself until 1280px, where the offer joins it,
+ * at the right, beside the navigation; in between, the offer is a line of its own, at the right.
+ */
+@media (min-width: 768px) {
+    header.site:has(> .install),
+    header.site:has(> .install-offer) {
+        flex-wrap: wrap;
+    }
+
+    header.site > .install-offer {
+        display: flex;
+        justify-content: flex-end;
+        order: 4;
+        flex-basis: 100%;
+        margin: 6px 0 0;
+    }
+}
+
+@media (min-width: 1280px) {
+    header.site:has(> .install-offer) {
+        flex-wrap: nowrap;
+        column-gap: 24px;
+    }
+
+    header.site:has(> .install-offer) > nav {
+        margin-left: auto;
+    }
+
