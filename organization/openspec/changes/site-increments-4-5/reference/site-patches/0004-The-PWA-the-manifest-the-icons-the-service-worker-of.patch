@@ -0,0 +1,340 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The install flow as the page runs it: machines/install.json on the site's wasm (runMachine), fed
+// by what the page finds and what the service worker (sw.ts) says, and the effects of its
+// transitions. InstallPrompt's hook (install.tsx) runs it with the browser's environment; node
+// tests it with a fake one.
+//
+//   checking    reads precache.json, registers the worker of its version, and compares the caches
+//               with it (precache.ts): COMPLETE when this version is installed and serves the page;
+//               COMPLETE then NEW_VERSION when an earlier version is installed, and UPDATED once
+//               the new worker has cached the changes; MISSING, with the bytes to download and the
+//               version the reader declined, otherwise;
+//   asking      Install sends ACCEPT and asks the worker of this version to INSTALL; Not now
+//               sends DECLINE and remembers the version;
+//   installing  the worker's PROGRESS, INSTALLED and FAILED, as events; INSTALLED then asks the
+//               browser to keep the cache (navigator.storage.persist);
+//   ready       with a reload offered, Reload has the waiting worker take over, then reloads.
+//
+// A browser without a service worker or the Cache API, one that refuses to register the worker,
+// and a site without precache.json (npm run dev's) leave the machine in checking, which shows
+// nothing: the site still works from the network.
+
+import {type MachineEvent, type MachineState, type SiteApp, runMachine} from './machine.ts'
+import {
+    type CacheStorageLike, type Precache, cacheName, installedList, listUrl, otherInstalls, readList,
+    versionOf, workerUrl,
+} from './precache.ts'
+
+/** The install machine's context (machines/install.json). */
+export type InstallContext = {version: string; missing: number; done: number; reason: string; reload: boolean}
+
+/** Where the version the reader declined is kept. */
+export type DeclinedMemory = {get(): string | null; set(version: string): void}
+
+/** The part of the Web Storage API the memory uses. */
+type StorageLike = {getItem(key: string): string | null; setItem(key: string, value: string): void}
+
+/** The parts of a ServiceWorker, its registration and navigator.serviceWorker the flow uses. */
+type WorkerLike = EventTarget & {scriptURL: string; state: string; postMessage(message: unknown): void}
+type RegistrationLike = EventTarget & {active: WorkerLike | null; waiting: WorkerLike | null; installing: WorkerLike | null}
+type ContainerLike = EventTarget & {
+    controller: {scriptURL: string} | null
+    register(url: string, options: {scope: string}): Promise<RegistrationLike>
+    startMessages(): void
+}
+
+/** What the flow runs in: the browser's, or a test's fake. */
+export type InstallEnvironment = {
+    app: Promise<SiteApp>
+    /** machines/install.json, as text. */
+    config: string
+    /** The site's root, absolute, with its final slash: the worker's scope. */
+    scope: string
+    fetch(url: string, init?: RequestInit): Promise<Response>
+    caches?: CacheStorageLike
+    serviceWorker?: ContainerLike
+    declined: DeclinedMemory
+    /** Asks the browser to keep the site's storage. */
+    persist(): Promise<unknown>
+    reload(): void
+}
+
+/** The flow, run: what the prompt's buttons do, and its end. */
+export type InstallRun = {
+    accept(): void
+    decline(): void
+    reload(): void
+    stop(): void
+}
+
+/** What the prompt offers once the site is ready: the browser's install prompt, or iOS's way. */
+export type InstallOffers = {prompt: boolean; ios: boolean}
+
+/** What the prompt shows, or null for nothing. */
+export type InstallView =
+    | {kind: 'asking'; bytes: number; reason: string}
+    | {kind: 'installing'; done: number; bytes: number}
+    | {kind: 'reload'}
+    | {kind: 'installed'; app: 'prompt' | 'ios' | null}
+    | {kind: 'app'; app: 'prompt' | 'ios'}
+    | null
+
+const declinedKey = 'webcpp.install.declined'
+
+function messageOf(error: unknown): string {
+    return error instanceof Error ? error.message : String(error)
+}
+
+/**
+ * The declined version, kept in storage, which may throw (a private window's, or one the reader
+ * blocked): it is then kept for this page alone, and the next load asks again.
+ */
+export function declinedMemory(storage: () => StorageLike): DeclinedMemory {
+    let session: string | null = null
+    return {
+        get() {
+            try {
+                return storage().getItem(declinedKey) ?? session
+            } catch {
+                return session
+            }
+        },
+        set(version) {
+            session = version
+            try {
+                storage().setItem(declinedKey, version)
+            } catch {
+                // Kept for this page alone, above.
+            }
+        },
+    }
+}
+
+/**
+ * The worker of version in registration once its state is one ready accepts; a failure if it
+ * becomes redundant first. A worker the registration does not hold yet is awaited.
+ */
+function workerOf(registration: RegistrationLike, version: string, ready: (state: string) => boolean): Promise<WorkerLike> {
+    const matches = (worker: WorkerLike | null): worker is WorkerLike => worker !== null && versionOf(worker.scriptURL) === version
+    return new Promise((resolve, reject) => {
+        const watch = (worker: WorkerLike) => {
+            const step = () => {
+                if (ready(worker.state)) {
+                    worker.removeEventListener('statechange', step)
+                    resolve(worker)
+                } else if (worker.state === 'redundant') {
+                    worker.removeEventListener('statechange', step)
+                    reject(new Error('the service worker of this version stopped before it could install the site'))
+                }
+            }
+            worker.addEventListener('statechange', step)
+            step()
+        }
+        const found = [registration.active, registration.waiting, registration.installing].find(matches)
+        if (found) {
+            watch(found)
+            return
+        }
+        const update = () => {
+            if (matches(registration.installing)) {
+                registration.removeEventListener('updatefound', update)
+                watch(registration.installing)
+            }
+        }
+        registration.addEventListener('updatefound', update)
+    })
+}
+
+/** The bytes of list the version's cache lacks: every file, unless an earlier try cached some. */
+async function missingBytes(caches: CacheStorageLike, scope: string, list: Precache): Promise<number> {
+    const name = cacheName(scope, list.version)
+    if (!(await caches.has(name))) {
+        return list.total
+    }
+    const cache = await caches.open(name)
+    const absent = await Promise.all(list.files.map(async file => (await cache.match(scope + file.path)) === undefined))
+    return list.files.reduce((sum, file, i) => sum + (absent[i] ? file.size : 0), 0)
+}
+
+/** Runs the install flow, handing on to changed each state of its machine (runMachine's). */
+export function runInstall(env: InstallEnvironment, changed: (state: MachineState) => void): InstallRun {
+    let state: MachineState = null
+    let stopped = false
+    let list: Precache | null = null
+    let registration: RegistrationLike | null = null
+    let started: () => void = () => {}
+    const running = new Promise<void>(resolve => {
+        started = resolve
+    })
+    const machine = runMachine(env.app, env.config, next => {
+        state = next
+        changed(next)
+        if (next !== null && 'value' in next) {
+            started()
+        }
+    })
+    const send = (event: MachineEvent) => {
+        if (!stopped) {
+            machine.send(event)
+        }
+    }
+    const value = () => (state !== null && 'value' in state ? state.value : null)
+
+    const heard = (event: Event) => {
+        const data = (event as MessageEvent).data as {type?: unknown; version?: unknown; bytes?: unknown; reason?: unknown} | null
+        if (list === null || typeof data !== 'object' || data === null || data.version !== list.version) {
+            return
+        }
+        if (data.type === 'PROGRESS' && typeof data.bytes === 'number') {
+            send({type: 'PROGRESS', bytes: data.bytes})
+        } else if (data.type === 'INSTALLED') {
+            send({type: 'INSTALLED'})
+            if (value() === 'ready') {
+                env.persist().catch(() => {})
+            }
+        } else if (data.type === 'FAILED' && typeof data.reason === 'string') {
+            send({type: 'FAILED', reason: data.reason})
+        }
+    }
+
+    async function check() {
+        const {serviceWorker: container, caches} = env
+        if (!container || !caches) {
+            return
+        }
+        let fetched: Precache | null
+        try {
+            fetched = await readList(await env.fetch(listUrl(env.scope), {cache: 'no-store'}))
+        } catch {
+            return
+        }
+        if (fetched === null || stopped) {
+            return
+        }
+        const version = fetched.version
+        let registered: RegistrationLike
+        try {
+            registered = await container.register(workerUrl(env.scope, version), {scope: env.scope})
+        } catch {
+            return
+        }
+        if (stopped) {
+            return
+        }
+        list = fetched
+        registration = registered
+        container.addEventListener('message', heard)
+        container.startMessages()
+        const own = cacheName(env.scope, version)
+        const complete = (await caches.has(own)) && (await installedList(await caches.open(own), env.scope)) !== null
+        const earlier = await otherInstalls(caches, env.scope, version)
+        const serving = container.controller ? versionOf(container.controller.scriptURL) : null
+        const bytes = complete || earlier.length > 0 ? 0 : await missingBytes(caches, env.scope, fetched)
+        await running
+        if (stopped) {
+            return
+        }
+        if (complete && (serving === null || serving === version)) {
+            send({type: 'COMPLETE'})
+        } else if (complete || earlier.length > 0) {
+            send({type: 'COMPLETE'})
+            send({type: 'NEW_VERSION'})
+            const updated = (worker: string) => worker === 'installed' || worker === 'activating' || worker === 'activated'
+            workerOf(registered, version, updated).then(() => send({type: 'UPDATED'}), () => {
+                // The update failed: the installed version keeps serving, and the next page tries again.
+            })
+        } else {
+            send({type: 'MISSING', bytes, version, declined: env.declined.get()})
+        }
+    }
+
+    check().catch((error: unknown) => {
+        // What fails here leaves the flow in checking, which shows nothing; the site works from the network.
+        if (!stopped) {
+            console.warn('webcpp: the install flow stopped:', messageOf(error))
+        }
+    })
+
+    return {
+        accept() {
+            const at = list
+            const registered = registration
+            if (stopped || at === null || registered === null) {
+                return
+            }
+            send({type: 'ACCEPT'})
+            if (value() !== 'installing') {
+                return
+            }
+            workerOf(registered, at.version, worker => worker === 'activated').then(worker => {
+                if (!stopped) {
+                    worker.postMessage({type: 'INSTALL'})
+                }
+            }, (error: unknown) => send({type: 'FAILED', reason: messageOf(error)}))
+        },
+        decline() {
+            if (stopped || list === null) {
+                return
+            }
+            send({type: 'DECLINE'})
+            if (value() === 'declined') {
+                env.declined.set(list.version)
+            }
+        },
+        reload() {
+            const waiting = registration?.waiting
+            if (list !== null && env.serviceWorker && waiting && versionOf(waiting.scriptURL) === list.version) {
+                env.serviceWorker.addEventListener('controllerchange', () => env.reload(), {once: true})
+                waiting.postMessage({type: 'SKIP_WAITING'})
+                return
+            }
+            env.reload()
+        },
+        stop() {
+            stopped = true
+            machine.stop()
+            env.serviceWorker?.removeEventListener('message', heard)
+        },
+    }
+}
+
+/** What the prompt shows for state, the machine's, with the offers the browser makes. */
+export function installView(state: MachineState, offers: InstallOffers): InstallView {
+    if (state === null || !('value' in state)) {
+        return null
+    }
+    const context = state.context as InstallContext
+    const app = offers.prompt ? 'prompt' : offers.ios ? 'ios' : null
+    switch (state.value) {
+        case 'asking':
+            return {kind: 'asking', bytes: context.missing, reason: context.reason}
+        case 'installing':
+            return {kind: 'installing', done: context.done, bytes: context.missing}
+        case 'ready':
+            if (context.reload) {
+                return {kind: 'reload'}
+            }
+            if (context.done > 0) {
+                return {kind: 'installed', app}
+            }
+            return app === null ? null : {kind: 'app', app}
+        default:
+            return null
+    }
+}
+
+/** A size as a reader reads it: 512 bytes, 41 kB, 6.2 MB. */
+export function formatBytes(bytes: number): string {
+    if (bytes < 1000) {
+        return `${bytes} bytes`
+    }
+    if (bytes < 1_000_000) {
+        return `${Math.round(bytes / 1000)} kB`
+    }
+    return `${(bytes / 1_000_000).toFixed(1)} MB`
+}
