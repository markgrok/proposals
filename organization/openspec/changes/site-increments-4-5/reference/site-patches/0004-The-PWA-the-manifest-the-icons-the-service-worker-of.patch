--- /dev/null
+++ b/tools/precache.mjs
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// precache.json, the list the PWA precaches (src/precache.ts reads it), which the build's --pwa
+// step writes into a site laid out whole, last, so that it lists the final files:
+//
+//   {"version": <the SHA-256 of files, as JSON>, "total": <the sum of their sizes>,
+//    "files": [{"path": <from the site's root>, "sha256": <hex>, "size": <bytes>}, ...]}
+//
+// Every file of the site is listed, sorted by path, but the root's precache.json and sw.js: the
+// list cannot hold its own hash, and the service worker is the browser's to update, by its URL,
+// which names the version. A change of one byte changes that file's entry and the version alone.
+
+import {createHash} from 'node:crypto'
+import {readdir, readFile, realpath, rename, writeFile} from 'node:fs/promises'
+import {join, relative} from 'node:path'
+
+/** The PWA's own files at the site's root, which the list leaves out. */
+const own = new Set(['precache.json', 'sw.js'])
+
+/** The list of the site in directory, a link to one followed. */
+export async function precache(directory) {
+    const root = await realpath(directory)
+    const entries = await readdir(root, {recursive: true, withFileTypes: true})
+    const paths = entries
+        .filter(entry => entry.isFile())
+        .map(entry => relative(root, join(entry.parentPath, entry.name)).split('\\').join('/'))
+        .filter(path => !own.has(path))
+        .sort()
+    const files = []
+    for (const path of paths) {
+        const content = await readFile(join(root, path))
+        files.push({path, sha256: createHash('sha256').update(content).digest('hex'), size: content.length})
+    }
+    return {
+        version: createHash('sha256').update(JSON.stringify(files)).digest('hex'),
+        total: files.reduce((sum, file) => sum + file.size, 0),
+        files,
+    }
+}
+
+/** The list as JSON for its reader: one file per line. */
+function laidOut(list) {
+    return [
+        '{',
+        `    "version": ${JSON.stringify(list.version)},`,
+        `    "total": ${list.total},`,
+        '    "files": [',
+        list.files.map(file => `        {"path": ${JSON.stringify(file.path)}, "sha256": "${file.sha256}", "size": ${file.size}}`).join(',\n'),
+        '    ]',
+        '}',
+        '',
+    ].join('\n')
+}
+
+/** Writes precache.json at directory's root, by one rename, and returns the list. */
+export async function writePrecache(directory) {
+    const list = await precache(directory)
+    const root = await realpath(directory)
+    const next = join(root, `.precache.json.${process.pid}.next`)
+    await writeFile(next, laidOut(list))
+    await rename(next, join(root, 'precache.json'))
+    return list
+}
