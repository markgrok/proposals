+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The list the PWA precaches, precache.json (tools/precache.mjs), over a site of a few files: every
+// file with its SHA-256 and size, sorted by path, but the list itself and the service worker; the
+// total; and a version that a change of one byte changes, with that file's entry alone. The
+// build's --pwa step writes it last, into a site laid out whole.
+
+import assert from 'node:assert/strict'
+import {execFileSync} from 'node:child_process'
+import {createHash} from 'node:crypto'
+import {mkdirSync, mkdtempSync, readFileSync, symlinkSync, writeFileSync} from 'node:fs'
+import {tmpdir} from 'node:os'
+import {dirname, join} from 'node:path'
+import test from 'node:test'
+import {precache, writePrecache} from '../tools/precache.mjs'
+import {site} from './site.mjs'
+
+const sha256 = text => createHash('sha256').update(text).digest('hex')
+
+/** A site of the given files, `{path: content}`, in a new directory. */
+function fixture(files) {
+    const out = mkdtempSync(join(tmpdir(), 'webcpp-precache-'))
+    for (const [path, content] of Object.entries(files)) {
+        mkdirSync(dirname(join(out, path)), {recursive: true})
+        writeFileSync(join(out, path), content)
+    }
+    return out
+}
+
+const files = {
+    'index.html': '<!doctype html><title>webcpp</title>\n',
+    'libraries/index.html': '<!doctype html><title>Libraries</title>\n',
+    'assets/site.js': 'console.log(1)\n',
+    'assets/app/site-app.wasm': Buffer.from([0, 0x61, 0x73, 0x6d, 1, 0, 0, 0]),
+    'favicon.ico': Buffer.from([0, 0, 1, 0]),
+    'sw.js': 'self.addEventListener("fetch", () => {})\n',
+    'precache.json': '{"version": "an older list"}\n',
+}
+
+test('every file is listed with its SHA-256 and size, sorted by path, but the list and the service worker', async () => {
+    const list = await precache(fixture(files))
+    const listed = Object.keys(files).filter(path => path !== 'sw.js' && path !== 'precache.json').sort()
+    assert.deepEqual(list.files.map(file => file.path), listed)
+    for (const file of list.files) {
+        const content = Buffer.from(files[file.path])
+        assert.deepEqual(file, {path: file.path, sha256: sha256(content), size: content.length}, file.path)
+    }
+})
+
+test('total is the sum of the sizes, and version is the SHA-256 of the list', async () => {
+    const list = await precache(fixture(files))
+    assert.equal(list.total, list.files.reduce((sum, file) => sum + file.size, 0))
+    assert.equal(list.version, sha256(JSON.stringify(list.files)))
+    assert.deepEqual(Object.keys(list), ['version', 'total', 'files'])
+})
+
+test('one byte changed in one file changes the version, and that file\'s entry alone', async () => {
+    const before = await precache(fixture(files))
+    const after = await precache(fixture({...files, 'assets/site.js': 'console.log(2)\n'}))
+    assert.notEqual(after.version, before.version)
+    const changed = after.files.filter((file, i) => JSON.stringify(file) !== JSON.stringify(before.files[i]))
+    assert.deepEqual(changed.map(file => file.path), ['assets/site.js'])
+    assert.equal(after.total, before.total)
+})
+
+test('a nested sw.js or precache.json is a file like any other: only the root\'s are the PWA\'s own', async () => {
+    const list = await precache(fixture({...files, 'docs/sw.js': 'x', 'docs/precache.json': '{}'}))
+    assert.ok(list.files.some(file => file.path === 'docs/sw.js'))
+    assert.ok(list.files.some(file => file.path === 'docs/precache.json'))
+})
+
+test('a site reached through a link, as bin/site is, is listed as the directory it names', async () => {
+    const out = fixture(files)
+    const link = join(mkdtempSync(join(tmpdir(), 'webcpp-precache-link-')), 'site')
+    symlinkSync(out, link)
+    assert.deepEqual(await precache(link), await precache(out))
+})
+
+test('writePrecache writes precache.json, laid out for its reader, and listing nothing it wrote', async () => {
+    const out = fixture(files)
+    const written = await writePrecache(out)
+    const text = readFileSync(join(out, 'precache.json'), 'utf8')
+    assert.deepEqual(JSON.parse(text), written)
+    assert.match(text, /^\{\n {4}"version": "[0-9a-f]{64}",\n {4}"total": \d+,\n {4}"files": \[\n {8}\{"path": "assets\/app\/site-app\.wasm", /)
+    assert.deepEqual(await writePrecache(out), written, 'writing it again lists the same files')
+})
+
+test('build.mjs --pwa <site> writes precache.json into a site laid out whole', () => {
+    const out = fixture(files)
+    execFileSync(process.execPath, [join(site, 'tools/build.mjs'), '--pwa', out], {stdio: 'pipe'})
+    const list = JSON.parse(readFileSync(join(out, 'precache.json'), 'utf8'))
+    assert.equal(list.files.length, 5)
+})
diff --git a/test/pwa.mjs b/test/pwa.mjs
new file mode 100644
index 0000000..4101d51
--- /dev/null
+++ b/test/pwa.mjs
@@ -0,0 +1,97 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// What the tests of the PWA share: the Cache API and the network, in memory, and a site's list as
+// precache.json gives it.
+
+import {createHash} from 'node:crypto'
+import {cacheName} from '../src/precache.ts'
+
+export const scope = 'https://webcpporg.github.io/'
+export const sha256 = text => createHash('sha256').update(text).digest('hex')
+
+/** The list precache.json holds for the files `{path: content}`. */
+export function listOf(files) {
+    const entries = Object.entries(files).sort(([a], [b]) => (a < b ? -1 : 1))
+        .map(([path, content]) => ({path, sha256: sha256(content), size: Buffer.byteLength(content)}))
+    return {version: sha256(JSON.stringify(entries)), total: entries.reduce((sum, file) => sum + file.size, 0), files: entries}
+}
+
+/** A Cache of the Cache API, in memory: each response kept as its body and type. */
+export class FakeCache {
+    entries = new Map()
+    async match(request) {
+        const entry = this.entries.get(typeof request === 'string' ? request : request.url)
+        return entry && new Response(entry.body, {headers: {'content-type': entry.type}})
+    }
+    async put(request, response) {
+        const url = typeof request === 'string' ? request : request.url
+        this.entries.set(url, {body: Buffer.from(await response.arrayBuffer()), type: response.headers.get('content-type')})
+    }
+    async delete(request) {
+        return this.entries.delete(typeof request === 'string' ? request : request.url)
+    }
+    async keys() {
+        return [...this.entries.keys()].map(url => ({url}))
+    }
+}
+
+/** The CacheStorage of the Cache API, in memory. */
+export class FakeCaches {
+    named = new Map()
+    async open(name) {
+        if (!this.named.has(name)) {
+            this.named.set(name, new FakeCache())
+        }
+        return this.named.get(name)
+    }
+    async has(name) {
+        return this.named.has(name)
+    }
+    async delete(name) {
+        return this.named.delete(name)
+    }
+    async keys() {
+        return [...this.named.keys()]
+    }
+}
+
+/**
+ * The network: the files `{path: content}` under the scope, and `precache.json` for their list,
+ * every request recorded; offline, every fetch fails as a browser's does.
+ */
+export function network(files, list = listOf(files)) {
+    const served = new Map(Object.entries(files).map(([path, content]) => [scope + path, content]))
+    served.set(`${scope}precache.json`, JSON.stringify(list))
+    const net = {
+        offline: false,
+        requested: [],
+        async fetch(input) {
+            const url = typeof input === 'string' ? input : input.url
+            net.requested.push(url)
+            if (net.offline) {
+                throw new TypeError('Failed to fetch')
+            }
+            if (!served.has(url)) {
+                return new Response('Not found', {status: 404})
+            }
+            const type = url.endsWith('.json') ? 'application/json' : url.endsWith('.html') || url.endsWith('/') ? 'text/html' : 'text/javascript'
+            return new Response(served.get(url), {headers: {'content-type': type}})
+        },
+    }
+    return net
+}
+
+/** A cache of the scope holding `files` of `list`, complete with the list, as an install leaves it. */
+export async function installed(caches, files, list = listOf(files)) {
+    const cache = await caches.open(cacheName(scope, list.version))
+    for (const [path, content] of Object.entries(files)) {
+        await cache.put(scope + path, new Response(content, {headers: {'content-type': 'text/html'}}))
+    }
+    await cache.put(`${scope}precache.json`, new Response(JSON.stringify(list)))
+    return cache
+}
+
diff --git a/test/sw_test.mjs b/test/sw_test.mjs
