+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+import {defineComponent} from '@openuidev/react-lang'
+import {useEffect, useMemo, useRef, useState, useSyncExternalStore} from 'react'
+import * as z from 'zod'
+import install from '../machines/install.json' with {type: 'json'}
+import {useShared} from './context.js'
+import {declinedMemory, formatBytes, type InstallOffers, type InstallRun, installView, runInstall} from './install_flow.js'
+import {type MachineState, siteApp} from './machine.js'
+
+/** Chrome's, Edge's and Android's event, which lets a page show the browser's install prompt later. */
+type InstallPromptEvent = Event & {prompt(): Promise<unknown>}
+
+/**
+ * The browser's install prompt, kept from its beforeinstallprompt, which may come before React
+ * hydrates the page, so it is listened for as the bundle loads; and who wants to know of a change.
+ */
+let deferred: InstallPromptEvent | null = null
+const watchers = new Set<() => void>()
+
+function promptChanged(next: InstallPromptEvent | null) {
+    deferred = next
+    for (const watcher of watchers) {
+        watcher()
+    }
+}
+
+if (typeof window !== 'undefined') {
+    window.addEventListener('beforeinstallprompt', event => {
+        // The prompt's own button shows it, in place of the browser's banner.
+        event.preventDefault()
+        promptChanged(event as InstallPromptEvent)
+    })
+    window.addEventListener('appinstalled', () => promptChanged(null))
+}
+
+/** The declined version, for this page; localStorage is read only inside the memory's try. */
+const declined = declinedMemory(() => window.localStorage)
+
+/** Whether this is iOS outside the installed app: no install prompt there, but Add to Home Screen. */
+function onIos(): boolean {
+    const browser = navigator as Navigator & {standalone?: boolean}
+    const apple = /iPad|iPhone|iPod/.test(browser.userAgent) || (browser.platform === 'MacIntel' && browser.maxTouchPoints > 1)
+    return apple && browser.standalone !== true && !window.matchMedia('(display-mode: standalone)').matches
+}
+
+/** What the browser offers once the site is ready, and how to show its prompt; nothing on the server. */
+function useOffers(): InstallOffers & {showPrompt(): void} {
+    const prompt = useSyncExternalStore(watch => {
+        watchers.add(watch)
+        return () => {
+            watchers.delete(watch)
+        }
+    }, () => deferred, () => null)
+    const [ios, setIos] = useState(false)
+    useEffect(() => setIos(onIos()), [])
+    return {
+        prompt: prompt !== null,
+        ios,
+        showPrompt() {
+            if (deferred !== null) {
+                // The event's prompt shows once: the browser then fires another when it may again.
+                const shown = deferred
+                promptChanged(null)
+                shown.prompt().catch(() => {})
+            }
+        },
+    }
+}
+
+/**
+ * Runs the install flow (install_flow.ts) on the site's wasm while the component is mounted: the
+ * machine's state, and what the prompt's buttons do.
+ */
+export function useInstall(): [MachineState, Pick<InstallRun, 'accept' | 'decline' | 'reload'>] {
+    const {site} = useShared()
+    const [state, setState] = useState<MachineState>(null)
+    const run = useRef<InstallRun | null>(null)
+    useEffect(() => {
+        const started = runInstall({
+            app: siteApp(),
+            config: JSON.stringify(install),
+            scope: new URL(site.root || './', window.location.href).href,
+            fetch: (url, init) => window.fetch(url, init),
+            // Both are missing where the page is not a secure context.
+            caches: 'caches' in window ? window.caches : undefined,
+            serviceWorker: 'serviceWorker' in navigator ? navigator.serviceWorker : undefined,
+            declined,
+            persist: async () => navigator.storage?.persist?.(),
+            reload: () => window.location.reload(),
+        }, setState)
+        run.current = started
+        return () => {
+            started.stop()
+            if (run.current === started) {
+                run.current = null
+            }
+        }
+    }, [site.root])
+    const actions = useMemo(() => ({
+        accept: () => run.current?.accept(),
+        decline: () => run.current?.decline(),
+        reload: () => run.current?.reload(),
+    }), [])
+    return [state, actions]
+}
+
+/**
+ * The offer to install the app itself: the browser's prompt, or, on iOS, which has none, how to add
+ * the site to the Home Screen, under the same words.
+ */
+function AppOffer({app, showPrompt}: {app: 'prompt' | 'ios'; showPrompt(): void}) {
+    if (app === 'prompt') {
+        return <button type="button" className="install-app" onClick={showPrompt}>Install the app</button>
+    }
+    return (
+        <details className="install-ios">
+            <summary>Install the app</summary>
+            <p>In Safari, tap Share, then Add to Home Screen.</p>
+        </details>
+    )
+}
+
+/**
+ * The site's offer to install itself for instant and offline use, which the Header holds: the
+ * question, with the size to download; the progress; the reload a new version offers; and, once the
+ * site is installed, the browser's way to install the app. It shows nothing until the flow has
+ * something to say, so the page the build renders, and the one the browser hydrates, hold none.
+ */
+export const InstallPrompt = defineComponent({
+    name: 'InstallPrompt',
+    description: 'The offer to install the site for instant and offline use. The Header places it; a page never names it.',
+    props: z.object({}),
+    component: function InstallOffer() {
+        const [state, flow] = useInstall()
+        const offers = useOffers()
+        const [closed, setClosed] = useState(false)
+        const view = installView(state, offers)
+        if (view === null || (closed && view.kind === 'installed')) {
+            return null
+        }
+        switch (view.kind) {
+            case 'asking':
+                return (
+                    <section className="install" aria-label="Install the site">
+                        <p>{`Install this site for instant and offline use? It downloads ${formatBytes(view.bytes)}, once.`}</p>
+                        {view.reason ? <p className="install-note">{`The last try stopped: ${view.reason}`}</p> : null}
+                        <p className="install-actions">
+                            <button type="button" onClick={flow.accept}>Install</button>
+                            <button type="button" className="quiet" onClick={flow.decline}>Not now</button>
+                        </p>
+                    </section>
+                )
+            case 'installing':
+                return (
+                    <section className="install" aria-label="Install the site">
+                        <p role="status">{`Installing: ${formatBytes(view.done)} of ${formatBytes(view.bytes)}`}</p>
+                        <progress max={view.bytes} value={view.done} />
+                    </section>
+                )
+            case 'reload':
+                return (
+                    <section className="install" aria-label="A new version">
+                        <p>A new version of this site is ready.</p>
+                        <p className="install-actions">
+                            <button type="button" onClick={flow.reload}>Reload</button>
+                        </p>
+                    </section>
+                )
+            case 'installed':
+                return (
+                    <section className="install" aria-label="Installed">
+                        <p role="status">Installed: this site now opens at once, even offline.</p>
+                        <p className="install-actions">
+                            {view.app ? <AppOffer app={view.app} showPrompt={offers.showPrompt} /> : null}
+                            <button type="button" className="quiet" onClick={() => setClosed(true)}>Close</button>
+                        </p>
+                    </section>
+                )
+            case 'app':
+                return <div className="install-offer"><AppOffer app={view.app} showPrompt={offers.showPrompt} /></div>
+        }
+    },
+})
