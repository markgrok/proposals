diff --git a/app/test/install_test.cpp b/app/test/install_test.cpp
new file mode 100644
index 0000000..75c1deb
--- /dev/null
+++ b/app/test/install_test.cpp
@@ -0,0 +1,237 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ Tests machine_host on the install flow's machine, machines/install.json,
+ whose path is the program's one argument: every transition of the flow, its
+ context through them, and a version the reader declined, which is not asked
+ again.
+*/
+
+#include "site_app.hpp"
+
+#include <boost/core/lightweight_test.hpp>
+#include <boost/json.hpp>
+#include <boost/system/result.hpp>
+
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <initializer_list>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace {
+
+/**
+ The text of the file at path, read into buffer, or "" when it cannot be read or does not fit.
+ Tip: a buffer, since a std::string grown here is a throw clang-tidy finds reaching main.
+*/
+std::string_view read_file(const char* path, std::span<char> buffer) {
+    std::FILE* file = std::fopen(path, "rb");
+    if (file == nullptr) {
+        return {};
+    }
+    const std::size_t count = std::fread(buffer.data(), 1, buffer.size(), file);
+    const bool whole = std::feof(file) != 0 && std::ferror(file) == 0;
+    const bool closed = std::fclose(file) == 0;
+    return whole && closed ? std::string_view(buffer.data(), count) : std::string_view();
+}
+
+/** A snapshot's JSON, as machine_host writes it, read back; null when it is not JSON. */
+boost::json::value parsed(std::string_view json) {
+    boost::system::error_code failed;
+    const boost::json::value value = boost::json::parse(json, failed);
+    BOOST_TEST(!failed);
+    return failed ? boost::json::value() : value;
+}
+
+/** The member key of the snapshot's context, or null when it has none. */
+boost::json::value context_member(const boost::json::value& snapshot, std::string_view key) {
+    const boost::json::value* context = snapshot.as_object().if_contains("context");
+    if (context == nullptr || !context->is_object()) {
+        return nullptr;
+    }
+    const boost::json::value* member = context->as_object().if_contains(key);
+    return member == nullptr ? boost::json::value() : *member;
+}
+
+/**
+ The machine of config after each event in turn: its last snapshot, or null when the config or
+ an event is refused.
+*/
+boost::json::value after(std::string_view config, std::initializer_list<std::string_view> events) {
+    boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return nullptr;
+    }
+    webcpp_site::machine_host& flow = host.unsafe_value();
+    boost::json::value last = parsed(flow.snapshot());
+    for (const std::string_view event : events) {
+        const boost::system::result<std::string> sent = flow.send(event);
+        if (!BOOST_TEST(sent.has_value())) {
+            return nullptr;
+        }
+        last = parsed(sent.unsafe_value());
+    }
+    BOOST_TEST_EQ(last.at("status"), boost::json::value("active"));
+    return last;
+}
+
+/** Whether snapshot is an object whose value is state; a failed test otherwise. */
+bool is_in(const boost::json::value& snapshot, std::string_view state) {
+    return BOOST_TEST(snapshot.is_object()) &&
+           BOOST_TEST_EQ(snapshot.at("value"), boost::json::value(state));
+}
+
+constexpr std::string_view missing =
+    R"({"type": "MISSING", "bytes": 1234, "version": "v2", "declined": null})";
+
+void starts_checking(std::string_view config) {
+    const boost::json::value checking = after(config, {});
+    if (!is_in(checking, "checking")) {
+        return;
+    }
+    BOOST_TEST_EQ(context_member(checking, "missing"), boost::json::value(0));
+    BOOST_TEST_EQ(context_member(checking, "done"), boost::json::value(0));
+    BOOST_TEST_EQ(context_member(checking, "version"), boost::json::value(""));
+    BOOST_TEST_EQ(context_member(checking, "reason"), boost::json::value(""));
+    BOOST_TEST_EQ(context_member(checking, "reload"), boost::json::value(false));
+}
+
+void complete_is_ready(std::string_view config) {
+    const boost::json::value ready = after(config, {R"({"type": "COMPLETE"})"});
+    if (is_in(ready, "ready")) {
+        BOOST_TEST_EQ(context_member(ready, "reload"), boost::json::value(false));
+    }
+}
+
+void missing_asks_with_the_size(std::string_view config) {
+    const boost::json::value asking = after(config, {missing});
+    if (!is_in(asking, "asking")) {
+        return;
+    }
+    BOOST_TEST_EQ(context_member(asking, "missing"), boost::json::value(1234));
+    BOOST_TEST_EQ(context_member(asking, "version"), boost::json::value("v2"));
+}
+
+void a_declined_version_is_not_asked_again(std::string_view config) {
+    const boost::json::value declined =
+        after(config, {R"({"type": "MISSING", "bytes": 1234, "version": "v2", "declined": "v2"})"});
+    if (is_in(declined, "declined")) {
+        BOOST_TEST_EQ(context_member(declined, "version"), boost::json::value("v2"));
+    }
+    const boost::json::value other =
+        after(config, {R"({"type": "MISSING", "bytes": 1234, "version": "v2", "declined": "v1"})"});
+    is_in(other, "asking");
+    const boost::json::value never =
+        after(config, {R"({"type": "MISSING", "bytes": 1234, "version": "v2"})"});
+    is_in(never, "asking");
+}
+
+void decline_is_declined(std::string_view config) {
+    const boost::json::value declined = after(config, {missing, R"({"type": "DECLINE"})"});
+    if (is_in(declined, "declined")) {
+        BOOST_TEST_EQ(context_member(declined, "version"), boost::json::value("v2"));
+    }
+}
+
+void installs_counting_the_bytes(std::string_view config) {
+    const boost::json::value installing =
+        after(config, {
+                          missing,
+                          R"({"type": "ACCEPT"})",
+                          R"({"type": "PROGRESS", "bytes": 1000})",
+                          R"({"type": "PROGRESS", "bytes": 234})",
+                      });
+    if (is_in(installing, "installing")) {
+        BOOST_TEST_EQ(context_member(installing, "done"), boost::json::value(1234));
+    }
+    const boost::json::value ready = after(config, {
+                                                       missing,
+                                                       R"({"type": "ACCEPT"})",
+                                                       R"({"type": "PROGRESS", "bytes": 1234})",
+                                                       R"({"type": "INSTALLED"})",
+                                                   });
+    if (is_in(ready, "ready")) {
+        BOOST_TEST_EQ(context_member(ready, "reload"), boost::json::value(false));
+    }
+}
+
+void a_failure_asks_again_with_its_reason(std::string_view config) {
+    const boost::json::value asking =
+        after(config, {
+                          missing,
+                          R"({"type": "ACCEPT"})",
+                          R"({"type": "PROGRESS", "bytes": 1000})",
+                          R"({"type": "FAILED", "reason": "the network failed"})",
+                      });
+    if (!is_in(asking, "asking")) {
+        return;
+    }
+    BOOST_TEST_EQ(context_member(asking, "reason"), boost::json::value("the network failed"));
+    const boost::json::value again =
+        after(config, {
+                          missing,
+                          R"({"type": "ACCEPT"})",
+                          R"({"type": "PROGRESS", "bytes": 1000})",
+                          R"({"type": "FAILED", "reason": "the network failed"})",
+                          R"({"type": "ACCEPT"})",
+                      });
+    if (is_in(again, "installing")) {
+        BOOST_TEST_EQ(context_member(again, "done"), boost::json::value(0));
+        BOOST_TEST_EQ(context_member(again, "reason"), boost::json::value(""));
+    }
+}
+
+void a_new_version_updates_then_offers_a_reload(std::string_view config) {
+    const boost::json::value updating =
+        after(config, {R"({"type": "COMPLETE"})", R"({"type": "NEW_VERSION"})"});
+    is_in(updating, "updating");
+    const boost::json::value ready =
+        after(config,
+              {R"({"type": "COMPLETE"})", R"({"type": "NEW_VERSION"})", R"({"type": "UPDATED"})"});
+    if (is_in(ready, "ready")) {
+        BOOST_TEST_EQ(context_member(ready, "reload"), boost::json::value(true));
+    }
+}
+
+void an_event_no_state_takes_moves_nothing(std::string_view config) {
+    is_in(after(config,
+                {
+                    R"({"type": "ACCEPT"})",
+                    R"({"type": "INSTALLED"})",
+                }),
+          "checking");
+    is_in(after(config, {R"({"type": "COMPLETE"})", R"({"type": "MISSING", "bytes": 1})"}),
+          "ready");
+    is_in(after(config, {missing, R"({"type": "DECLINE"})", R"({"type": "ACCEPT"})"}), "declined");
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+    if (!BOOST_TEST_EQ(argc, 2)) {
+        return boost::report_errors();
+    }
+    std::array<char, 65536> buffer{};
+    const std::string_view config = read_file(argv[1], buffer);
+    if (!BOOST_TEST(!config.empty())) {
+        return boost::report_errors();
+    }
+    starts_checking(config);
+    complete_is_ready(config);
+    missing_asks_with_the_size(config);
+    a_declined_version_is_not_asked_again(config);
+    decline_is_declined(config);
+    installs_counting_the_bytes(config);
+    a_failure_asks_again_with_its_reason(config);
+    a_new_version_updates_then_offers_a_reload(config);
+    an_event_no_state_takes_moves_nothing(config);
+    return boost::report_errors();
+}
