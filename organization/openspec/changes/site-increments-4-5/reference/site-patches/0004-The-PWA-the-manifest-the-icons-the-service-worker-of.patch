index 0000000..5cfbebf
--- /dev/null
+++ b/src/sw.ts
@@ -0,0 +1,323 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The site's service worker, bundled to sw.js at the site's root (tools/build.mjs). The page
+// registers it as sw.js?version=<v>, the version of the precache.json it read (install_flow.ts),
+// so that each build of the site has a worker of its own, which serves that build's cache alone
+// (precache.ts says how the caches are laid out):
+//
+//   install    with no install of the site yet, nothing: the reader has not been asked; the worker
+//              takes over at once. With an earlier version installed, the new version's files,
+//              those unchanged copied from the earlier cache and only those whose SHA-256 differs
+//              fetched, each checked, PROGRESS posted to the pages; the worker then waits for the
+//              reader's reload (SKIP_WAITING), the old one still serving the pages open;
+//   activate   removes the caches of every other version of the scope's site;
+//   fetch      a file of the installed list from the cache, without the network; any other
+//              same-origin GET from the network, precache.json first among them, and from the
+//              cache when the network fails, a navigation to its page there; another origin's
+//              request is never answered, so never cached;
+//   message    INSTALL, from the page whose reader accepted, caches what is missing, replying
+//              PROGRESS for each file, then INSTALLED or FAILED with the reason.
+//
+// The handlers are serviceWorker()'s, over the environment it is given, which node tests with a
+// fake one; the last lines give them the worker's own, when the bundle runs as one.
+
+import {
+    type CacheLike, type CacheStorageLike, type Precache, type PrecacheFile, cacheName, cachePrefix,
+    installedList, listUrl, otherInstalls, readList, versionOf,
+} from './precache.ts'
+
+export {cacheName}
+
+/** What the worker posts to a page; each names the version it is of. */
+export type WorkerMessage =
+    | {type: 'PROGRESS'; version: string; bytes: number}
+    | {type: 'INSTALLED'; version: string}
+    | {type: 'FAILED'; version: string; reason: string}
+
+/** The part of a Request the worker reads. */
+export type WorkerRequest = {url: string; method: string; mode: string}
+
+/** What the worker runs in: a ServiceWorkerGlobalScope's, or a test's fake. */
+export type WorkerEnvironment = {
+    /** The worker's script URL, `<scope>sw.js?version=<v>`. */
+    script: string
+    /** The registration's scope, the site's root, absolute, with its final slash. */
+    scope: string
+    caches: CacheStorageLike
+    fetch(request: string | WorkerRequest, init?: RequestInit): Promise<Response>
+    clients: {
+        matchAll(options: {type: 'window'; includeUncontrolled: boolean}): Promise<readonly {postMessage(message: WorkerMessage): void}[]>
+        claim(): Promise<void>
+    }
+    skipWaiting(): Promise<void>
+}
+
+/** The worker's handlers, each the work of one event, for the event to wait for. */
+export type ServiceWorkerHandlers = {
+    install(): Promise<void>
+    activate(): Promise<void>
+    /** The answer to a request, or null for one the worker leaves to the browser. */
+    respond(request: WorkerRequest): Promise<Response> | null
+    /** The work of a message from a page, replying through reply, or null for one not the worker's. */
+    message(data: unknown, reply: (message: WorkerMessage) => void): Promise<void> | null
+}
+
+/** How many files an install fetches at once. */
+const width = 4
+
+function messageOf(error: unknown): string {
+    return error instanceof Error ? error.message : String(error)
+}
+
+async function sha256(data: ArrayBuffer): Promise<string> {
+    const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', data))
+    return Array.from(digest, byte => byte.toString(16).padStart(2, '0')).join('')
+}
+
+/**
+ * Runs task on every item, width at a time, and throws the first failure once all have run.
+ * Tip: every file that can be cached is, so that a second try fetches only what failed.
+ */
+async function each<T>(items: readonly T[], task: (item: T) => Promise<void>): Promise<void> {
+    let next = 0
+    const failures: unknown[] = []
+    const lane = async () => {
+        while (next < items.length) {
+            const item = items[next]
+            next += 1
+            try {
+                await task(item)
+            } catch (error) {
+                failures.push(error)
+            }
+        }
+    }
+    await Promise.all(Array.from({length: Math.min(width, items.length)}, lane))
+    if (failures.length > 0) {
+        throw failures[0]
+    }
+}
+
+export function serviceWorker(env: WorkerEnvironment): ServiceWorkerHandlers {
+    const version = versionOf(env.script) ?? ''
+    const own = cacheName(env.scope, version)
+    const origin = new URL(env.scope).origin
+    const list = listUrl(env.scope)
+    /** The URLs the own cache serves once complete, null before; read once, again after a change. */
+    let served: Promise<Set<string> | null> | null = null
+
+    function installed(): Promise<Set<string> | null> {
+        served ??= (async () => {
+            // has() first: open() would create the cache a reader never asked for.
+            if (!(await env.caches.has(own))) {
+                return null
+            }
+            const files = await installedList(await env.caches.open(own), env.scope)
+            return files && new Set(files.files.map(file => env.scope + file.path))
+        })()
+        return served
+    }
+
+    async function cached(url: string): Promise<Response | undefined> {
+        return (await env.caches.has(own)) ? (await env.caches.open(own)).match(url) : undefined
+    }
+
+    /** The list of this worker's version, from the network, never from a cache. */
+    async function fetchList(): Promise<Precache> {
+        const fetched = await readList(await env.fetch(list, {cache: 'no-store'}))
+        if (!fetched) {
+            throw new Error('precache.json could not be read')
+        }
+        if (fetched.version !== version) {
+            throw new Error(`precache.json is version ${fetched.version}, and this worker's ${version}: the site changed during the installation`)
+        }
+        return fetched
+    }
+
+    /** The file from the network, checked against the list, as the response the cache keeps. */
+    async function fetchFile(file: PrecacheFile): Promise<Response> {
+        const response = await env.fetch(env.scope + file.path, {cache: 'no-cache'})
+        if (!response.ok) {
+            throw new Error(`${file.path}: the server answered ${response.status}`)
+        }
+        const body = await response.arrayBuffer()
+        if (body.byteLength !== file.size || (await sha256(body)) !== file.sha256) {
+            throw new Error(`${file.path} is not what precache.json says: the site changed during the installation`)
+        }
+        // A response of its own, which no redirect marks, so that it may answer a navigation.
+        return new Response(body, {headers: {'content-type': response.headers.get('content-type') ?? 'application/octet-stream'}})
+    }
+
+    /**
+     * Caches every file of the list the own cache lacks, copying a file an earlier version
+     * cached with the same SHA-256 and fetching the others, each reported to progress; then the
+     * list, which makes the cache complete.
+     */
+    async function fill(files: Precache, progress: (bytes: number) => void): Promise<void> {
+        const cache = await env.caches.open(own)
+        const earlier: {cache: CacheLike; list: Precache | null}[] = await Promise.all(
+            (await otherInstalls(env.caches, env.scope, version)).map(async name => {
+                const other = await env.caches.open(name)
+                return {cache: other, list: await installedList(other, env.scope)}
+            }))
+        const missing: PrecacheFile[] = []
+        for (const file of files.files) {
+            const url = env.scope + file.path
+            if (await cache.match(url)) {
+                continue
+            }
+            const same = earlier.find(other => other.list?.files.some(entry => entry.path === file.path && entry.sha256 === file.sha256))
+            const copy = same && await same.cache.match(url)
+            if (copy) {
+                await cache.put(url, copy)
+            } else {
+                missing.push(file)
+            }
+        }
+        await each(missing, async file => {
+            await cache.put(env.scope + file.path, await fetchFile(file))
+            progress(file.size)
+        })
+        await cache.put(list, new Response(JSON.stringify(files), {headers: {'content-type': 'application/json'}}))
+        served = null
+    }
+
+    /** A request the worker answers: from the installed cache first, else the network, else the cache. */
+    async function answer(request: WorkerRequest, address: string): Promise<Response> {
+        if (address === list) {
+            try {
+                return await env.fetch(request)
+            } catch (error) {
+                const kept = await cached(list)
+                if (kept) {
+                    return kept
+                }
+                throw error
+            }
+        }
+        const urls = await installed()
+        const key = address.endsWith('/') ? `${address}index.html` : address
+        if (urls?.has(key)) {
+            const hit = await cached(key)
+            if (hit) {
+                return hit
+            }
+        }
+        try {
+            return await env.fetch(request)
+        } catch (error) {
+            // A page named without its final slash, which the server would have redirected.
+            const page = urls && request.mode === 'navigate' && urls.has(`${address}/index.html`)
+                ? await cached(`${address}/index.html`) : undefined
+            if (page) {
+                return page
+            }
+            throw error
+        }
+    }
+
+    return {
+        async install() {
+            if ((await installed()) !== null) {
+                return
+            }
+            if ((await otherInstalls(env.caches, env.scope, version)).length === 0) {
+                await env.skipWaiting()
+                return
+            }
+            const files = await fetchList()
+            const pages = await env.clients.matchAll({type: 'window', includeUncontrolled: true})
+            await fill(files, bytes => {
+                for (const page of pages) {
+                    page.postMessage({type: 'PROGRESS', version, bytes})
+                }
+            })
+        },
+        async activate() {
+            const prefix = cachePrefix(env.scope)
+            for (const name of await env.caches.keys()) {
+                if (name.startsWith(prefix) && name !== own) {
+                    await env.caches.delete(name)
+                }
+            }
+            served = null
+            await env.clients.claim()
+        },
+        respond(request) {
+            if (request.method !== 'GET') {
+                return null
+            }
+            const url = new URL(request.url)
+            if (url.origin !== origin || !request.url.startsWith(env.scope)) {
+                return null
+            }
+            return answer(request, url.origin + url.pathname)
+        },
+        message(data, reply) {
+            const type = typeof data === 'object' && data !== null ? (data as {type?: unknown}).type : undefined
+            if (type === 'SKIP_WAITING') {
+                return env.skipWaiting()
+            }
+            if (type !== 'INSTALL') {
+                return null
+            }
+            return (async () => {
+                try {
+                    await fill(await fetchList(), bytes => reply({type: 'PROGRESS', version, bytes}))
+                    reply({type: 'INSTALLED', version})
+                } catch (error) {
+                    reply({type: 'FAILED', version, reason: messageOf(error)})
+                }
+            })()
+        },
+    }
+}
+
+/** The events of a ServiceWorkerGlobalScope, as far as the handlers need them. */
+type WorkerEvent = {waitUntil(work: Promise<unknown>): void}
+type WorkerScope = {
+    location: {href: string}
+    registration: {scope: string}
+    caches: CacheStorageLike
+    clients: WorkerEnvironment['clients']
+    fetch(request: unknown, init?: RequestInit): Promise<Response>
+    skipWaiting(): Promise<void>
+    addEventListener(type: 'install' | 'activate', listener: (event: WorkerEvent) => void): void
+    addEventListener(type: 'fetch', listener: (event: WorkerEvent & {request: WorkerRequest; respondWith(response: Promise<Response>): void}) => void): void
+    addEventListener(type: 'message', listener: (event: WorkerEvent & {data: unknown; source: {postMessage(message: WorkerMessage): void} | null}) => void): void
+}
+
+declare const ServiceWorkerGlobalScope: (abstract new () => unknown) | undefined
+
+function listen(scope: WorkerScope): void {
+    const handlers = serviceWorker({
+        script: scope.location.href,
+        scope: scope.registration.scope,
+        caches: scope.caches,
+        fetch: (request, init) => scope.fetch(request, init),
+        clients: scope.clients,
+        skipWaiting: () => scope.skipWaiting(),
+    })
+    scope.addEventListener('install', event => event.waitUntil(handlers.install()))
+    scope.addEventListener('activate', event => event.waitUntil(handlers.activate()))
+    scope.addEventListener('fetch', event => {
+        const response = handlers.respond(event.request)
+        if (response) {
+            event.respondWith(response)
+        }
+    })
+    scope.addEventListener('message', event => {
+        const work = handlers.message(event.data, message => event.source?.postMessage(message))
+        if (work) {
+            event.waitUntil(work)
+        }
+    })
+}
+
+if (typeof ServiceWorkerGlobalScope === 'function' && globalThis instanceof ServiceWorkerGlobalScope) {
+    listen(globalThis as unknown as WorkerScope)
+}
