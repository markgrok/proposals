--- /dev/null
+++ b/src/theme.ts
@@ -0,0 +1,34 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+import chrome from '../assets/chrome.css'
+import theme from '../assets/site.css'
+
+/** The page's background in each theme: the browser's colour around the page, and the app's. */
+export type ThemeColours = {light: string; dark: string}
+
+/** The value of the custom property name in the first `:root` block of css after opening. */
+function token(css: string, opening: string, name: string): string {
+    const text = css.replace(/\/\*[\s\S]*?\*\//g, '')
+    const at = text.indexOf(opening)
+    const block = at < 0 ? undefined : text.slice(at).match(/:root[^{]*\{([^{}]*)\}/)?.[1]
+    const value = block?.match(new RegExp(`${name}\\s*:\\s*([^;]+);`))?.[1]
+    if (value === undefined) {
+        throw new Error(`the theme's ${name} is not in the stylesheet's ${opening} block`)
+    }
+    return value.trim()
+}
+
+/**
+ * The background tokens of the stylesheets, which the server bundles as text (tools/build.mjs):
+ * chrome.css's, light, and site.css's dark theme's, so that no colour is typed twice.
+ */
+export function themeColours(): ThemeColours {
+    return {
+        light: token(chrome, ':root {', '--background'),
+        dark: token(theme, '@media (prefers-color-scheme: dark)', '--background'),
+    }
+}
diff --git a/test/install_test.mjs b/test/install_test.mjs
new file mode 100644
index 0000000..d2abf73
--- /dev/null
+++ b/test/install_test.mjs
@@ -0,0 +1,308 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The install flow as the page runs it (src/install_flow.ts, what InstallPrompt's hook runs):
+// machines/install.json on a SiteApp that runs it on XState, as the wasm does (test/oracle.mjs;
+// test/wasm/install.mjs runs the machine on the wasm itself), with the Cache API, the network and
+// the service worker's container in memory. A first visit asks; Install has the worker cache the
+// site; Not now is remembered for the version, and, with a localStorage that throws, for the
+// page alone; an installed site is ready; a new version updates, then offers a reload.
+
+import assert from 'node:assert/strict'
+import {readFileSync} from 'node:fs'
+import {join} from 'node:path'
+import test from 'node:test'
+import {declinedMemory, formatBytes, installView, runInstall} from '../src/install_flow.ts'
+import {xstateApp} from './oracle.mjs'
+import {FakeCaches, installed, listOf, network, scope} from './pwa.mjs'
+import {site} from './site.mjs'
+
+const config = readFileSync(join(site, 'machines/install.json'), 'utf8')
+
+/** Lets every promise the fakes hold settle: each answers at once, so no timer is involved. */
+async function settled() {
+    for (let i = 0; i < 20; i += 1) {
+        await new Promise(setImmediate)
+    }
+}
+
+/** A ServiceWorker: its script, its state, what it was posted. */
+class FakeWorker extends EventTarget {
+    posted = []
+    constructor(scriptURL, state) {
+        super()
+        this.scriptURL = scriptURL
+        this.state = state
+    }
+    postMessage(message) {
+        this.posted.push(message)
+    }
+    become(state) {
+        this.state = state
+        this.dispatchEvent(new Event('statechange'))
+    }
+}
+
+/** navigator.serviceWorker: one registration, whose workers the test sets, and the messages it emits. */
+class FakeContainer extends EventTarget {
+    controller = null
+    registered = []
+    registration = Object.assign(new EventTarget(), {active: null, waiting: null, installing: null})
+    failing = false
+    async register(url, options) {
+        this.registered.push({url, options})
+        if (this.failing) {
+            throw new DOMException('The operation is insecure.', 'SecurityError')
+        }
+        return this.registration
+    }
+    startMessages() {}
+    /** A message from the service worker to the page. */
+    emit(data) {
+        this.dispatchEvent(new MessageEvent('message', {data}))
+    }
+}
+
+/** A localStorage of the Web Storage API, in memory, or one whose every access throws, as a private window's may. */
+function storage({throws = false} = {}) {
+    const items = new Map()
+    return () => {
+        if (throws) {
+            throw new DOMException('The operation is insecure.', 'SecurityError')
+        }
+        return {getItem: key => items.get(key) ?? null, setItem: (key, value) => items.set(key, String(value))}
+    }
+}
+
+const files = {'index.html': '<h1>webcpp</h1>', 'assets/site.js': 'one()', 'assets/app/site-app.wasm': 'wasm'}
+const list = listOf(files)
+const script = version => `${scope}sw.js?version=${version}`
+
+/** The flow on a page of the site, with what it is given and what it does. */
+function page({caches = new FakeCaches(), net = network(files), container = new FakeContainer(), memory = declinedMemory(storage())} = {}) {
+    const states = []
+    const effects = {persisted: 0, reloaded: 0}
+    const env = {
+        app: Promise.resolve(xstateApp()),
+        config,
+        scope,
+        fetch: net.fetch,
+        caches,
+        serviceWorker: container,
+        declined: memory,
+        async persist() {
+            effects.persisted += 1
+            return true
+        },
+        reload() {
+            effects.reloaded += 1
+        },
+    }
+    const run = runInstall(env, state => states.push(state))
+    return {run, states, effects, container, caches, net, last: () => states.at(-1)}
+}
+
+test('a first visit registers the worker of the list\'s version, then asks, with the size to download', async () => {
+    const visit = page()
+    await settled()
+    assert.deepEqual(visit.container.registered, [{url: script(list.version), options: {scope}}])
+    assert.equal(visit.last().value, 'asking')
+    assert.equal(visit.last().context.missing, list.total)
+    assert.equal(visit.last().context.version, list.version)
+    assert.deepEqual(visit.states.map(state => state.value), ['checking', 'asking'])
+})
+
+test('Install asks the worker of this version to cache the site, counts its progress, and is ready once it has', async () => {
+    const visit = page()
+    const worker = new FakeWorker(script(list.version), 'activated')
+    visit.container.registration.active = worker
+    await settled()
+    visit.run.accept()
+    await settled()
+    assert.equal(visit.last().value, 'installing')
+    assert.deepEqual(worker.posted, [{type: 'INSTALL'}])
+    visit.container.emit({type: 'PROGRESS', version: list.version, bytes: 10})
+    visit.container.emit({type: 'PROGRESS', version: 'another version', bytes: 1000})
+    assert.equal(visit.last().context.done, 10, 'a message of another version is not this page\'s')
+    assert.equal(visit.effects.persisted, 0)
+    visit.container.emit({type: 'INSTALLED', version: list.version})
+    await settled()
+    assert.equal(visit.last().value, 'ready')
+    assert.equal(visit.effects.persisted, 1, 'the browser is asked to keep the cache')
+})
+
+test('Install waits for the worker of this version to take over before asking it', async () => {
+    const visit = page()
+    const old = new FakeWorker(script('an older version'), 'activated')
+    const worker = new FakeWorker(script(list.version), 'installing')
+    Object.assign(visit.container.registration, {active: old, installing: worker})
+    await settled()
+    visit.run.accept()
+    await settled()
+    assert.deepEqual([old.posted, worker.posted], [[], []])
+    worker.become('activated')
+    await settled()
+    assert.deepEqual(worker.posted, [{type: 'INSTALL'}])
+})
+
+test('a failed install asks again with its reason, and a worker that never takes over is a failure too', async () => {
+    const visit = page()
+    const worker = new FakeWorker(script(list.version), 'installing')
+    visit.container.registration.installing = worker
+    await settled()
+    visit.run.accept()
+    worker.become('redundant')
+    await settled()
+    assert.equal(visit.last().value, 'asking')
+    assert.match(visit.last().context.reason, /service worker/)
+    visit.container.registration.active = new FakeWorker(script(list.version), 'activated')
+    visit.run.accept()
+    await settled()
+    visit.container.emit({type: 'FAILED', version: list.version, reason: 'assets/site.js is not what the list says'})
+    assert.equal(visit.last().value, 'asking')
+    assert.equal(visit.last().context.reason, 'assets/site.js is not what the list says')
+})
+
+test('Not now is remembered for this version: the next page does not ask, and a new version does', async () => {
+    const memory = storage()
+    const first = page({memory: declinedMemory(memory)})
+    await settled()
+    first.run.decline()
+    assert.equal(first.last().value, 'declined')
+    first.run.stop()
+
+    const next = page({memory: declinedMemory(memory)})
+    await settled()
+    assert.equal(next.last().value, 'declined')
+
+    const changed = {...files, 'assets/site.js': 'two()'}
+    const later = page({memory: declinedMemory(memory), net: network(changed)})
+    await settled()
+    assert.equal(later.last().value, 'asking')
+})
+
+test('with a localStorage that throws, Not now holds for the page, never throws, and the next load asks again', async () => {
+    const memory = storage({throws: true})
+    const thisLoad = declinedMemory(memory)
+    const first = page({memory: thisLoad})
+    await settled()
+    first.run.decline()
+    assert.equal(first.last().value, 'declined')
+    first.run.stop()
+
+    const again = page({memory: thisLoad})
+    await settled()
+    assert.equal(again.last().value, 'declined', 'the same load remembers it')
+
+    const nextLoad = page({memory: declinedMemory(memory)})
+    await settled()
+    assert.equal(nextLoad.last().value, 'asking')
+})
+
+test('a site installed at the list\'s version is ready, and asks nothing', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, files)
+    const container = new FakeContainer()
+    container.controller = new FakeWorker(script(list.version), 'activated')
+    const visit = page({caches, container})
+    await settled()
+    assert.deepEqual(visit.states.map(state => state.value), ['checking', 'ready'])
+    assert.equal(visit.last().context.reload, false)
+})
+
+test('a new version updates in the background, then offers a reload, which the waiting worker takes over for', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, files)
+    const changed = {...files, 'assets/site.js': 'two()'}
+    const next = listOf(changed)
+    const container = new FakeContainer()
+    container.controller = new FakeWorker(script(list.version), 'activated')
+    container.registration.active = container.controller
+    const worker = new FakeWorker(script(next.version), 'installing')
+    container.registration.installing = worker
+    const visit = page({caches, container, net: network(changed)})
+    await settled()
+    assert.deepEqual(visit.states.map(state => state.value), ['checking', 'ready', 'updating'])
+    worker.become('installed')
+    container.registration.installing = null
+    container.registration.waiting = worker
+    await settled()
+    assert.equal(visit.last().value, 'ready')
+    assert.equal(visit.last().context.reload, true)
+    visit.run.reload()
+    assert.deepEqual(worker.posted, [{type: 'SKIP_WAITING'}])
+    assert.equal(visit.effects.reloaded, 0, 'not before the new worker controls the page')
+    container.dispatchEvent(new Event('controllerchange'))
+    assert.equal(visit.effects.reloaded, 1)
+})
+
+test('a page served by the old version while the new one already waits offers the reload at once', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, files)
+    const changed = {...files, 'assets/site.js': 'two()'}
+    const next = listOf(changed)
+    await installed(caches, changed)
+    const container = new FakeContainer()
+    container.controller = new FakeWorker(script(list.version), 'activated')
+    container.registration.waiting = new FakeWorker(script(next.version), 'installed')
+    const visit = page({caches, container, net: network(changed)})
+    await settled()
+    assert.deepEqual(visit.states.map(state => state.value), ['checking', 'ready', 'updating', 'ready'])
+    assert.equal(visit.last().context.reload, true)
+})
+
+test('a browser without a service worker or the Cache API, one that refuses the worker, or a site without precache.json never asks', async () => {
+    const refusing = new FakeContainer()
+    refusing.failing = true
+    const pages = [
+        page({container: refusing}),
+        page({net: {fetch: async () => new Response('Not found', {status: 404})}}),
+        page({net: {fetch: async () => { throw new TypeError('Failed to fetch') }}}),
+    ]
+    const without = runInstall({app: Promise.resolve(xstateApp()), config, scope, fetch: network(files).fetch,
+        declined: declinedMemory(storage()), persist: async () => true, reload() {}}, () => {})
+    await settled()
+    for (const visit of pages) {
+        assert.deepEqual(visit.states.map(state => state.value), ['checking'])
+    }
+    without.accept()
+    without.stop()
+})
+
+test('stop deletes the machine and leaves the page\'s messages alone', async () => {
+    const visit = page()
+    await settled()
+    visit.run.stop()
+    const count = visit.states.length
+    visit.container.emit({type: 'PROGRESS', version: list.version, bytes: 1})
+    visit.run.accept()
+    assert.equal(visit.states.length, count)
+})
+
+test('installView: what the prompt shows for each state, and the offers once the site is ready', () => {
+    const snapshot = (value, context = {}) => ({value, context: {version: 'v', missing: 6_200_000, done: 0, reason: '', reload: false, ...context}, status: 'active'})
+    const none = {prompt: false, ios: false}
+    assert.equal(installView(null, none), null)
+    assert.equal(installView({error: 'no wasm'}, none), null)
+    assert.equal(installView(snapshot('checking'), none), null)
+    assert.equal(installView(snapshot('declined'), none), null)
+    assert.equal(installView(snapshot('updating'), none), null)
+    assert.deepEqual(installView(snapshot('asking', {reason: 'offline'}), none), {kind: 'asking', bytes: 6_200_000, reason: 'offline'})
+    assert.deepEqual(installView(snapshot('installing', {done: 1_000_000}), none), {kind: 'installing', done: 1_000_000, bytes: 6_200_000})
+    assert.deepEqual(installView(snapshot('ready', {reload: true}), {prompt: true, ios: false}), {kind: 'reload'})
+    assert.deepEqual(installView(snapshot('ready', {done: 6_200_000}), none), {kind: 'installed', app: null})
+    assert.deepEqual(installView(snapshot('ready', {done: 6_200_000}), {prompt: true, ios: false}), {kind: 'installed', app: 'prompt'})
+    assert.equal(installView(snapshot('ready'), none), null)
+    assert.deepEqual(installView(snapshot('ready'), {prompt: true, ios: false}), {kind: 'app', app: 'prompt'})
+    assert.deepEqual(installView(snapshot('ready'), {prompt: false, ios: true}), {kind: 'app', app: 'ios'})
+})
+
+test('formatBytes writes a size as a reader reads it', () => {
+    assert.equal(formatBytes(512), '512 bytes')
+    assert.equal(formatBytes(41_234), '41 kB')
+    assert.equal(formatBytes(6_212_345), '6.2 MB')
+    assert.equal(formatBytes(12_500_000), '12.5 MB')
+})
diff --git a/test/manifest_test.mjs b/test/manifest_test.mjs
new file mode 100644
index 0000000..22885df
--- /dev/null
+++ b/test/manifest_test.mjs
@@ -0,0 +1,81 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The PWA's files the build's --render step lays out at the site's root: manifest.webmanifest,
+// valid, its icons there at the sizes it says and its colours the theme's tokens; sw.js, the
+// service worker, a classic script; and every page's link to the manifest and its theme colours.
+
+import assert from 'node:assert/strict'
+import {existsSync, readFileSync} from 'node:fs'
+import {join} from 'node:path'
+import test from 'node:test'
+import {appSizes} from '../tools/icons.mjs'
+import {pageAt, pages, renderSite, site} from './site.mjs'
+
+const out = renderSite()
+
+/** The custom properties `css` sets on `:root` in the block that `opening` starts. */
+function tokens(css, opening) {
+    const text = css.replace(/\/\*[\s\S]*?\*\//g, '')
+    const block = text.slice(text.indexOf(opening)).match(/:root[^{]*\{([^{}]*)\}/)[1]
+    return Object.fromEntries([...block.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)].map(([, name, value]) => [name, value.trim()]))
+}
+
+const light = tokens(readFileSync(join(site, 'assets/chrome.css'), 'utf8'), ':root {')
+const dark = tokens(readFileSync(join(site, 'assets/site.css'), 'utf8'), '@media (prefers-color-scheme: dark)')
+
+/** A PNG's width and height, from its IHDR chunk. */
+function size(file) {
+    const png = readFileSync(file)
+    assert.equal(png.toString('latin1', 1, 4), 'PNG', file)
+    return [png.readUInt32BE(16), png.readUInt32BE(20)]
+}
+
+test('manifest.webmanifest is at the site\'s root, a standalone app whose start and scope are the root', () => {
+    const manifest = JSON.parse(readFileSync(join(out, 'manifest.webmanifest'), 'utf8'))
+    assert.equal(manifest.name, 'webcpp')
+    assert.equal(manifest.short_name, 'webcpp')
+    assert.equal(manifest.id, './')
+    assert.equal(manifest.start_url, './')
+    assert.equal(manifest.scope, './')
+    assert.equal(manifest.display, 'standalone')
+    assert.equal(manifest.lang, 'en')
+    assert.ok(!existsSync(join(out, 'assets/manifest.webmanifest')), 'only the root\'s, whose ./ is the site')
+})
+
+test("the manifest's colours are the theme's tokens, light, as a manifest has one of each", () => {
+    const manifest = JSON.parse(readFileSync(join(out, 'manifest.webmanifest'), 'utf8'))
+    assert.equal(manifest.theme_color, light['--background'])
+    assert.equal(manifest.background_color, light['--background'])
+})
+
+test('the manifest names each app icon for any use and as maskable, each there at the size it says', () => {
+    const manifest = JSON.parse(readFileSync(join(out, 'manifest.webmanifest'), 'utf8'))
+    assert.deepEqual(manifest.icons.map(icon => `${icon.sizes} ${icon.purpose}`).sort(),
+        appSizes.flatMap(side => [`${side}x${side} any`, `${side}x${side} maskable`]).sort())
+    for (const icon of manifest.icons) {
+        assert.equal(icon.type, 'image/png')
+        const [width, height] = icon.sizes.split('x').map(Number)
+        assert.deepEqual(size(join(out, icon.src)), [width, height], icon.src)
+    }
+})
+
+test('sw.js is at the site\'s root, a classic script that imports nothing', () => {
+    const worker = readFileSync(join(out, 'sw.js'), 'utf8')
+    assert.doesNotMatch(worker, /^\s*(import|export)\b/m)
+    assert.match(worker, /addEventListener\("fetch"/)
+    assert.doesNotMatch(worker, /https?:\/\//, 'it names no host: the site it serves is its own scope')
+})
+
+test('every page links the manifest from its root and gives the theme colour of each scheme', () => {
+    for (const {path} of pages) {
+        const html = pageAt(out, path)
+        const root = '../'.repeat(path.split('/').filter(Boolean).length)
+        assert.ok(html.includes(`<link rel="manifest" href="${root}manifest.webmanifest">`), path || 'the home')
+        assert.ok(html.includes(`<meta name="theme-color" content="${light['--background']}" media="(prefers-color-scheme: light)">`), path)
+        assert.ok(html.includes(`<meta name="theme-color" content="${dark['--background']}" media="(prefers-color-scheme: dark)">`), path)
+    }
+})
diff --git a/test/oracle.mjs b/test/oracle.mjs
new file mode 100644
index 0000000..89fad92
--- /dev/null
+++ b/test/oracle.mjs
@@ -0,0 +1,77 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// XState 5.33.2 as the oracle of the site's machines: the implementations app/site_app.cpp gives
+// each name a machine of machines/ uses, written for XState, and a SiteApp whose MachineHost runs
+// a machine on XState's actor and answers as app/bindings.cpp does, so that a test of what runs a
+// machine needs no wasm.
+
+import {assign, createActor, createMachine} from 'xstate'
+
+/** app/site_app.cpp's site_implementations(), for XState. */
+export const implementations = {
+    actions: {
+        resetPlayed: assign({played: 0}),
+        countPlayed: assign({played: ({context}) => context.played + 1}),
+        setSpeed: assign({speed: ({event}) => event.speed}),
+        setMissing: assign({missing: ({event}) => event.bytes, version: ({event}) => event.version}),
+        startInstall: assign({done: 0, reason: ''}),
+        addDone: assign({done: ({context, event}) => context.done + event.bytes}),
+        setReason: assign({reason: ({event}) => event.reason}),
+        offerReload: assign({reload: true}),
+    },
+    guards: {
+        isSpeed: ({event}) => [0.5, 1, 2].includes(event.speed),
+        wasDeclined: ({event}) => typeof event.declined === 'string' && event.declined === event.version,
+    },
+}
+
+/** XState's actor on the machine of the JSON config, started. */
+export function oracle(config) {
+    return createActor(createMachine(JSON.parse(config), implementations)).start()
+}
+
+/** An actor's snapshot as machine_host writes it. */
+export function snapshotOf(actor) {
+    const {value, context, status} = actor.getSnapshot()
+    return {value, context, status}
+}
+
+/**
+ * A SiteApp whose MachineHost runs XState's actor: create throws an Error for a config that is not
+ * JSON, and send answers an event without a string type with {"error": why}, as the wasm does.
+ */
+export function xstateApp() {
+    return {
+        MachineHost: {
+            create(config) {
+                let actor
+                try {
+                    actor = oracle(config)
+                } catch (error) {
+                    throw new Error(`MachineHost.create refused the config: ${error.message}`)
+                }
+                let deleted = false
+                return {
+                    send(event) {
+                        const read = JSON.parse(event)
+                        if (typeof read.type !== 'string') {
+                            return JSON.stringify({error: 'MachineHost.send refused the event: invalid_event'})
+                        }
+                        actor.send(read)
+                        return JSON.stringify(snapshotOf(actor))
+                    },
+                    snapshot: () => JSON.stringify(snapshotOf(actor)),
+                    delete() {
+                        actor.stop()
+                        deleted = true
+                    },
+                    isDeleted: () => deleted,
+                }
+            },
+        },
+    }
+}
