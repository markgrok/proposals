index 0000000..860c5f1
--- /dev/null
+++ b/test/sw_test.mjs
@@ -0,0 +1,216 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The service worker's handlers (src/sw.ts) against a fake CacheStorage and a fake network: a
+// precached file served from the cache, a navigation offline, the install of a new version that
+// fetches only what changed, the install the page asks for, what activate removes, and a request
+// to another origin, which is never cached.
+
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {cacheName, serviceWorker} from '../src/sw.ts'
+import {FakeCaches, installed, listOf, network, scope} from './pwa.mjs'
+
+/** The worker of version `version`, with the caches and the network given, and what it posts and calls. */
+function worker(version, caches, net) {
+    const posted = []
+    const calls = []
+    const env = {
+        script: `${scope}sw.js?version=${version}`,
+        scope,
+        caches,
+        fetch: net.fetch,
+        clients: {
+            async matchAll() {
+                return [{postMessage: message => posted.push(message)}]
+            },
+            async claim() {
+                calls.push('claim')
+            },
+        },
+        async skipWaiting() {
+            calls.push('skipWaiting')
+        },
+    }
+    return {sw: serviceWorker(env), posted, calls}
+}
+
+const get = (url, mode = 'no-cors') => ({url, method: 'GET', mode})
+const text = async response => (await response).text()
+
+const v1 = {
+    'index.html': '<h1>webcpp</h1>',
+    'libraries/index.html': '<h1>Libraries</h1>',
+    'assets/site.js': 'one()',
+    'assets/old.js': 'gone()',
+}
+
+test('a precached file is served from the cache, without a fetch', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const net = network({...v1, 'assets/site.js': 'newer()'})
+    const {sw} = worker(listOf(v1).version, caches, net)
+    assert.equal(await text(sw.respond(get(`${scope}assets/site.js`))), 'one()')
+    assert.equal(await text(sw.respond(get(scope, 'navigate'))), '<h1>webcpp</h1>', 'the home is its index.html')
+    assert.equal(await text(sw.respond(get(`${scope}libraries/?q=x`, 'navigate'))), '<h1>Libraries</h1>', 'whatever its query')
+    assert.deepEqual(net.requested, [])
+})
+
+test('a navigation with the network failing gets the cached page; one the cache does not hold fails as the network did', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const net = network(v1)
+    net.offline = true
+    const {sw} = worker(listOf(v1).version, caches, net)
+    assert.equal(await text(sw.respond(get(`${scope}libraries/`, 'navigate'))), '<h1>Libraries</h1>')
+    assert.equal(await text(sw.respond(get(`${scope}libraries`, 'navigate'))), '<h1>Libraries</h1>',
+        'a page named without its final slash, which the server would redirect')
+    await assert.rejects(sw.respond(get(`${scope}nowhere/`, 'navigate')), TypeError)
+})
+
+test('a same-origin GET the list does not name goes to the network, and is never cached', async () => {
+    const caches = new FakeCaches()
+    const cache = await installed(caches, v1)
+    const net = network({...v1, 'report/data.json': '{}'})
+    const {sw} = worker(listOf(v1).version, caches, net)
+    const keys = (await cache.keys()).length
+    assert.equal(await text(sw.respond(get(`${scope}report/data.json`))), '{}')
+    assert.deepEqual(net.requested, [`${scope}report/data.json`])
+    assert.equal((await cache.keys()).length, keys)
+    assert.deepEqual(await caches.keys(), [cacheName(scope, listOf(v1).version)])
+})
+
+test('precache.json comes from the network first, and from the installed list when the network fails', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const v2 = {...v1, 'assets/site.js': 'two()'}
+    const net = network(v2)
+    const {sw} = worker(listOf(v1).version, caches, net)
+    assert.equal(JSON.parse(await text(sw.respond(get(`${scope}precache.json`)))).version, listOf(v2).version)
+    net.offline = true
+    assert.equal(JSON.parse(await text(sw.respond(get(`${scope}precache.json`)))).version, listOf(v1).version)
+})
+
+test('before the site is installed, every request goes to the network', async () => {
+    const caches = new FakeCaches()
+    const net = network(v1)
+    const {sw} = worker(listOf(v1).version, caches, net)
+    assert.equal(await text(sw.respond(get(`${scope}assets/site.js`))), 'one()')
+    assert.equal(await text(sw.respond(get(scope, 'navigate'))), 'Not found', 'the network\'s answer, whatever it is')
+    assert.deepEqual(net.requested, [`${scope}assets/site.js`, scope])
+    assert.deepEqual(await caches.keys(), [], 'answering opens no cache')
+})
+
+test('a request to another origin, or not a GET, is never answered, so never cached', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const net = network(v1)
+    const {sw} = worker(listOf(v1).version, caches, net)
+    assert.equal(sw.respond(get('https://www.google.com/cse.js')), null)
+    assert.equal(sw.respond(get('https://webcpporg.github.io.evil.example/assets/site.js')), null)
+    assert.equal(sw.respond({url: `${scope}assets/site.js`, method: 'POST', mode: 'cors'}), null)
+    assert.deepEqual(net.requested, [])
+})
+
+test('install for a new version fetches only the files whose sha256 differs from the cached list, then waits', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const v2 = {'index.html': '<h1>webcpp</h1>', 'libraries/index.html': '<h1>Libraries, more</h1>',
+        'assets/site.js': 'one()', 'assets/new.js': 'added()'}
+    const net = network(v2)
+    const {sw, posted, calls} = worker(listOf(v2).version, caches, net)
+    await sw.install()
+    assert.deepEqual(net.requested.sort(), [`${scope}assets/new.js`, `${scope}libraries/index.html`, `${scope}precache.json`])
+    const cache = await caches.open(cacheName(scope, listOf(v2).version))
+    for (const [path, content] of Object.entries(v2)) {
+        assert.equal(await text(cache.match(scope + path)), content, path)
+    }
+    assert.deepEqual(JSON.parse(await text(cache.match(`${scope}precache.json`))), listOf(v2))
+    assert.deepEqual(posted.filter(message => message.type === 'PROGRESS').map(message => message.bytes).sort(),
+        [Buffer.byteLength('added()'), Buffer.byteLength('<h1>Libraries, more</h1>')].sort())
+    assert.ok(posted.every(message => message.version === listOf(v2).version))
+    assert.deepEqual(calls, [], 'the new version waits for the reader\'s reload, the old one serving the open pages')
+})
+
+test('activate removes the caches of the versions no longer listed, keeps another scope\'s, and claims the pages', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const v2 = {...v1, 'assets/site.js': 'two()'}
+    await installed(caches, v2)
+    await caches.open('webcpp https://webcpporg.github.io/webcpp/ 0123')
+    await caches.open('another site\'s cache')
+    const {sw, calls} = worker(listOf(v2).version, caches, network(v2))
+    await sw.activate()
+    assert.deepEqual((await caches.keys()).sort(), [
+        'another site\'s cache', 'webcpp https://webcpporg.github.io/webcpp/ 0123', cacheName(scope, listOf(v2).version),
+    ].sort())
+    assert.deepEqual(calls, ['claim'])
+})
+
+test('install with nothing installed caches nothing, fetches nothing, and takes over at once', async () => {
+    const caches = new FakeCaches()
+    const net = network(v1)
+    const {sw, calls} = worker(listOf(v1).version, caches, net)
+    await sw.install()
+    assert.deepEqual(net.requested, [])
+    assert.deepEqual(await caches.keys(), [])
+    assert.deepEqual(calls, ['skipWaiting'])
+})
+
+test('a list of another version than the worker\'s fails the install of an update, naming both', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const net = network({...v1, 'assets/site.js': 'three()'})
+    const {sw} = worker('0'.repeat(64), caches, net)
+    await assert.rejects(sw.install(), error => error.message.includes('0'.repeat(64)))
+})
+
+test('INSTALL from the page caches every missing file, replying PROGRESS for each, then INSTALLED', async () => {
+    const caches = new FakeCaches()
+    const net = network(v1)
+    const version = listOf(v1).version
+    const {sw} = worker(version, caches, net)
+    const replies = []
+    await sw.message({type: 'INSTALL'}, reply => replies.push(reply))
+    assert.deepEqual(replies.at(-1), {type: 'INSTALLED', version})
+    const progress = replies.filter(reply => reply.type === 'PROGRESS')
+    assert.equal(progress.reduce((sum, reply) => sum + reply.bytes, 0), listOf(v1).total)
+    assert.equal(await text(sw.respond(get(`${scope}assets/old.js`))), 'gone()', 'served from the cache now')
+    assert.equal(net.requested.filter(url => url.endsWith('old.js')).length, 1)
+})
+
+test('INSTALL keeps what an earlier try cached, and fails with the reason when a file is not what the list says', async () => {
+    const caches = new FakeCaches()
+    const list = listOf(v1)
+    const net = network({...v1, 'assets/old.js': 'tampered()'}, list)
+    const {sw} = worker(list.version, caches, net)
+    const replies = []
+    await sw.message({type: 'INSTALL'}, reply => replies.push(reply))
+    const failed = replies.at(-1)
+    assert.equal(failed.type, 'FAILED')
+    assert.match(failed.reason, /assets\/old\.js/)
+    const cache = await caches.open(cacheName(scope, list.version))
+    assert.equal(await cache.match(`${scope}precache.json`), undefined, 'the list is stored last, once every file is')
+    assert.equal(await cache.match(`${scope}assets/old.js`), undefined)
+    await sw.respond(get(`${scope}index.html`))
+    assert.equal(net.requested.at(-1), `${scope}index.html`, 'an install not finished serves nothing from its cache')
+
+    const fixed = network(v1, list)
+    const again = worker(list.version, caches, fixed)
+    const second = []
+    await again.sw.message({type: 'INSTALL'}, reply => second.push(reply))
+    assert.deepEqual(second.at(-1), {type: 'INSTALLED', version: list.version})
+    assert.deepEqual(fixed.requested.sort(), [`${scope}assets/old.js`, `${scope}precache.json`],
+        'only the file the first try could not cache')
+})
+
+test('SKIP_WAITING from the page makes the waiting version take over; any other message is not the worker\'s', async () => {
+    const {sw, calls} = worker(listOf(v1).version, new FakeCaches(), network(v1))
+    await sw.message({type: 'SKIP_WAITING'}, () => {})
+    assert.deepEqual(calls, ['skipWaiting'])
+    assert.equal(sw.message({type: 'HELLO'}, () => {}), null)
+    assert.equal(sw.message('INSTALL', () => {}), null)
+})
diff --git a/test/wasm/install.mjs b/test/wasm/install.mjs
new file mode 100644
index 0000000..8c3e099
--- /dev/null
+++ b/test/wasm/install.mjs
@@ -0,0 +1,86 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The install flow's machine, machines/install.json, in the site's wasm (build/app/site-app.mjs)
+// and on XState 5.33.2 as its oracle (test/oracle.mjs): every transition of the flow, the two
+// agreeing on the value, the context and the status at each step.
+
+import assert from 'node:assert/strict'
+import {existsSync, readFileSync} from 'node:fs'
+import {join} from 'node:path'
+import test from 'node:test'
+import {pathToFileURL} from 'node:url'
+import {loadSiteApp} from '../../src/machine.ts'
+import {oracle, snapshotOf} from '../oracle.mjs'
+import {site} from '../site.mjs'
+
+const module = join(site, 'build/app/site-app.mjs')
+const config = readFileSync(join(site, 'machines/install.json'), 'utf8')
+
+/** The site's wasm, or a failure that says how to build it. */
+async function siteApp() {
+    assert.ok(existsSync(module), `${module} is missing: build it at the superproject's root with ` +
+        'b2 /webcpp/site/app//wasm (b2 /webcpp/site//test and b2 site build it first)')
+    return loadSiteApp(pathToFileURL(module).href)
+}
+
+/** Plays the events on the wasm and on XState, asserting that they agree at each step; returns the wasm's values. */
+function play(app, events) {
+    const host = app.MachineHost.create(config)
+    const actor = oracle(config)
+    try {
+        const agree = (snapshot, step) => assert.deepEqual(snapshot, snapshotOf(actor), `after ${step}`)
+        const first = JSON.parse(host.snapshot())
+        agree(first, 'the start')
+        const snapshots = [first]
+        for (const event of events) {
+            const snapshot = JSON.parse(host.send(JSON.stringify(event)))
+            actor.send(event)
+            agree(snapshot, JSON.stringify(event))
+            snapshots.push(snapshot)
+        }
+        return snapshots
+    } finally {
+        host.delete()
+        actor.stop()
+    }
+}
+
+const missing = {type: 'MISSING', bytes: 6_200_000, version: 'v2', declined: null}
+
+test('the install flow runs in the wasm as it runs in XState: asked, installed, updated', async () => {
+    const app = await siteApp()
+    const values = play(app, [
+        missing, {type: 'ACCEPT'}, {type: 'PROGRESS', bytes: 4_000_000}, {type: 'PROGRESS', bytes: 2_200_000},
+        {type: 'INSTALLED'}, {type: 'NEW_VERSION'}, {type: 'UPDATED'},
+    ])
+    assert.deepEqual(values.map(snapshot => snapshot.value),
+        ['checking', 'asking', 'installing', 'installing', 'installing', 'ready', 'updating', 'ready'])
