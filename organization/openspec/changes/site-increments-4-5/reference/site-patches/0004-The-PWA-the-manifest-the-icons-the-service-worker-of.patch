+        },
+        "installing": {
+            "on": {
+                "PROGRESS": {"actions": "addDone"},
+                "INSTALLED": {"target": "ready"},
+                "FAILED": {"target": "asking", "actions": "setReason"}
+            }
+        },
+        "ready": {
+            "on": {
+                "NEW_VERSION": {"target": "updating"}
+            }
+        },
+        "updating": {
+            "on": {
+                "UPDATED": {"target": "ready", "actions": "offerReload"}
+            }
+        },
+        "declined": {}
+    }
+}
