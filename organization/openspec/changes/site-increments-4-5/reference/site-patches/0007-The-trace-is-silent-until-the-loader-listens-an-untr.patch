 # trace (include/webcpp_site/trace.hpp), through the import trace.cpp defines.
diff --git a/app/test/trace_enabled_test.cpp b/app/test/trace_enabled_test.cpp
new file mode 100644
index 0000000..59a9d1d
--- /dev/null
+++ b/app/test/trace_enabled_test.cpp
@@ -0,0 +1,126 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ Tests WEBCPP_SITE_TRACE_SCOPE as the site's build compiles it, natively, with
+ the import webcpp_site_trace defined here to record its calls: while nothing
+ listens, a scope calls no import and builds no argument; once the loader
+ listens, it sends cpp_enter with its name, file, line and arguments, and
+ cpp_exit, even when the listening stops in between.
+*/
+
+#include <webcpp_site/trace.hpp>
+
+#include <boost/core/lightweight_test.hpp>
+#include <boost/json/value.hpp>
+#include <boost/json/value_from.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <string_view>
+
+#ifndef WEBCPP_SITE_TRACE
+#error "trace_enabled_test checks the trace as the site's build compiles it, with WEBCPP_SITE_TRACE"
+#endif
+
+namespace {
+
+/** One call of the import; args holds the first bytes of its args_json. */
+struct trace_call {
+    int kind{};
+    std::string_view name;
+    std::string_view file;
+    int line{};
+    std::array<char, 32> args{};
+    std::size_t args_size{};
+
+    [[nodiscard]] std::string_view args_json() const { return {args.data(), args_size}; }
+};
+
+/**
+ The import's calls: the first ones, and how many there were.
+ Tip: fixed buffers, since a container grown in the import is a throw clang-tidy finds reaching
+ main through the scope; and at namespace scope, since the import is a C function.
+*/
+struct recorder {
+    std::array<trace_call, 4> calls{};
+    std::size_t count{};
+};
+
+recorder recorded;  // NOLINT(cppcoreguidelines-avoid-non-const-global-variables)
+
+/** An argument that counts in builds each time the trace converts it to JSON. */
+struct counted {
+    int* builds;
+};
+
+void tag_invoke(boost::json::value_from_tag /*tag*/, boost::json::value& json,
+                const counted& value) {
+    ++*value.builds;
+    json = *value.builds;
+}
+
+/** A scope with one counted argument, at the line it returns. */
+int traced(int& builds) {
+    WEBCPP_SITE_TRACE_SCOPE("traced", counted{&builds}, "two");
+    return __LINE__ - 1;
+}
+
+}  // namespace
+
+extern "C" void webcpp_site_trace(int kind, const char* name, const char* file, int line,
+                                  const char* args_json) {
+    if (recorded.count < recorded.calls.size()) {
+        trace_call& call = recorded.calls[recorded.count];
+        const std::string_view args(args_json);
+        call.kind = kind;
+        call.name = name;
+        call.file = file;
+        call.line = line;
+        call.args_size = std::min(args.size(), call.args.size());
+        std::copy_n(args.begin(), call.args_size, call.args.begin());
+    }
+    ++recorded.count;
+}
+
+int main() {
+    int builds = 0;
+    traced(builds);
+    BOOST_TEST_EQ(recorded.count, 0U);
+    BOOST_TEST_EQ(builds, 0);
+
+    webcpp_site::detail::trace_listening = true;
+    const int line = traced(builds);
+    BOOST_TEST_EQ(builds, 1);
+    BOOST_TEST_EQ(recorded.count, 2U);
+    const trace_call& enter = recorded.calls[0];
+    BOOST_TEST_EQ(enter.kind, webcpp_site::detail::trace_enter);
+    BOOST_TEST_EQ(enter.name, "traced");
+    BOOST_TEST_EQ(enter.file, "trace_enabled_test.cpp");
+    BOOST_TEST_EQ(enter.line, line);
+    BOOST_TEST_EQ(enter.args_json(), R"([1,"two"])");
+    const trace_call& exit = recorded.calls[1];
+    BOOST_TEST_EQ(exit.kind, webcpp_site::detail::trace_exit);
+    BOOST_TEST_EQ(exit.name, "traced");
+
+    recorded = recorder{};
+    {
+        WEBCPP_SITE_TRACE_SCOPE("balanced");
+        webcpp_site::detail::trace_listening = false;
+    }
+    BOOST_TEST_EQ(recorded.count, 2U);
+    BOOST_TEST_EQ(recorded.calls[1].kind, webcpp_site::detail::trace_exit);
+
+    recorded = recorder{};
+    {
+        WEBCPP_SITE_TRACE_SCOPE("unheard");
+        webcpp_site::detail::trace_listening = true;
+    }
+    BOOST_TEST_EQ(recorded.count, 0U);
+    webcpp_site::detail::trace_listening = false;
+    return boost::report_errors();
+}
