+/** A page of an installed site whose new version's worker is installing. */
+async function updating() {
+    const caches = new FakeCaches()
+    await installed(caches, files)
+    const changed = {...files, 'assets/site.js': 'two()'}
+    const next = listOf(changed)
+    const container = new FakeContainer()
+    container.controller = new FakeWorker(script(list.version), 'activated')
+    container.registration.active = container.controller
+    const worker = new FakeWorker(script(next.version), 'installing')
+    container.registration.installing = worker
+    const visit = page({caches, container, net: network(changed)})
+    await settled()
+    assert.equal(visit.last().value, 'updating')
+    return {visit, worker, next}
+}
+
+test('a failed update goes back to ready with the worker\'s reason, which the page shows, and offers no reload', async () => {
+    const {visit, worker, next} = await updating()
+    visit.container.emit({type: 'UPDATE_FAILED', version: 'another version', reason: 'not this page\'s'})
+    assert.equal(visit.last().value, 'updating')
+    visit.container.emit({type: 'UPDATE_FAILED', version: next.version, reason: 'assets/site.js is not what precache.json says'})
+    worker.become('redundant')
+    await settled()
+    assert.deepEqual(visit.states.map(state => state.value), ['checking', 'ready', 'updating', 'ready'])
+    assert.equal(visit.last().context.updateError, 'assets/site.js is not what precache.json says')
+    assert.equal(visit.last().context.reload, false)
+    assert.deepEqual(installView(visit.last(), {prompt: false, ios: false}),
+        {kind: 'update-failed', reason: 'assets/site.js is not what precache.json says'})
+})
+
+test('a new worker that stops without saying why is a failed update too', async () => {
+    const {visit, worker} = await updating()
+    worker.become('redundant')
+    await settled()
+    assert.equal(visit.last().value, 'ready')
+    assert.match(visit.last().context.updateError, /stopped/)
+})
+
