+test('an update whose file is not what the list says fails, telling the pages why, and keeps what it cached for the next try', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const v2 = {...v1, 'libraries/index.html': '<h1>Libraries, more</h1>', 'assets/new.js': 'added()'}
+    const list = listOf(v2)
+    const net = network({...v2, 'assets/new.js': 'tampered()'}, list)
+    const {sw, posted, calls} = worker(list.version, caches, net)
+    await assert.rejects(sw.install(), /assets\/new\.js is not what precache\.json says/)
+    const failed = posted.filter(message => message.type === 'UPDATE_FAILED')
+    assert.equal(failed.length, 1)
+    assert.equal(failed[0].version, list.version)
+    assert.match(failed[0].reason, /assets\/new\.js is not what precache\.json says/)
+    assert.deepEqual(calls, [])
+    const cache = await caches.open(cacheName(scope, list.version))
+    assert.equal(await cache.match(`${scope}precache.json`), undefined, 'not complete, so never served')
+    assert.equal(await text(cache.match(`${scope}libraries/index.html`)), '<h1>Libraries, more</h1>')
+
+    const fixed = network(v2, list)
+    const again = worker(list.version, caches, fixed)
+    await again.sw.install()
+    assert.deepEqual(fixed.requested.sort(), [`${scope}assets/new.js`, `${scope}precache.json`],
+        'the next try fetches only what failed')
+    assert.deepEqual(again.posted.filter(message => message.type === 'UPDATE_FAILED'), [])
+})
+
+test('an update whose list cannot be read fails, telling the pages why', async () => {
+    const caches = new FakeCaches()
+    await installed(caches, v1)
+    const net = network(v1)
+    net.offline = true
+    const {sw, posted} = worker('f'.repeat(64), caches, net)
+    await assert.rejects(sw.install(), TypeError)
+    assert.deepEqual(posted.map(message => [message.type, message.version]), [['UPDATE_FAILED', 'f'.repeat(64)]])
+    assert.match(posted[0].reason, /Failed to fetch/)
+})
+
