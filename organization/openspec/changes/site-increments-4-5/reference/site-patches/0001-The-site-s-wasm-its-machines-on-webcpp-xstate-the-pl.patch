diff --git a/app/Jamfile b/app/Jamfile
new file mode 100644
index 0000000..03db629
--- /dev/null
+++ b/app/Jamfile
@@ -0,0 +1,91 @@
+# Copyright (c) 2026 WebCpp.org
+#
+# Distributed under the Boost Software License, Version 1.0. (See
+# accompanying file LICENSE_1_0.txt or copy at
+# https://www.boost.org/LICENSE_1_0.txt)
+#
+# The site's own wasm, the module SiteApp: machine_host, which runs the site's
+# machines (machines/*.json) on webcpp::xstate's machine layer, and its
+# embind bindings; and machine_host's native test.
+#
+#   site_app_test  machine_host on the player's machine, natively;
+#   site-app       the wasm, on emscripten alone: site-app.js and, beside
+#                  it, site-app.wasm, which em++ writes and b2 does not know;
+#   wasm           site-app built with emscripten in release, whatever the
+#                  toolset b2 runs with, copied into the site's build/app/ as
+#                  site-app.mjs and site-app.wasm, where the site's build and
+#                  its node test read it.
+import modules ;
+import path ;
+import testing ;
+
+# This directory's parent, the site's, absolute: an action starts in the
+# directory b2 was started in, the superproject's root.
+.site = [ path.parent [ path.parent [ path.root [ path.make
+    [ modules.binding $(__name__) ] ] [ path.pwd ] ] ] ] ;
+
+project : requirements <library>/webcpp/xstate//xstate <include>. ;
+
+# <build>no unless the toolset is emscripten's, and the reverse: the wasm
+# needs Emscripten's headers, and the test reads its argument from the host's
+# files, which node gives a program only with -sNODERAWFS.
+rule emscripten-only ( properties * )
+{
+    if ! <toolset>emscripten in $(properties)
+    {
+        return <build>no ;
+    }
+}
+
+rule native-only ( properties * )
+{
+    if <toolset>emscripten in $(properties)
+    {
+        return <build>no ;
+    }
+}
+
+run test/site_app_test.cpp site_app.cpp : : ../machines/player.json
+  : <conditional>@native-only : site_app_test ;
+
+exe site-app : site_app.cpp bindings.cpp
+  : <conditional>@emscripten-only
+    <linkflags>-lembind
+    <linkflags>-sMODULARIZE
+    <linkflags>-sEXPORT_ES6
+    <linkflags>-sEXPORT_NAME=SiteApp
+    <linkflags>-sENVIRONMENT=web,node
+    <linkflags>-sALLOW_MEMORY_GROWTH
+    # em++ optimizes the wasm and minifies its JavaScript when it links, at
+    # the level the objects were compiled at, which b2 gives the compiler
+    # alone.
+    <optimization>speed:<linkflags>-O3
+    <optimization>space:<linkflags>-Os
+  ;
+
+make site-app.stamp : site-app/<toolset>emscripten/<variant>release : @copy-app
+  : <webcpp-boost-check>off ;
+alias wasm : site-app.stamp : <webcpp-boost-check>off ;
+
+rule copy-app ( targets * : sources * : properties * )
+{
+    OUT on $(targets) = [ path.native $(.site)/build/app ] ;
+}
+
+# Each file is copied beside its place and renamed onto it, the wasm before
+# the module that loads it, so that a reader, such as a test run at the same
+# time, never reads a file half-written.
+actions copy-app
+{
+    set -e
+    mkdir -p "$(OUT)"
+    next=`mktemp -d "$(OUT)/.next-XXXXXX"`
+    cp "$(>)" "$next/site-app.mjs"
+    cp "`dirname "$(>)"`/site-app.wasm" "$next/site-app.wasm"
+    mv -f "$next/site-app.wasm" "$(OUT)/site-app.wasm"
+    mv -f "$next/site-app.mjs" "$(OUT)/site-app.mjs"
+    rmdir "$next"
+    echo copied > "$(<)"
+}
+
+explicit site-app site-app.stamp wasm ;
diff --git a/app/bindings.cpp b/app/bindings.cpp
new file mode 100644
index 0000000..c57e5bc
--- /dev/null
+++ b/app/bindings.cpp
@@ -0,0 +1,59 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ The site's wasm as JavaScript sees it, the module SiteApp: the class
+ MachineHost, machine_host through embind, whose refusals are JavaScript
+ Errors.
+*/
+
+#include "site_app.hpp"
+
+#include <boost/system/error_code.hpp>
+#include <boost/system/result.hpp>
+
+#include <emscripten/bind.h>
+#include <emscripten/val.h>
+
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace {
+
+/** Throws, in JavaScript, the Error that says what was refused and why. */
+[[noreturn]] void throw_error(std::string_view refused, const boost::system::error_code& why) {
+    std::string message(refused);
+    message += ": ";
+    message += why.message();
+    emscripten::val::global("Error").new_(message).throw_();
+}
+
+webcpp_site::machine_host create(const std::string& config) {
+    boost::system::result<webcpp_site::machine_host> created =
+        webcpp_site::machine_host::create(config);
+    if (!created.has_value()) {
+        throw_error("MachineHost.create refused the config", created.error());
+    }
+    return std::move(*created);
+}
+
+std::string send(webcpp_site::machine_host& host, const std::string& event) {
+    boost::system::result<std::string> sent = host.send(event);
+    if (!sent.has_value()) {
+        throw_error("MachineHost.send refused the event", sent.error());
+    }
+    return std::move(*sent);
+}
+
+}  // namespace
+
+EMSCRIPTEN_BINDINGS(site_app) {
+    const emscripten::class_<webcpp_site::machine_host> host("MachineHost");
+    host.class_function("create", &create);
+    host.function("send", &send);
+    host.function("snapshot", &webcpp_site::machine_host::snapshot);
+}
diff --git a/app/site_app.cpp b/app/site_app.cpp
new file mode 100644
index 0000000..b12d4c7
--- /dev/null
+++ b/app/site_app.cpp
@@ -0,0 +1,131 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+#include "site_app.hpp"
+
+#include <webcpp/xstate.hpp>
+
+#include <boost/json.hpp>
+#include <boost/system/error_code.hpp>
+#include <boost/system/result.hpp>
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace webcpp_site {
+
+namespace {
+
+namespace xstate = webcpp::xstate;
+
+/** The member key of the context, an int64, or nullptr when there is none. */
+const std::int64_t* context_int64(const xstate::action_args& args, std::string_view key) {
+    const boost::json::object* context = args.context.if_object();
+    const boost::json::value* member = context == nullptr ? nullptr : context->if_contains(key);
+    return member == nullptr ? nullptr : member->if_int64();
+}
+
+xstate::result<boost::json::object> reset_played(const xstate::action_args& /*args*/) {
+    return boost::json::object{{"played", 0}};
+}
+
+xstate::result<boost::json::object> count_played(const xstate::action_args& args) {
+    const std::int64_t* played = context_int64(args, "played");
+    if (played == nullptr) {
+        return xstate::failure<boost::json::object>(xstate::errc::implementation_failed);
+    }
+    return boost::json::object{{"played", *played + 1}};
+}
+
+xstate::result<boost::json::object> set_speed(const xstate::action_args& args) {
+    const boost::json::value* speed = args.event.payload.if_contains("speed");
+    if (speed == nullptr) {
+        return xstate::failure<boost::json::object>(xstate::errc::implementation_failed);
+    }
+    return boost::json::object{{"speed", *speed}};
+}
+
+/**
+ Whether the event's `speed` is one the player offers.
+ Tip: JSON gives 1 and 2 as integers and 0.5 as a double, so each is read as a double.
+*/
+xstate::result<bool> is_speed(const xstate::action_args& args) {
+    const boost::json::value* speed = args.event.payload.if_contains("speed");
+    if (speed == nullptr || !speed->is_number()) {
+        return false;
+    }
+    boost::system::error_code inexact;
+    const auto value = speed->to_number<double>(inexact);
+    return !inexact && (value == 0.5 || value == 1.0 || value == 2.0);
+}
+
+std::string_view status_name(xstate::status of) {
+    switch (of) {
+        case xstate::status::active: return "active";
+        case xstate::status::done: return "done";
+        case xstate::status::error: return "error";
+    }
+    return "error";
+}
+
+}  // namespace
+
+webcpp::xstate::implementations site_implementations() {
+    xstate::implementations registry;
+    registry.actions.emplace("resetPlayed", xstate::assign_action{.assignment = reset_played});
+    registry.actions.emplace("countPlayed", xstate::assign_action{.assignment = count_played});
+    registry.actions.emplace("setSpeed", xstate::assign_action{.assignment = set_speed});
+    registry.guards.emplace("isSpeed", is_speed);
+    return registry;
+}
+
+boost::system::result<machine_host> machine_host::create(std::string_view config_json) {
+    boost::system::error_code failed;
+    const boost::json::value config = boost::json::parse(config_json, failed);
+    if (failed) {
+        return failed;
+    }
+    xstate::result<xstate::machine> created =
+        xstate::create_machine(config, site_implementations());
+    if (!created.has_value()) {
+        return created.error();
+    }
+    xstate::snapshot initial = xstate::get_initial_snapshot(*created);
+    return machine_host(std::move(*created), std::move(initial));
+}
+
+boost::system::result<std::string> machine_host::send(std::string_view event_json) {
+    boost::system::error_code failed;
+    const boost::json::value json = boost::json::parse(event_json, failed);
+    if (failed) {
+        return failed;
+    }
+    const xstate::result<xstate::event> event = xstate::event_from_json(json);
+    if (!event.has_value()) {
+        return event.error();
+    }
+    current_ = xstate::get_next_snapshot(machine_, current_, *event);
+    return snapshot();
+}
+
+std::string machine_host::snapshot() const {
+    boost::json::object json{
+        {"value", current_.value},
+        {"context", current_.context},
+        {"status", status_name(current_.status)},
+    };
+    if (current_.status == xstate::status::error) {
+        json.emplace("error", current_.error.message());
+    }
+    return boost::json::serialize(json);
+}
+
+machine_host::machine_host(webcpp::xstate::machine machine, webcpp::xstate::snapshot current)
+    : machine_(std::move(machine)), current_(std::move(current)) {}
+
+}  // namespace webcpp_site
diff --git a/app/site_app.hpp b/app/site_app.hpp
new file mode 100644
index 0000000..5f659c9
--- /dev/null
+++ b/app/site_app.hpp
@@ -0,0 +1,67 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ The site's machines, each an XState machine whose JSON config is one of
+ machines/, run by webcpp::xstate's machine layer: the code the site's wasm
+ exports to the pages (bindings.cpp), testable natively.
+*/
+#ifndef WEBCPP_SITE_APP_SITE_APP_HPP
+#define WEBCPP_SITE_APP_SITE_APP_HPP
+
+#include <webcpp/xstate.hpp>
+
+#include <boost/system/result.hpp>
+
+#include <string>
+#include <string_view>
+
+namespace webcpp_site {
+
+/**
+ The implementations the site's machines name, by name: the assigns and the
+ guards a JSON config cannot hold.
+
+ | Name | Kind | What it does |
+ | `resetPlayed` | assign | `played` = 0 |
+ | `countPlayed` | assign | `played` + 1 |
+ | `setSpeed` | assign | `speed` = the event's `speed` |
+ | `isSpeed` | guard | the event's `speed` is 0.5, 1 or 2 |
+*/
+webcpp::xstate::implementations site_implementations();
+
+/** One machine of the site, created from XState's JSON config, stepped by events. */
+class machine_host {
+public:
+    /** The machine of config, in its initial state, or the error that refuses the config. */
+    static boost::system::result<machine_host> create(std::string_view config_json);
+
+    /**
+     Sends event (XState's event JSON, {"type": ...}) and returns the snapshot's JSON.
+
+     An event that is not JSON, or has no string `type`, is refused with its
+     error, and the machine stays where it was.
+    */
+    boost::system::result<std::string> send(std::string_view event_json);
+
+    /**
+     The current snapshot as JSON: {"value": ..., "context": ..., "status": ...}.
+
+     `status` is `active`, `done` or `error`, as XState's; with `error`, the
+     member `error` names why.
+    */
+    [[nodiscard]] std::string snapshot() const;
+
+private:
+    machine_host(webcpp::xstate::machine machine, webcpp::xstate::snapshot current);
+
+    webcpp::xstate::machine machine_;
+    webcpp::xstate::snapshot current_;
+};
+
+}  // namespace webcpp_site
+
+#endif  // WEBCPP_SITE_APP_SITE_APP_HPP
diff --git a/app/test/site_app_test.cpp b/app/test/site_app_test.cpp
new file mode 100644
index 0000000..7748762
--- /dev/null
+++ b/app/test/site_app_test.cpp
@@ -0,0 +1,198 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+/**
+ Tests machine_host on the player's machine, machines/player.json, whose path
+ is the program's one argument: its states and its context through a run, and
+ the config and the event it refuses.
+*/
+
+#include "site_app.hpp"
+
+#include <boost/core/lightweight_test.hpp>
+#include <boost/json.hpp>
+#include <boost/system/result.hpp>
+
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <initializer_list>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace {
+
+/**
+ The text of the file at path, read into buffer, or "" when it cannot be read or does not fit.
+ Tip: a buffer, since a std::string grown here is a throw clang-tidy finds reaching main.
+*/
+std::string_view read_file(const char* path, std::span<char> buffer) {
+    std::FILE* file = std::fopen(path, "rb");
+    if (file == nullptr) {
+        return {};
+    }
+    const std::size_t count = std::fread(buffer.data(), 1, buffer.size(), file);
+    const bool whole = std::feof(file) != 0 && std::ferror(file) == 0;
+    const bool closed = std::fclose(file) == 0;
+    return whole && closed ? std::string_view(buffer.data(), count) : std::string_view();
+}
+
+/** A snapshot's JSON, as machine_host writes it, read back; null when it is not JSON. */
+boost::json::value parsed(std::string_view json) {
+    boost::system::error_code failed;
+    const boost::json::value value = boost::json::parse(json, failed);
+    BOOST_TEST(!failed);
+    return failed ? boost::json::value() : value;
+}
+
+/** The member key of the snapshot's context, or null when it has none. */
+boost::json::value context_member(const boost::json::value& snapshot, std::string_view key) {
+    const boost::json::value* context = snapshot.as_object().if_contains("context");
+    if (context == nullptr || !context->is_object()) {
+        return nullptr;
+    }
+    const boost::json::value* member = context->as_object().if_contains(key);
+    return member == nullptr ? boost::json::value() : *member;
+}
+
+/** Sends each event in turn and returns the last snapshot, or null when one is refused. */
+boost::json::value send_all(webcpp_site::machine_host& host,
+                            std::initializer_list<std::string_view> events) {
+    boost::json::value last;
+    for (const std::string_view event : events) {
+        const boost::system::result<std::string> sent = host.send(event);
+        if (!BOOST_TEST(sent.has_value())) {
+            return nullptr;
+        }
+        last = parsed(sent.unsafe_value());
+    }
+    return last;
+}
+
+void starts_idle(std::string_view config) {
+    const boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return;
+    }
+    const webcpp_site::machine_host& player = host.unsafe_value();
+    const boost::json::value snapshot = parsed(player.snapshot());
+    if (!BOOST_TEST(snapshot.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(snapshot.at("value"), boost::json::value("idle"));
+    BOOST_TEST_EQ(snapshot.at("status"), boost::json::value("active"));
+    BOOST_TEST_EQ(context_member(snapshot, "speed"), boost::json::value(1));
+    BOOST_TEST_EQ(context_member(snapshot, "played"), boost::json::value(0));
+}
+
+void plays_and_pauses(std::string_view config) {
+    boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return;
+    }
+    webcpp_site::machine_host& player = host.unsafe_value();
+    const boost::json::value paused = send_all(player, {
+                                                           R"({"type": "PLAY"})",
+                                                           R"({"type": "TICK"})",
+                                                           R"({"type": "TICK"})",
+                                                           R"({"type": "PAUSE"})",
+                                                       });
+    if (!BOOST_TEST(paused.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(paused.at("value"), boost::json::value("paused"));
+    BOOST_TEST_EQ(context_member(paused, "played"), boost::json::value(2));
+    BOOST_TEST_EQ(parsed(player.snapshot()), paused);
+
+    const boost::json::value faster = send_all(player, {R"({"type": "SPEED", "speed": 2})"});
+    if (!BOOST_TEST(faster.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(faster.at("value"), boost::json::value("paused"));
+    BOOST_TEST_EQ(context_member(faster, "speed"), boost::json::value(2));
+    BOOST_TEST_EQ(context_member(faster, "played"), boost::json::value(2));
+}
+
+void ends_and_restarts(std::string_view config) {
+    boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return;
+    }
+    webcpp_site::machine_host& player = host.unsafe_value();
+    const boost::json::value done =
+        send_all(player, {R"({"type": "PLAY"})", R"({"type": "TICK"})", R"({"type": "END"})"});
+    if (!BOOST_TEST(done.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(done.at("value"), boost::json::value("done"));
+    BOOST_TEST_EQ(context_member(done, "played"), boost::json::value(1));
+
+    const boost::json::value idle = send_all(player, {R"({"type": "RESTART"})"});
+    if (!BOOST_TEST(idle.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(idle.at("value"), boost::json::value("idle"));
+    BOOST_TEST_EQ(context_member(idle, "played"), boost::json::value(0));
+}
+
+void refuses_a_speed_it_does_not_offer(std::string_view config) {
+    boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return;
+    }
+    webcpp_site::machine_host& player = host.unsafe_value();
+    const boost::json::value half = send_all(player, {R"({"type": "SPEED", "speed": 0.5})"});
+    const boost::json::value three = send_all(player, {R"({"type": "SPEED", "speed": 3})"});
+    if (!BOOST_TEST(half.is_object()) || !BOOST_TEST(three.is_object())) {
+        return;
+    }
+    BOOST_TEST_EQ(context_member(half, "speed"), boost::json::value(0.5));
+    BOOST_TEST_EQ(three, half);
+}
+
+void refuses_a_config_that_is_not_json() {
+    const boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(R"({"initial": "idle", )");
+    BOOST_TEST(!host.has_value());
+}
+
+void refuses_an_event_that_is_not_json(std::string_view config) {
+    boost::system::result<webcpp_site::machine_host> host =
+        webcpp_site::machine_host::create(config);
+    if (!BOOST_TEST(host.has_value())) {
+        return;
+    }
+    webcpp_site::machine_host& player = host.unsafe_value();
+    const std::string before = player.snapshot();
+    BOOST_TEST(!player.send(R"({"type": "PLAY")").has_value());
+    BOOST_TEST(!player.send(R"({"speed": 2})").has_value());
+    BOOST_TEST_EQ(player.snapshot(), before);
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+    if (!BOOST_TEST_EQ(argc, 2)) {
+        return boost::report_errors();
+    }
+    std::array<char, 65536> buffer{};
+    const std::string_view config = read_file(argv[1], buffer);
+    if (!BOOST_TEST(!config.empty())) {
+        return boost::report_errors();
+    }
+    starts_idle(config);
+    plays_and_pauses(config);
+    ends_and_restarts(config);
+    refuses_a_speed_it_does_not_offer(config);
+    refuses_a_config_that_is_not_json();
+    refuses_an_event_that_is_not_json(config);
+    return boost::report_errors();
+}
