diff --git a/src/machine.ts b/src/machine.ts
new file mode 100644
index 0000000..17ffe8a
--- /dev/null
+++ b/src/machine.ts
@@ -0,0 +1,133 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The site's wasm, the module SiteApp that app/ builds with emscripten, and the hook a component
+// runs one of the site's machines (machines/*.json) with, on webcpp::xstate in the wasm.
+
+import {useCallback, useEffect, useRef, useState} from 'react'
+
+/** One machine in the wasm (app/site_app.hpp's machine_host), whose memory `delete` frees. */
+export type MachineHost = {
+    /** Sends XState's event JSON and returns the snapshot's JSON; throws an Error it refuses. */
+    send(event: string): string
+    /** The snapshot's JSON. */
+    snapshot(): string
+    delete(): void
+    isDeleted(): boolean
+}
+
+/** The module app/bindings.cpp exports. */
+export type SiteApp = {
+    MachineHost: {
+        /** The machine of XState's JSON config, in its initial state; throws an Error it refuses. */
+        create(config: string): MachineHost
+    }
+}
+
+/** A machine's snapshot, as machine_host writes it. */
+export type MachineSnapshot = {
+    value: unknown
+    context: Record<string, unknown>
+    status: 'active' | 'done' | 'error'
+    /** With the status `error`, why. */
+    error?: string
+}
+
+/**
+ * What useMachine gives: null while the wasm loads, then the machine's snapshot, or, when the
+ * wasm could not load or refused the config, the error that says why, which the page shows as text.
+ */
+export type MachineState = MachineSnapshot | {error: string} | null
+
+/** XState's event: its type, and the members that travel with it. */
+export type MachineEvent = {type: string; [member: string]: unknown}
+
+/** A machine run by runMachine. */
+export type MachineRun = {
+    /** Sends the event once the machine runs, and does nothing before or once stopped. */
+    send(event: MachineEvent): void
+    /** Deletes the machine's host; the run hands on nothing after. */
+    stop(): void
+}
+
+function messageOf(error: unknown): string {
+    return error instanceof Error ? error.message : String(error)
+}
+
+/** The module SiteApp at url, instantiated: its wasm fetched and compiled. */
+export async function loadSiteApp(url: string): Promise<SiteApp> {
+    const module = (await import(url)) as {default: () => Promise<SiteApp>}
+    return module.default()
+}
+
+/**
+ * Runs the machine of the JSON config on the app once it loads, handing on to changed its first
+ * snapshot and the one each send leads to, or the error that stops it.
+ * Tip: useMachine's effect, apart from React, so that node tests it; a run stopped before the app
+ * loads never creates its host.
+ */
+export function runMachine(app: Promise<SiteApp>, config: string,
+                           changed: (state: MachineState) => void): MachineRun {
+    let host: MachineHost | null = null
+    let stopped = false
+    app.then(loaded => {
+        if (stopped) {
+            return
+        }
+        host = loaded.MachineHost.create(config)
+        changed(JSON.parse(host.snapshot()) as MachineSnapshot)
+    }).catch((error: unknown) => {
+        if (!stopped) {
+            changed({error: messageOf(error)})
+        }
+    })
+    return {
+        send(event) {
+            if (host !== null) {
+                changed(JSON.parse(host.send(JSON.stringify(event))) as MachineSnapshot)
+            }
+        },
+        stop() {
+            stopped = true
+            host?.delete()
+            host = null
+        },
+    }
+}
+
+let loading: Promise<SiteApp> | undefined
+
+/**
+ * The site's wasm, loaded once per page from `app/site-app.mjs` beside the client bundle, which
+ * b2 site lays out at `assets/app/`: a URL relative to the bundle, so that it holds on every page
+ * and under any prefix the site is served at.
+ */
+function siteApp(): Promise<SiteApp> {
+    loading ??= loadSiteApp(new URL('app/site-app.mjs', import.meta.url).href)
+    return loading
+}
+
+/**
+ * Runs the machine of config, XState's JSON config, in the site's wasm: its state, re-rendered on
+ * each send, and the send. The host is deleted when the component unmounts or config changes.
+ */
+export function useMachine(config: object): [MachineState, (event: MachineEvent) => void] {
+    const [state, setState] = useState<MachineState>(null)
+    const run = useRef<MachineRun | null>(null)
+    const source = JSON.stringify(config)
+    useEffect(() => {
+        const started = runMachine(siteApp(), source, setState)
+        run.current = started
+        return () => {
+            started.stop()
+            if (run.current === started) {
+                run.current = null
+            }
+        }
+    }, [source])
+    const send = useCallback((event: MachineEvent) => run.current?.send(event), [])
+    return [state, send]
+}
