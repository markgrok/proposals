diff --git a/test/machine_test.mjs b/test/machine_test.mjs
new file mode 100644
index 0000000..21a276a
--- /dev/null
+++ b/test/machine_test.mjs
@@ -0,0 +1,187 @@
+// Copyright (c) 2026 WebCpp.org
+//
+// Distributed under the Boost Software License, Version 1.0. (See
+// accompanying file LICENSE_1_0.txt or copy at
+// https://www.boost.org/LICENSE_1_0.txt)
+
+// The site's wasm, build/app/site-app.mjs, which b2 /webcpp/site/app//wasm builds with emscripten
+// and copies there, loaded by src/machine.ts's loadSiteApp, running the player's machine,
+// machines/player.json, with XState 5.33.2's actor on the same config as its oracle: the two agree
+// on the value and the context at every step. And runMachine, what useMachine runs: the snapshots
+// it hands on, the error it hands on in their place, and the host it deletes.
+
+import assert from 'node:assert/strict'
+import {existsSync, readFileSync} from 'node:fs'
+import {join} from 'node:path'
+import test from 'node:test'
+import {pathToFileURL} from 'node:url'
+import {assign, createActor, createMachine} from 'xstate'
+import {loadSiteApp, runMachine} from '../src/machine.ts'
+import {site} from './site.mjs'
+
+const module = join(site, 'build/app/site-app.mjs')
+const config = readFileSync(join(site, 'machines/player.json'), 'utf8')
+
+/** The site's wasm, or a failure that says how to build it. */
+async function siteApp() {
+    assert.ok(existsSync(module), `${module} is missing: build it at the superproject's root with ` +
+        'b2 /webcpp/site/app//wasm (b2 /webcpp/site//test and b2 site build it first)')
+    return loadSiteApp(pathToFileURL(module).href)
+}
+
+/** XState's actor on the player's machine, with the implementations the wasm gives the names. */
+function oracle() {
+    const machine = createMachine(JSON.parse(config), {
+        actions: {
+            resetPlayed: assign({played: 0}),
+            countPlayed: assign({played: ({context}) => context.played + 1}),
+            setSpeed: assign({speed: ({event}) => event.speed}),
+        },
+        guards: {
+            isSpeed: ({event}) => [0.5, 1, 2].includes(event.speed),
+        },
+    })
+    return createActor(machine).start()
+}
+
+/**
+ * Plays the events on the wasm's host and on XState's actor, asserting at each step that the two
+ * agree, and returns the wasm's snapshots, the initial one first.
+ */
+function play(app, events) {
+    const host = app.MachineHost.create(config)
+    const actor = oracle()
+    try {
+        const snapshots = [JSON.parse(host.snapshot())]
+        const agree = (snapshot, step) => {
+            const expected = actor.getSnapshot()
+            assert.deepEqual(snapshot.value, expected.value, `the value after ${step}`)
+            assert.deepEqual(snapshot.context, expected.context, `the context after ${step}`)
+            assert.equal(snapshot.status, expected.status, `the status after ${step}`)
+        }
+        agree(snapshots[0], 'the start')
+        for (const event of events) {
+            const snapshot = JSON.parse(host.send(JSON.stringify(event)))
+            actor.send(event)
+            agree(snapshot, JSON.stringify(event))
+            snapshots.push(snapshot)
+        }
+        return snapshots
+    } finally {
+        host.delete()
+        actor.stop()
+    }
+}
+
+test("the player's machine runs in the wasm as it runs in XState", async () => {
+    const app = await siteApp()
+    const [idle, , , , paused, faster] = play(app, [
+        {type: 'PLAY'}, {type: 'TICK'}, {type: 'TICK'}, {type: 'PAUSE'}, {type: 'SPEED', speed: 2},
+    ])
+    assert.deepEqual(idle, {value: 'idle', context: {speed: 1, played: 0}, status: 'active'})
+    assert.equal(paused.value, 'paused')
+    assert.equal(paused.context.played, 2)
+    assert.equal(faster.value, 'paused')
+    assert.equal(faster.context.speed, 2)
+
+    const [, , , done, restarted] = play(app, [
+        {type: 'PLAY'}, {type: 'TICK'}, {type: 'END'}, {type: 'RESTART'},
+    ])
+    assert.equal(done.value, 'done')
+    assert.equal(restarted.value, 'idle')
+    assert.equal(restarted.context.played, 0)
+})
+
+test('every transition of the player agrees with XState, and an event no state takes moves nothing', async () => {
+    const app = await siteApp()
+    const values = play(app, [
+        {type: 'STEP'}, {type: 'TICK'}, {type: 'PLAY'}, {type: 'TICK'}, {type: 'SPEED', speed: 0.5},
+        {type: 'PAUSE'}, {type: 'STEP'}, {type: 'END'}, {type: 'SPEED', speed: 3}, {type: 'TICK'},
+        {type: 'RESTART'}, {type: 'STEP'}, {type: 'END'}, {type: 'RESTART'}, {type: 'PAUSE'},
+    ]).map(snapshot => snapshot.value)
+    assert.deepEqual(values, [
+        'idle', 'stepping', 'paused', 'running', 'running', 'running',
+        'paused', 'stepping', 'done', 'done', 'done',
+        'idle', 'stepping', 'done', 'idle', 'idle',
+    ])
+})
+
+test('a config or an event that is not JSON is a JavaScript Error, and the machine stays', async () => {
+    const app = await siteApp()
+    assert.throws(() => app.MachineHost.create('{"initial": '), error =>
+        error instanceof Error && /^MachineHost\.create refused the config: /.test(error.message))
+    assert.throws(() => app.MachineHost.create('{"initial": "nowhere", "states": {}}'), Error)
+    const host = app.MachineHost.create(config)
+    try {
+        const before = host.snapshot()
+        assert.throws(() => host.send('{"type": "PLAY"'), error =>
+            error instanceof Error && /^MachineHost\.send refused the event: /.test(error.message))
+        assert.throws(() => host.send('{"speed": 2}'), Error)
+        assert.equal(host.snapshot(), before)
+    } finally {
+        host.delete()
+    }
+})
+
+test('loadSiteApp rejects with an Error when the module is not there', async () => {
+    await assert.rejects(loadSiteApp(pathToFileURL(join(site, 'build/app/none.mjs')).href), Error)
+})
+
+/** The app, with every host it creates recorded. */
+function recording(app) {
+    const hosts = []
+    return {
+        hosts,
+        app: {
+            MachineHost: {
+                create(text) {
+                    const host = app.MachineHost.create(text)
+                    hosts.push(host)
+                    return host
+                },
+            },
+        },
+    }
+}
+
+test('runMachine hands on each snapshot, and stop deletes its host', async () => {
+    const {hosts, app} = recording(await siteApp())
+    const states = []
+    const run = runMachine(Promise.resolve(app), config, state => states.push(state))
+    await new Promise(setImmediate)
+    run.send({type: 'PLAY'})
+    run.send({type: 'TICK'})
+    assert.deepEqual(states.map(state => [state.value, state.context.played]),
+        [['idle', 0], ['running', 0], ['running', 1]])
+    run.stop()
+    run.send({type: 'PAUSE'})
+    assert.equal(states.length, 3, 'a stopped run hands on nothing')
+    assert.equal(hosts.length, 1)
+    assert.ok(hosts[0].isDeleted())
+})
+
+test('runMachine hands on the error of a wasm that could not load, and of a refused config', async () => {
+    const failed = []
+    runMachine(Promise.reject(new Error('WebAssembly is disabled')), config, state => failed.push(state))
+    await new Promise(setImmediate)
+    assert.deepEqual(failed, [{error: 'WebAssembly is disabled'}])
+
+    const refused = []
+    const app = await siteApp()
+    runMachine(Promise.resolve(app), '{"initial": "nowhere", "states": {}}', state => refused.push(state))
+    await new Promise(setImmediate)
+    assert.equal(refused.length, 1)
+    assert.match(refused[0].error, /^MachineHost\.create refused the config: /)
+})
+
+test('runMachine stopped before the wasm loads creates no host and hands on nothing', async () => {
+    const {hosts, app} = recording(await siteApp())
+    const states = []
+    let loaded
+    const run = runMachine(new Promise(resolve => { loaded = resolve }), config, state => states.push(state))
+    run.stop()
+    loaded(app)
+    await new Promise(setImmediate)
+    assert.deepEqual(states, [])
+    assert.deepEqual(hosts, [])
+})
