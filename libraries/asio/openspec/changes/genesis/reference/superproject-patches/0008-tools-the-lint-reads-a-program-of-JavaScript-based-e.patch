Subject: [PATCH 08/10] tools: the lint reads a program of JavaScript-based
 exceptions, the asyncify variant's, in clang 23's spelling

---
 doc/releases/0.1.0.adoc        |  2 ++
 tools/lint/compile_commands.py | 21 ++++++++++++-----
 tools/lint/lint_test.py        | 41 +++++++++++++++++++++++++++-------
 3 files changed, 51 insertions(+), 13 deletions(-)

diff --git a/doc/releases/0.1.0.adoc b/doc/releases/0.1.0.adoc
index f867a4c..63d7562 100644
--- a/doc/releases/0.1.0.adoc
+++ b/doc/releases/0.1.0.adoc
@@ -161,6 +161,8 @@ kept by the CI.
 Boost's way, with its suspension variant.
 * Changed `webcpp.variants` to refuse a build that asks for JavaScript
 exceptions, which would link the `jspi` variant with them.
+* Fixed the lint stopping on a program built with JavaScript-based
+exceptions, such as an `asyncify` variant's.
 
 [#webcpp-0-1-0-compilers-tested]
 == Compilers tested
diff --git a/tools/lint/compile_commands.py b/tools/lint/compile_commands.py
index 9eb5246..ec10b27 100755
--- a/tools/lint/compile_commands.py
+++ b/tools/lint/compile_commands.py
@@ -37,7 +37,8 @@ wasi-sdk's clang++, the one --wasi-clang names (the lint gives the one beside it
 after the words that em++ gives clang for that compile, which `em++ <its options> --cflags`
 prints (its target, wasm32-unknown-emscripten, its sysroot in Emscripten's cache, the
 -iwithsysroot directories compat and fakesdl, and the words of its exceptions: with b2's
--fwasm-exceptions, the legacy encoding em++ compiles with; without exceptions,
+-fwasm-exceptions, the legacy encoding em++ compiles with; with -fexceptions alone, the
+asyncify variant's JavaScript-based ones, in clang 23's spelling; without exceptions,
 -fignore-exceptions), read once per run for each set of options, and before b2's own words.
 --cflags alone is not enough: without -fwasm-exceptions, em++ gives -enable-emscripten-sjlj,
 which clang refuses beside -fwasm-exceptions. The sysroot holds Emscripten's headers once em++
@@ -145,6 +146,14 @@ EMSCRIPTEN = 'emscripten'
 # What the first line em++ --version prints starts with.
 EMSCRIPTEN_VERSION = 'emcc (Emscripten'
 
+# The words em++ --cflags prints that Emscripten's clang 24 knows and wasi-sdk's clang 23 refuses,
+# each with clang 23's spelling of the same: JavaScript-based exceptions, which a compile with
+# -fexceptions asks for (the asyncify variant's), are -femscripten-exceptions in clang 24 and
+# -mllvm -enable-emscripten-cxx-exceptions before it; neither changes what the front end defines.
+CLANG_23_SPELLING = {
+    '-femscripten-exceptions': ('-mllvm', '-enable-emscripten-cxx-exceptions'),
+}
+
 # The suffix of the stem of an aggregate's twin that holds fewer headers than the aggregate.
 WITHOUT_SUFFIX = '-exception-handling-off'
 
@@ -331,11 +340,13 @@ def emscripten_words(compiler: str, options: tuple[str, ...]) -> tuple[str, ...]
     """The words Emscripten's em++, compiler, gives clang for a compile with options, as
     `em++ <options> --cflags` prints them: its target, its sysroot in Emscripten's cache, and the
     -iwithsysroot directories compat and fakesdl, with the words of the exceptions options asks
-    for (-fwasm-exceptions: the legacy encoding; none: -fignore-exceptions). Read once per run for
-    each set of options."""
+    for (-fwasm-exceptions: the legacy encoding; -fexceptions: JavaScript-based ones; none:
+    -fignore-exceptions), each word that wasi-sdk's clang 23 refuses in its spelling there
+    (CLANG_23_SPELLING). Read once per run for each set of options."""
     emscripten_ready(compiler)
-    return tuple(shlex.split(run_emscripten(compiler, [*options, '--cflags'],
-                                            'print the words it gives clang, --cflags')))
+    words = shlex.split(run_emscripten(compiler, [*options, '--cflags'],
+                                       'print the words it gives clang, --cflags'))
+    return tuple(spelled for word in words for spelled in CLANG_23_SPELLING.get(word, (word,)))
 
 
 def run_emscripten(compiler: str, arguments: list[str], what: str) -> str:
diff --git a/tools/lint/lint_test.py b/tools/lint/lint_test.py
index 79ee5c1..2b18245 100755
--- a/tools/lint/lint_test.py
+++ b/tools/lint/lint_test.py
@@ -13,14 +13,14 @@ library component_demo's world and its programs that declare no native target, i
 wasi-sdk's clang++ builds it, with no host target, the header on wasip2 and on wasip3, each with
 exceptions and without them; the fixture library browser_demo, whose headers no one target builds,
 has an aggregate per target, its emscripten one analysed by wasi-sdk's clang++ with the words of
-em++ --cflags, and its native one, against the fake dependency that throws, twinned without the
-header that needs exceptions and with a native header whose own headers-alone call does not declare
-them; a public header that no target compiles alone, a target whose toolset is not configured, and a
-WebAssembly command whose compiler is neither wasi-sdk's clang++ nor, on emscripten, Emscripten's
-em++, fail the database by name. Each case lints a scratch superproject whose libs/demo is the
-fixture library demo, a repository of its own as a library's submodule is, and libs/component_demo
-or libs/browser_demo too in the cases of WASI and of emscripten. Run with the names of some cases to
-run only those."""
+em++ --cflags, a program of its asyncify variant with them in clang 23's spelling, and its native
+one, against the fake dependency that throws, twinned without the header that needs exceptions and
+with a native header whose own headers-alone call does not declare them; a public header that no
+target compiles alone, a target whose toolset is not configured, and a WebAssembly command whose
+compiler is neither wasi-sdk's clang++ nor, on emscripten, Emscripten's em++, fail the database by
+name. Each case lints a scratch superproject whose libs/demo is the fixture library demo, a
+repository of its own as a library's submodule is, and libs/component_demo or libs/browser_demo too
+in the cases of WASI and of emscripten. Run with the names of some cases to run only those."""
 
 from __future__ import annotations
 
@@ -683,6 +683,30 @@ def test_clang_tidy_reads_what_only_one_target_builds(root):
             name, result.stdout[-6000:])
 
 
+def test_clang_tidy_reads_a_program_of_javascript_exceptions(root):
+    # A program of the asyncify variant compiles with JavaScript-based exceptions, for which em++
+    # --cflags prints -femscripten-exceptions, a word of Emscripten's clang 24 that wasi-sdk's
+    # clang 23 refuses: the database gives clang 23 its own spelling of the same exceptions, so
+    # that clang-tidy reads the program rather than stop at an unknown argument.
+    prepare(root)
+    add_browser_demo(root)
+    # page.cpp builds only on emscripten, so that each of its variants is analysed.
+    with (root / 'libs/browser_demo/example/Jamfile').open('a') as jamfile:
+        jamfile.write('webcpp.link page_asyncify : page.cpp\n'
+                      '  : <linkflags>-sENVIRONMENT=web <webcpp-suspend>asyncify : emscripten ;\n')
+    completed = compile_database(root)
+    assert completed.returncode == 0, completed.stdout[-6000:]
+    entries = json.loads((root / 'compile database/compile_commands.json').read_text())
+    page = [entry['arguments'] for entry in entries
+            if Path(entry['file']) == root / 'libs/browser_demo/example/page.cpp']
+    javascript = [command for command in page
+                  if '-fexceptions' in command and '-fwasm-exceptions' not in command]
+    assert len(javascript) == 1, page
+    assert '-femscripten-exceptions' not in javascript[0], javascript[0]
+    assert '-enable-emscripten-cxx-exceptions' in javascript[0], javascript[0]
+    expect_clean(lint(root))
+
+
 def test_a_dependency_s_warnings_are_not_ours(root):
     # A regression pin, which passes before and after the lint reads native.hpp: what clang-tidy
     # finds in a dependency's header, here the fake one that native.hpp includes, is not
@@ -1992,6 +2016,7 @@ CASES = [
     test_clang_tidy_reads_what_an_own_lane_builds,
     test_compile_database_gives_each_target_its_aggregate,
     test_clang_tidy_reads_what_only_one_target_builds,
+    test_clang_tidy_reads_a_program_of_javascript_exceptions,
     test_a_dependency_s_warnings_are_not_ours,
     test_a_compiled_boost_library_s_sources_are_not_analysed,
     test_clang_tidy_refuses_a_throw_on_each_target_without_exceptions,
