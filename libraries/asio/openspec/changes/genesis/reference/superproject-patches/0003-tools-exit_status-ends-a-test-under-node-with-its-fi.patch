+# Stops the build, naming the flag and the program, when the requirements
+# of a program node runs (run, run-fail, example), or its Jamfile's, link
+# -sMODULARIZE or -sEXPORT_ES6, under a condition or not. Either wraps the
+# program in a factory that node never calls: the program, its pre-js among
+# it, would never run, and its test would pass. A page's program, which
+# webcpp.link links, may take them. Read from the declaration, since b2
+# evaluates a conditional requirement before it adds the free requirements;
+# a library's usage requirements are not read.
+local rule node-runnable ( kind name : requirements * )
+{
+    local jamfile = [ jamfile ] ;
+    local inherited = [ project.attribute $(jamfile) requirements ] ;
+    for local property in $(requirements) [ $(inherited).raw ]
+    {
+        local flag = [ MATCH "<linkflags>(.*)$" : $(property) ] ;
+        local found = [ MATCH "^-s(MODULARIZE|EXPORT_ES6)(=(.*))?$" : $(flag) ] ;
+        if $(found) && $(found[3]) != 0
+        {
+            local place = [ where ] ;
+            errors.user-error "webcpp: $(flag) makes node load the program without running it,"
+                "and $(kind) $(name) in $(place[4]) runs it under node; a page's program,"
+                "which webcpp.link links, may take it" ;
+        }
+    }
+}
