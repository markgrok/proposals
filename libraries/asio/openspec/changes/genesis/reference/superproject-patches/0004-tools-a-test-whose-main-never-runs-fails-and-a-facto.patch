 doc/releases/0.1.0.adoc                       |  2 ++
 tools/node-test/node-pre.js                   | 25 +++++++++++++------
 tools/test/emscripten_test.py                 | 12 +++++----
 .../test/fixtures/node_test_demo/test/Jamfile |  2 ++
 tools/webcpp.jam                              | 19 ++++++++------
 6 files changed, 55 insertions(+), 28 deletions(-)

