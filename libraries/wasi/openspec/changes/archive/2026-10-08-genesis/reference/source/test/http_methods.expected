$ curl -i -X GET 'http://localhost:8080/a?b=c%20d'
HTTP/1.1 200 OK
content-type: text/plain; method=GET

GET /a?b=c%20d

$ curl -I 'http://localhost:8080/a?b=c%20d'
HTTP/1.1 200 OK
content-type: text/plain; method=HEAD


$ curl -i -X POST http://localhost:8080/
HTTP/1.1 200 OK
content-type: text/plain; method=POST

POST /

$ curl -i -X PUT http://localhost:8080/items/7
HTTP/1.1 200 OK
content-type: text/plain; method=PUT

PUT /items/7

$ curl -i -X DELETE http://localhost:8080/items/7
HTTP/1.1 200 OK
content-type: text/plain; method=DELETE

DELETE /items/7

$ curl -i -X OPTIONS --request-target '*' http://localhost:8080
HTTP/1.1 200 OK
content-type: text/plain; method=OPTIONS

OPTIONS *

$ curl -i -X TRACE http://localhost:8080/trace
HTTP/1.1 200 OK
content-type: text/plain; method=TRACE

TRACE /trace

$ curl -i -X PATCH 'http://localhost:8080/items/7?x=1&y=%2F'
HTTP/1.1 200 OK
content-type: text/plain; method=PATCH

PATCH /items/7?x=1&y=%2F

$ curl -i -X PURGE http://localhost:8080/cache/key
HTTP/1.1 200 OK
content-type: text/plain; method=PURGE

PURGE /cache/key
