From 84d4eeb6cfebfbfd54cf940a526ee158e4ff9bf0 Mon Sep 17 00:00:00 2001
From: R <github.overboard312@passmail.net>
Date: Sun, 11 Oct 2026 18:08:31 -0400
Subject: [PATCH 25/25] trystero: an app's setup reports reach the current
 handler, each once

A second on_error call posted every report again, and the handler it replaced still got them. The delivery now calls the handler current when it runs and hands each report over once. The tests count the reports exactly and assign to a moved-from app; max_rooms says its reason in the library's terms, and two stale comments are brought up to date.
---
 include/webcpp/trystero/app.hpp             |  9 ++---
 include/webcpp/trystero/detail/app_impl.hpp | 31 +++++++++++++----
 test/oracle/interop/run.mjs                 |  4 +--
 test/room_test.cpp                          |  4 +--
 test/shared_test.cpp                        | 37 ++++++++++++++++++---
 5 files changed, 65 insertions(+), 20 deletions(-)

diff --git a/include/webcpp/trystero/app.hpp b/include/webcpp/trystero/app.hpp
index b71d06b..3780701 100644
--- a/include/webcpp/trystero/app.hpp
+++ b/include/webcpp/trystero/app.hpp
@@ -46,8 +46,8 @@ public:
     /** The executor every handler and completion of the app and its rooms runs on. */
     using executor_type = boost::asio::any_io_executor;
 
-    /** The most rooms an app holds at once: a peer drops a connection that advertises more
-     * (Trystero's literal 64, C/shared-peer.mjs:457). */
+    /** The most rooms an app holds at once: a Trystero JS peer drops a connection that advertises
+     * more, its limit of 64 room tokens per connection. */
     static constexpr std::size_t max_rooms = 64;
 
     /**
@@ -150,8 +150,9 @@ public:
 
     /**
      * Sets what is called with each part of the configuration the app set aside, with an empty
-     * peer id and `error::invalid_configuration`; the reports made before it is set are posted to
-     * it, once the caller has returned.
+     * peer id and `error::invalid_configuration`. The reports are delivered once the caller has
+     * returned, each once, to the handler set when they are delivered: one replaced before then
+     * gets none.
      *
      * @tparam F A callable with the peer's id, the @ref error and a description, the views valid
      * for the call.
diff --git a/include/webcpp/trystero/detail/app_impl.hpp b/include/webcpp/trystero/detail/app_impl.hpp
index 9e4f075..3fca334 100644
--- a/include/webcpp/trystero/detail/app_impl.hpp
+++ b/include/webcpp/trystero/detail/app_impl.hpp
@@ -158,20 +158,26 @@ public:
     /** What the constructor set aside, a sentence each, in its order. */
     [[nodiscard]] std::span<const std::pmr::string> setup_reports() const { return setup_reports_; }
 
-    /** Sets what is called with each part of the configuration set aside, and posts it every one
-     * the constructor set aside, with an empty peer id and `error::invalid_configuration`: the
-     * reports were made before any handler could be set. */
+    /** Sets what is called with each part of the configuration set aside, with an empty peer id
+     * and `error::invalid_configuration`, and posts the delivery of the reports the constructor
+     * made, which no handler could see then.
+     *
+     * Tip: the delivery calls the handler current when it runs, so one replaced before it gets
+     * none, and it hands each report over once, so one set after it gets none either. */
     void on_error(handler<void(std::string_view, boost::system::error_code, std::string_view)> f) {
         if (!f) {
             on_error_ = nullptr;
             return;
         }
         on_error_ = std::allocate_shared<decltype(f)>(allocator(), std::move(f));
-        for (const auto& what : setup_reports_) {
-            post(ex_, memory_, [f = on_error_, what = std::pmr::string(what, memory_)] {
-                (*f)("", make_error_code(error::invalid_configuration), what);
-            });
+        if (delivered_reports_ == setup_reports_.size()) {
+            return;
         }
+        post(ex_, memory_, [weak = weak_from_this()] {
+            if (const auto self = weak.lock()) {
+                self->deliver_setup_reports();
+            }
+        });
     }
 
     /** `f` as a handler of the app's resource. */
@@ -371,6 +377,16 @@ private:
         }
     }
 
+    /** Hands every report not yet delivered to the current handler, one at a time: a handler may
+     * replace itself, or clear itself, from inside its call. */
+    void deliver_setup_reports() {
+        while (delivered_reports_ < setup_reports_.size() && on_error_) {
+            const auto f = on_error_;
+            const std::string_view what = setup_reports_[delivered_reports_++];
+            (*f)("", make_error_code(error::invalid_configuration), what);
+        }
+    }
+
     void set_aside(std::string_view what) {
         log_("app", what);
         setup_reports_.emplace_back(what);
@@ -400,6 +416,7 @@ private:
     std::pmr::vector<std::pmr::string> setup_reports_;
     std::shared_ptr<handler<void(std::string_view, boost::system::error_code, std::string_view)>>
         on_error_;
+    std::size_t delivered_reports_ = 0;  // the setup reports handed to a handler, in their order
     std::pmr::map<std::pmr::string, entry, std::less<>> rooms_;
     std::pmr::map<std::pmr::string, std::shared_ptr<connection>, std::less<>> connections_;
     std::size_t users_ = 0;
