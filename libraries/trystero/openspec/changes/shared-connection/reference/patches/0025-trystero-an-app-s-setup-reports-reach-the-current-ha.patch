+        BOOST_TEST_EQ(a->self_id(), "UUUUUUUUUUUUUUUUUUUU");
         a.reset();
         BOOST_TEST_EQ(moved.self_id(), "LLLLLLLLLLLLLLLLLLLL");
     }
