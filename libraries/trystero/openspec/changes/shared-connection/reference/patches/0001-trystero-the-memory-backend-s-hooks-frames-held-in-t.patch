+    const auto remote = remote_.lock();
+    std::size_t budget = drain_per_post_;
+    while (!queue_.empty()) {
+        const std::size_t left = queue_.front().size() - head_drained_;
+        const std::size_t take = std::min(budget, left);
+        head_drained_ += take;
+        buffered_ -= take;
+        budget -= take;
+        if (take < left) {
