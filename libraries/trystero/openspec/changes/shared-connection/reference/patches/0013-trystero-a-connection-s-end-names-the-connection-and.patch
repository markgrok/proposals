+                                                             .self_id = std::pmr::string(self_id),
+                                                             .relay_urls = {relay_a, relay_b},
+                                                             .idle_timeout = idle_timeout,
+                                                         });
+    out.room = std::allocate_shared<trystero::detail::room_impl>(
+        alloc, out.app, trystero::room_options{}, room_id, m);
+    out.room->start();
+    return out;
+}
