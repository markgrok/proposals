From 588e15467b2e3e31e164677401d35cd3a433a9f6 Mon Sep 17 00:00:00 2001
From: R <github.overboard312@passmail.net>
Date: Sun, 11 Oct 2026 10:13:52 -0400
Subject: [PATCH 11/25] trystero: a room asserts it binds a peer once until the
 peer's removal

The connection's attach requires that no binding of the room's token is bound; the room states where that comes from, the signaling's connected entry, which only forget clears, after the peer's removal.
---
 include/webcpp/trystero/room.hpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/webcpp/trystero/room.hpp b/include/webcpp/trystero/room.hpp
index 8a9973e..f3f574d 100644
--- a/include/webcpp/trystero/room.hpp
+++ b/include/webcpp/trystero/room.hpp
@@ -1064,6 +1064,10 @@ private:
             pc->close();
             return;
         }
+        // A peer is bound once until its removal: the signaling hands over no channel while its
+        // entry is connected, which `on_channel_open` sets and only `forget` clears, after
+        // `remove_peer` has taken the peer out (review of Task 2, r2).
+        BOOST_ASSERT(!peers_.contains(peer_view));
         const auto weak = weak_from_this();
         const auto it = peers_.try_emplace(std::pmr::string(peer_view, memory_), allocator()).first;
         const std::pmr::string& peer = it->first;
