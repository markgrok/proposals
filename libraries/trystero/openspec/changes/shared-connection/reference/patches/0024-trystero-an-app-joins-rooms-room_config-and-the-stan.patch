+// Two rooms, one connection; each room's action of one name reaches only its room, both ways.
+void two_rooms_share_one_connection() {
+    two_apps t("DDDDDDDDDDDDDDDDDDDD", "EEEEEEEEEEEEEEEEEEEE");
+    joined_in(t, {"r1", "r2"});
