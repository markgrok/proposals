 namespace webcpp::trystero::protocol::json {
 
+/**
+ * The most members an object of a protocol text may hold: the most a `boost::json::object` holds
+ * without its hash index, so that no object a room parses for the protocol is ever hashed.
+ *
+ * Above it, Boost.JSON indexes an object's keys by a hash seeded with the object's own address,
+ * which holds no secret, and sets of keys exist that collide under every seed (32,768 keys of 240
+ * bytes share one digest): each key inserted is compared with every one before it, so one text of
+ * them costs a parse quadratic in its members, 9.2 s for 4 MB against 4 ms for random keys of the
+ * same size. The largest object a room reads has 7 members: a Nostr event (`id`, `pubkey`,
+ * `created_at`, `kind`, `tags`, `content`, `sig`), and a signal (`peerId`, `offerId`, `offer`,
+ * `answer`, `candidate`, `passive`, and the C++ room's `nonce`).
+ */
+inline constexpr std::size_t max_object_members = 18;
+static_assert(max_object_members == boost::json::detail::small_object_size_,
+              "Boost.JSON moved the size above which an object hashes its keys: "
+              "set max_object_members to it, or below it");
+
 namespace detail {
 
+/**
+ * The handler of a protocol text's parser: what `boost::json::parser` uses, a `value_stack` that
+ * builds the value, with objects bounded at @ref max_object_members.
+ *
+ * Tip: `boost::json::basic_parser` checks `max_object_size` as it meets each member, before it
+ * reads the member's key, so an object with one member too many stops the parse there, with
+ * `boost::json::error::object_too_large`, and is never built.
+ */
+struct bounded_handler {
+    static constexpr std::size_t max_object_size = max_object_members;
+    static constexpr std::size_t max_array_size = boost::json::array::max_size();
+    static constexpr std::size_t max_key_size = boost::json::string::max_size();
+    static constexpr std::size_t max_string_size = boost::json::string::max_size();
+
+    explicit bounded_handler(const boost::json::storage_ptr& storage) : stack(storage) {}
+
+    static bool on_document_begin(boost::system::error_code& /*ec*/) { return true; }
+
+    static bool on_document_end(boost::system::error_code& /*ec*/) { return true; }
+
+    static bool on_object_begin(boost::system::error_code& /*ec*/) { return true; }
+
+    bool on_object_end(std::size_t n, boost::system::error_code& /*ec*/) {
+        stack.push_object(n);
+        return true;
+    }
+
+    static bool on_array_begin(boost::system::error_code& /*ec*/) { return true; }
+
+    bool on_array_end(std::size_t n, boost::system::error_code& /*ec*/) {
+        stack.push_array(n);
+        return true;
+    }
+
+    bool on_key_part(boost::json::string_view s, std::size_t /*n*/,
+                     boost::system::error_code& /*ec*/) {
+        stack.push_chars(s);
+        return true;
+    }
+
+    bool on_key(boost::json::string_view s, std::size_t /*n*/, boost::system::error_code& /*ec*/) {
+        stack.push_key(s);
+        return true;
+    }
+
+    bool on_string_part(boost::json::string_view s, std::size_t /*n*/,
+                        boost::system::error_code& /*ec*/) {
+        stack.push_chars(s);
+        return true;
+    }
+
+    bool on_string(boost::json::string_view s, std::size_t /*n*/,
+                   boost::system::error_code& /*ec*/) {
+        stack.push_string(s);
+        return true;
+    }
+
+    static bool on_number_part(boost::json::string_view /*s*/, boost::system::error_code& /*ec*/) {
+        return true;
+    }
+
+    bool on_int64(std::int64_t i, boost::json::string_view /*s*/,
+                  boost::system::error_code& /*ec*/) {
+        stack.push_int64(i);
+        return true;
+    }
+
+    bool on_uint64(std::uint64_t u, boost::json::string_view /*s*/,
+                   boost::system::error_code& /*ec*/) {
+        stack.push_uint64(u);
+        return true;
+    }
+
+    bool on_double(double d, boost::json::string_view /*s*/, boost::system::error_code& /*ec*/) {
+        stack.push_double(d);
+        return true;
+    }
+
+    bool on_bool(bool b, boost::system::error_code& /*ec*/) {
+        stack.push_bool(b);
+        return true;
+    }
+
+    bool on_null(boost::system::error_code& /*ec*/) {
+        stack.push_null();
+        return true;
+    }
+
+    static bool on_comment_part(boost::json::string_view /*s*/, boost::system::error_code& /*ec*/) {
+        return true;
+    }
+
+    static bool on_comment(boost::json::string_view /*s*/, boost::system::error_code& /*ec*/) {
+        return true;
+    }
+
+    boost::json::value_stack stack;
+};
